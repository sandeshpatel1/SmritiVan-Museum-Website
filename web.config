<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<handlers>
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>

			<aspNetCore processPath="dotnet"
						arguments=".\SmritivanWeb.dll"
						stdoutLogEnabled="true"
						stdoutLogFile=".\logs\stdout"
						hostingModel="inprocess">

				<environmentVariables>

					<!-- Environment -->
					<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />

					<!-- SQL Server Connection String -->
					<environmentVariable
					  name="ConnectionStrings__DefaultConnection"
					  value="Server=103.14.99.95;Database=smritivanearthquakemuseum;User Id=sa_smritivan;Password=Preet@13579;TrustServerCertificate=True;" />

					<!-- SMTP Configuration -->
					<environmentVariable name="Smtp__Host"        value="smtp.gmail.com" />
					<environmentVariable name="Smtp__Port"        value="587" />
					<environmentVariable name="Smtp__Username"    value="contact@smritivanearthquakemuseum.org" />
					<environmentVariable name="Smtp__Password"    value="Preet@009988" />
					<environmentVariable name="Smtp__From"        value="contact@smritivanearthquakemuseum.org" />
					<environmentVariable name="Smtp__FromName"    value="Smritivan Earthquake Museum" />
					<environmentVariable name="Smtp__BccAddress"  value="admin@smritivanearthquakemuseum.org" />

					<!-- ✅ ADD THIS FOR RECAPTCHA -->
					<environmentVariable
						name="Recaptcha__SecretKey"
						value="6LdpkcAsAAAAABBQ5J0NpR1ll_vpDiz1QmJuclTR" />

				</environmentVariables>

			</aspNetCore>
		</system.webServer>
	</location>
</configuration>