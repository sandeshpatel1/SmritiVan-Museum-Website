<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <title>@ViewData["Title"] - Smritivan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600;1,700&family=DM+Sans:ital,opsz,wght@@0,9..40,200;0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />
    <link rel="icon" href="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" type="image/png" />
    <link rel="stylesheet" href="~/css/variables.css" />
    <link rel="stylesheet" href="~/css/reset.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/pages.css" />

    <style>
        /* ════════════════════════════════════════════════════════
           LAYOUT OVERRIDES
           These use !important to win over any layout.css rules
           that set a white/light background on the header.
        ════════════════════════════════════════════════════════ */

        /* ── HEADER: always transparent, goes dark only on scroll ── */
        .hdr {
            position: fixed !important;
            top: 0 !important; left: 0 !important; right: 0 !important;
            z-index: 900 !important;
            height: 68px;
            padding: 0 48px;
            display: flex;
            align-items: center;
            background: transparent !important;
            border-bottom: 1px solid transparent !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            transition: background 0.4s ease, border-color 0.4s ease;
        }
        .hdr.scrolled {
            background: rgba(0,0,0,0.95) !important;
            border-bottom-color: rgba(201,169,110,0.16) !important;
            backdrop-filter: blur(20px) !important;
            -webkit-backdrop-filter: blur(20px) !important;
            box-shadow: none !important;
        }
        .hdr__inner {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Logo */
        .hdr__logo { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
        .hdr__logo img { width: 38px; height: 38px; object-fit: contain; }
        .hdr__wordmark {
            font-family: 'Cormorant', serif;
            font-size: 22px; font-weight: 600;
            color: #f2ece2 !important;
            letter-spacing: 2px;
        }

        /* Desktop nav — force flex, kill any white bg from layout.css */
        .hdr__nav {
            display: flex !important;
            align-items: center;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            gap: 0;
        }

        /* Every nav link (a and button) — white-on-dark style */
        .hdr__link {
            color: rgba(242,236,226,0.55) !important;
            font-size: 12.5px !important;
            font-weight: 400 !important;
            padding: 8px 13px;
            letter-spacing: 0.3px;
            transition: color 0.3s;
            background: none !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            font-family: inherit;
            white-space: nowrap;
            line-height: 1;
        }
        .hdr__link:hover {
            color: #f2ece2 !important;
            background: none !important;
        }
        .hdr__link.active {
            color: #f2ece2 !important;
            background: none !important;
            border-radius: 0 !important;
            border-bottom: 1px solid #c9a96e !important;
        }

        /* Book Tickets CTA */
        .hdr__btn {
            background: #c9a96e !important;
            color: #000 !important;
            font-size: 11px;
            font-weight: 600;
            padding: 9px 22px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: background 0.3s, transform 0.2s;
            margin-left: 12px;
            border: none !important;
            border-radius: 0 !important;
            text-decoration: none;
            display: inline-block;
        }
        .hdr__btn:hover { background: #e8d5a3 !important; transform: translateY(-1px); opacity: 1 !important; }

        /* Dropdown */
        .hdr__drop { position: relative; }
        .hdr__drop-menu {
            position: absolute;
            top: calc(100% + 8px); left: 0;
            background: #090909 !important;
            border: 1px solid rgba(201,169,110,0.16) !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            min-width: 200px;
            padding: 6px;
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
            transform: translateY(-8px);
            transition: opacity 0.2s, transform 0.2s, visibility 0s linear 0.2s;
            z-index: 200;
        }
        .hdr__drop.open .hdr__drop-menu {
            opacity: 1; pointer-events: all; visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s, transform 0.2s, visibility 0s linear 0s;
        }
        .hdr__drop-item {
            display: block; padding: 10px 16px; font-size: 13px;
            color: rgba(242,236,226,0.5) !important;
            transition: background 0.2s, color 0.2s;
            text-decoration: none; white-space: nowrap;
            background: none !important;
        }
        .hdr__drop-item:hover { background: rgba(242,236,226,0.06) !important; color: #f2ece2 !important; }
        .hdr__drop-item.active { color: #f2ece2 !important; background: rgba(201,169,110,0.08) !important; font-weight: 500; }

        /* Hamburger */
        .ham {
            display: none;
            flex-direction: column;
            gap: 5px; padding: 8px;
            cursor: pointer; background: none; border: none; z-index: 101;
        }
        .ham span { display: block; width: 22px; height: 1.5px; background: #f2ece2; transition: all 0.3s; }

        /* Mobile nav */
        .mob-ov { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
        .mob-ov.open { opacity: 1; pointer-events: all; }
        .mob-nav { position: fixed; top: 0; right: 0; bottom: 0; width: 300px; background: #050505; border-left: 1px solid rgba(201,169,110,0.16); z-index: 1100; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); display: flex; flex-direction: column; }
        .mob-nav.open { transform: translateX(0); }
        .mob-nav__hd { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid rgba(201,169,110,0.16); }
        .mob-nav__close { font-size: 24px; color: rgba(242,236,226,0.5); background: none; border: none; cursor: pointer; }
        .mob-nav__links { flex: 1; overflow-y: auto; padding: 12px 0; }
        .mob-nav__links a { display: block; padding: 13px 24px; color: rgba(242,236,226,0.5); font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.04); transition: color 0.2s, padding-left 0.2s; text-decoration: none; }
        .mob-nav__links a:hover { color: #f2ece2; padding-left: 32px; }
        .mob-nav__foot { padding: 20px 24px; border-top: 1px solid rgba(201,169,110,0.16); display: flex; gap: 20px; }
        .mob-nav__foot a { color: rgba(242,236,226,0.5); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; transition: color 0.2s; text-decoration: none; }
        .mob-nav__foot a:hover { color: #c9a96e; }

        /* ── FOOTER ── */
        .ftr { background: #000; border-top: 1px solid rgba(201,169,110,0.16); padding: 80px 80px 40px; }
        .ftr__inner { max-width: 1200px; margin: 0 auto; }
        .ftr__top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 56px; padding-bottom: 60px; border-bottom: 1px solid rgba(201,169,110,0.16); margin-bottom: 0; }
        .ftr__brand { display: flex; flex-direction: column; gap: 16px; }
        .ftr__logo { display: flex; align-items: center; gap: 12px; }
        .ftr__logo img { width: 34px; }
        .ftr__logo strong { font-family: 'Cormorant', serif; font-size: 18px; color: #f2ece2; font-weight: 600; letter-spacing: 1px; }
        .ftr__brand p { font-size: 13px; color: rgba(255,255,255,0.28); line-height: 1.7; font-weight: 300; }
        .ftr__partners { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 8px; }
        .ftr__partners a:hover { opacity: 0.6; }
        .ftr__col h4 { font-size: 9px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: #c9a96e; margin-bottom: 20px; }
        .ftr__col a { display: block; font-size: 13px; color: rgba(255,255,255,0.3); padding: 6px 0; transition: color 0.2s, padding-left 0.2s; text-decoration: none; }
        .ftr__col a:hover { color: #f2ece2; padding-left: 8px; }

        /* ══ FOOTER VISITOR COUNTER
           Matches screenshot exactly:
           [person-icon] | [NUMBER] VISITOR'S
        ══ */
        .ftr__counter {
            padding: 22px 0;
            border-bottom: 1px solid rgba(201,169,110,0.12);
            display: flex;
            align-items: center;
        }
        .ftr__counter-inner {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* Circle with person icon */
        .ftr__counter-icon {
            width: 42px; height: 42px;
            border-radius: 50%;
            border: 1.5px solid rgba(201,169,110,0.35);
            background: rgba(201,169,110,0.05);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .ftr__counter-icon svg {
            width: 20px; height: 20px;
            color: #c9a96e;
            stroke: #c9a96e;
        }

        /* Thin vertical bar */
        .ftr__counter-divider {
            width: 1px; height: 32px;
            background: rgba(201,169,110,0.22);
            flex-shrink: 0;
        }

        /* The big number */
        .ftr__counter-num {
            font-family: 'Cormorant', Georgia, serif;
            font-size: 34px; font-weight: 700;
            color: #f2ece2; letter-spacing: -0.5px; line-height: 1;
            min-width: 40px;
            transition: opacity 0.35s ease;
        }
        .ftr__counter-num.ftr-loading { opacity: 0.2; }

        /* VISITOR'S label */
        .ftr__counter-label {
            font-size: 11px; letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(242,236,226,0.35);
            font-weight: 400;
            white-space: nowrap;
            margin-top: 2px;
        }

        /* Footer bottom bar */
        .ftr__bot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 11px; color: rgba(255,255,255,0.18); letter-spacing: 0.5px; padding-top: 28px; }
        .ftr__bot a { color: rgba(255,255,255,0.22); transition: color 0.2s; text-decoration: none; }
        .ftr__bot a:hover { color: #f2ece2; }
        .ftr__atm { color: #c9a96e !important; font-weight: 500; }
        .ftr__atm:hover { color: #e8d5a3 !important; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 1100px) {
            .ftr__top { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 768px) {
            .hdr__nav { display: none !important; }
            .ham { display: flex !important; }
            .hdr { padding: 0 24px; }
            .ftr { padding: 60px 24px 32px; }
            .ftr__top { grid-template-columns: 1fr; gap: 36px; }
            .ftr__bot { flex-direction: column; align-items: flex-start; }
        }
        @@media (max-width: 480px) {
            .ftr__counter-num { font-size: 26px; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-visitor-count="@(ViewBag.VisitorCount ?? "")">
    @{
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();

        bool isIndex     = currentAction == "index";
        bool isMuseum    = currentAction == "museum";
        bool isMemorial  = currentAction == "memorial";
        bool isBrief     = currentAction == "briefhistory";
        bool isGallery   = currentAction == "gallery";
        bool isEvents    = currentAction == "events";
        bool isTour      = currentAction == "museumtour";
        bool isAmenities = currentAction == "amenities";
        bool isFaq       = currentAction == "faq";
        bool isContact   = currentAction == "contact";

        bool isAboutActive = isMuseum || isMemorial || isBrief;
    }

    <!-- ══ HEADER ══ -->
    <header class="hdr" id="hdr">
        <div class="hdr__inner">

            <a href="/Index" class="hdr__logo">
                <img src="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" alt="Smritivan" />
                <span class="hdr__wordmark">Smritivan</span>
            </a>

            <nav class="hdr__nav">
                <a href="/Index" class="hdr__link @(isIndex ? "active" : "")">Home</a>

                <div class="hdr__drop @(isAboutActive ? "open" : "")" id="nd-about">
                    <button class="hdr__link @(isAboutActive ? "active" : "")" onclick="toggleAbout(event)">
                        About
                    </button>
                    <div class="hdr__drop-menu">
                        <a href="/Museum"       class="hdr__drop-item @(isMuseum   ? "active" : "")">Earthquake Museum</a>
                        <a href="/Memorial"     class="hdr__drop-item @(isMemorial ? "active" : "")">Memorial</a>
                        <a href="/BriefHistory" class="hdr__drop-item @(isBrief    ? "active" : "")">Brief History</a>
                    </div>
                </div>

                <a href="/Gallery"    class="hdr__link @(isGallery   ? "active" : "")">Gallery</a>
                <a href="/Events"     class="hdr__link @(isEvents    ? "active" : "")">Events</a>
                <a href="/MuseumTour" class="hdr__link @(isTour      ? "active" : "")">Audio Guide</a>
                <a href="/Amenities"  class="hdr__link @(isAmenities ? "active" : "")">Amenities</a>
                <a href="/Faq"        class="hdr__link @(isFaq       ? "active" : "")">FAQ</a>
                <a href="/Contact"    class="hdr__link @(isContact   ? "active" : "")">Contact</a>

                <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx"
                   target="_blank" class="hdr__btn">Book Tickets</a>
            </nav>

            <button class="ham" id="ham-btn">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <!-- Mobile overlay + drawer -->
    <div class="mob-ov" id="mob-ov"></div>
    <aside class="mob-nav" id="mob-nav">
        <div class="mob-nav__hd">
            <img src="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" alt="" width="34" />
            <button class="mob-nav__close" id="mob-close">&times;</button>
        </div>
        <nav class="mob-nav__links">
            <a href="/Index">Home</a>
            <a href="/Museum">Earthquake Museum</a>
            <a href="/Memorial">Memorial</a>
            <a href="/BriefHistory">Brief History</a>
            <a href="/Gallery">Gallery</a>
            <a href="/Events">Events</a>
            <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx" target="_blank">Book Tickets</a>
            <a href="/MuseumTour">Audio Guide</a>
            <a href="/Amenities">Amenities</a>
            <a href="/MapPage">Museum Map</a>
            <a href="/Faq">FAQ</a>
            <a href="/Contact">Contact</a>
        </nav>
        <div class="mob-nav__foot">
            <a href="https://www.instagram.com/smritivanearthquakemuseum/" target="_blank">Instagram</a>
            <a href="https://www.facebook.com/SmritivanEarthquakeMuseum/" target="_blank">Facebook</a>
            <a href="https://twitter.com/smritivan/" target="_blank">Twitter</a>
        </div>
    </aside>

    @RenderBody()

    <!-- ══ FOOTER ══ -->
    <footer class="ftr">
        <div class="ftr__inner">

            <!-- Link columns -->
            <div class="ftr__top">
                <div class="ftr__brand">
                    <div class="ftr__logo">
                        <img src="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" alt="" />
                        <strong>Smritivan</strong>
                    </div>
                    <p>Earthquake Memorial &amp; Museum<br />Bhujiyo Dungar, Bhuj<br />Gujarat 370001, India</p>
                    <div class="ftr__partners">
                        <a href="https://gsdma.org" target="_blank">
                            <img src="https://www.smritivanearthquakemuseum.biz/assets2/GSDMA.png" alt="GSDMA" width="52" />
                        </a>
                        <a href="https://tourism.gov.in" target="_blank">
                            <img src="https://www.smritivanearthquakemuseum.biz/assets2/MOT.png" alt="MOT" width="52" />
                        </a>
                        <a href="https://www.gujarattourism.com" target="_blank">
                            <img src="https://www.smritivanearthquakemuseum.biz/assets2/gujaraticon.png" alt="Gujarat Tourism" width="52" />
                        </a>
                    </div>
                </div>
                <div class="ftr__col">
                    <h4>Explore</h4>
                    <a href="/Museum">Earthquake Museum</a>
                    <a href="/Memorial">Memorial</a>
                    <a href="/BriefHistory">Brief History</a>
                    <a href="/Gallery">Gallery</a>
                    <a href="https://www.rishirajmedia.com/earthquake_museum/" target="_blank" rel="noopener">E-Book</a>
                </div>
                <div class="ftr__col">
                    <h4>Visit</h4>
                    <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx" target="_blank">Tickets</a>
                    <a href="/Amenities">Amenities</a>
                    <a href="/MapPage">Museum Map</a>
                    <a href="/Faq">FAQ</a>
                </div>
                <div class="ftr__col">
                    <h4>Connect</h4>
                    <a href="/Contact">Contact Us</a>
                    <a href="/Events">Events</a>
                    <a href="/MuseumTour">Audio Guide</a>
                    <a href="https://www.instagram.com/smritivanearthquakemuseum/" target="_blank">Instagram</a>
                    <a href="https://www.facebook.com/SmritivanEarthquakeMuseum/" target="_blank">Facebook</a>
                    <a href="https://twitter.com/smritivan/" target="_blank">Twitter</a>
                </div>
            </div>

            <!-- ══ VISITOR COUNTER ROW ══
                 Layout: [○ person icon] | [NUMBER] VISITOR'S
                 • Increments ONLY when someone visits the Home page (Index action)
                 • Displayed on every page, reads live count via /Home/GetVisitorCount
                 • Polls every 60 s to pick up other users' visits globally
            -->
            <div class="ftr__counter">
                <div class="ftr__counter-inner">

                    <!-- Person icon in a circle -->
                    <div class="ftr__counter-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.6"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                        </svg>
                    </div>

                    <!-- Vertical separator -->
                    <div class="ftr__counter-divider"></div>

                    <!-- Animated count -->
                    <span class="ftr__counter-num ftr-loading"
                          id="ftr-visitor-count"
                          data-val="0"
                          aria-live="polite">—</span>

                    <!-- Label -->
                    <span class="ftr__counter-label">Visitor's</span>

                </div>
            </div>

            <!-- Bottom copyright bar -->
            <div class="ftr__bot">
                <p>&copy; 2026 Smritivan Earthquake Memorial &amp; Museum. All rights reserved.</p>
                <p><a href="/Terms">Terms</a> &nbsp;·&nbsp; <a href="/Privacy">Privacy</a></p>
                <p>Design &amp; developed by <a href="https://accountsandtaxminers.com/" target="_blank" class="ftr__atm">ATM</a></p>
            </div>

        </div>
    </footer>

    <!-- ══ LAYOUT SCRIPTS ══ -->
    <script>
        (function () {

            // ── Scroll-based header shadow ──
            var hdr = document.getElementById('hdr');
            function updateHdr() { if (hdr) hdr.classList.toggle('scrolled', window.scrollY > 50); }
            updateHdr(); // run immediately (handles mid-page refresh)
            window.addEventListener('scroll', updateHdr, { passive: true });

            // ── Mobile nav ──
            var ham      = document.getElementById('ham-btn');
            var mobNav   = document.getElementById('mob-nav');
            var mobOv    = document.getElementById('mob-ov');
            var mobClose = document.getElementById('mob-close');

            function nOpen()  { mobNav.classList.add('open');    mobOv.classList.add('open');    document.body.style.overflow = 'hidden'; }
            function nClose() { mobNav.classList.remove('open'); mobOv.classList.remove('open'); document.body.style.overflow = ''; }

            if (ham)      ham.addEventListener('click', nOpen);
            if (mobOv)    mobOv.addEventListener('click', nClose);
            if (mobClose) mobClose.addEventListener('click', nClose);
            if (mobNav)   mobNav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', nClose); });

            // ── About dropdown ──
            var dd = document.getElementById('nd-about');
            window.toggleAbout = function (e) {
                e.stopPropagation();
                if (dd) dd.classList.toggle('open');
            };
            document.addEventListener('click', function (e) {
                if (dd && !dd.contains(e.target)) dd.classList.remove('open');
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && dd) dd.classList.remove('open');
            });

        })();
    </script>

    <!-- ══ FOOTER VISITOR COUNTER SCRIPT ══ -->
    <script>
        (function () {
            var el = document.getElementById('ftr-visitor-count');
            if (!el) return;

            /* Indian number format helper: 12,34,567 */
            function fmtIN(n) {
                try { return Math.round(n).toLocaleString('en-IN'); } catch (ex) {
                    var s = String(Math.round(n));
                    if (s.length <= 3) return s;
                    var last3 = s.slice(-3), rest = s.slice(0, -3), out = '';
                    while (rest.length > 2) { out = ',' + rest.slice(-2) + out; rest = rest.slice(0, -2); }
                    return rest + out + ',' + last3;
                }
            }

            /* Smooth count-up from current displayed value to target */
            function animateTo(targetStr) {
                var targetRaw = parseInt((targetStr + '').replace(/[^0-9]/g, ''), 10);
                if (isNaN(targetRaw) || targetRaw === 0) return;

                var startRaw = parseInt(el.getAttribute('data-val') || '0', 10);
                el.classList.remove('ftr-loading');

                if (startRaw === targetRaw) { el.textContent = fmtIN(targetRaw); return; }

                var dur = 1000, t0 = null;
                function step(ts) {
                    if (!t0) t0 = ts;
                    var p = Math.min((ts - t0) / dur, 1);
                    var e = 1 - Math.pow(1 - p, 3); // ease-out cubic
                    el.textContent = fmtIN(startRaw + (targetRaw - startRaw) * e);
                    if (p < 1) { requestAnimationFrame(step); }
                    else { el.textContent = fmtIN(targetRaw); el.setAttribute('data-val', targetRaw); }
                }
                requestAnimationFrame(step);
            }

            /* Read-only fetch — does NOT increment the counter */
            function fetchCount() {
                fetch('/Home/GetVisitorCount', { cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) { if (d && d.count) animateTo(d.count); })
                    .catch(function () { /* silent fail */ });
            }

            /* On page load:
               - Home page (Index): ViewBag.VisitorCount is injected into <body data-visitor-count>.
                 Use it directly — no extra network call, already incremented server-side.
               - All other pages: body attr is empty, so do one read-only fetch.
            */
            var serverVal = (document.body.getAttribute('data-visitor-count') || '').trim();
            if (serverVal !== '') {
                setTimeout(function () { animateTo(serverVal); }, 650);
            } else {
                fetchCount();
            }

            /* Poll every 60 s — picks up other users visiting the Home page on other devices */
            setInterval(fetchCount, 60000);

        })();
    </script>

    <script src="~/js/common.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
