@{
    ViewData["Title"] = "Memorial";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}

    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
      --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
      --bg:#060504;--bg2:#0a0807;
    }

    /* ══ HEADER — transparent on dark-bg pages ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent;background:transparent;box-shadow:none; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t);border:none;background:none;cursor:pointer;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center; }
    .hdr__link:hover { color:var(--white); }
    /* FIXED: active clearly visible */
    .hdr__link.active { color:var(--white);border-bottom:2px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px;text-decoration:none; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    /* FIXED: visibility transition so open/close works */
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#111;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s,visibility 0s linear 0.2s;z-index:999; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;visibility:visible;pointer-events:all;transform:translateY(0);transition:opacity 0.2s,transform 0.2s,visibility 0s linear 0s; }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s;text-decoration:none;white-space:nowrap; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    /* FIXED: active dropdown item highlighted with gold left border */
    .hdr__drop-item.active { color:var(--white);background:rgba(201,169,110,0.08);border-left:2px solid var(--gold);padding-left:14px; }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

    /* ══ HERO ══ */
    .hero{position:relative;height:88vh;min-height:600px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__slide{position:absolute;inset:0;opacity:0;transition:opacity 2s ease}
    .hero__slide.active{opacity:1}
    .hero__slide img{width:100%;height:100%;object-fit:cover;object-position:center}
    .hero__ov{position:absolute;inset:0;
      background:linear-gradient(160deg,rgba(6,5,4,0.25) 0%,rgba(6,5,4,0.6) 50%,rgba(6,5,4,0.97) 100%)}
    .hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
    .hero__scroll-line{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
      width:1px;height:72px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
      animation:pulse 2.5s ease-in-out infinite}
    @@keyframes pulse{0%,100%{opacity:1;transform:translateX(-50%) scaleY(1)}50%{opacity:0.25;transform:translateX(-50%) scaleY(0.4)}}

    .hero__content{position:relative;z-index:3; padding:110px 60px 20px 110px;max-width:900px}
    .hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
      color:var(--gold);margin-bottom:22px;display:flex;align-items:center;gap:16px;
      opacity:0;animation:fadeUp 0.9s 0.2s forwards}
    .hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(52px,8vw,116px);
      font-weight:700;line-height:0.88;letter-spacing:-3px;color:var(--white);
      margin-bottom:32px;opacity:0;animation:fadeUp 1s 0.4s forwards}
    .hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.5em;
      letter-spacing:4px;color:rgba(201,169,110,0.75);margin-bottom:12px}
    .hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
      max-width:520px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
      padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
    .hero__stats{display:flex;gap:0;margin-top:52px;opacity:0;animation:fadeUp 0.9s 0.9s forwards;
      border:1px solid var(--border);align-self:flex-start}
    .hero__stat{padding:20px 36px;border-right:1px solid var(--border);text-align:center}
    .hero__stat:last-child{border-right:none}
    .hero__stat-num{font-family:'Cormorant',serif;font-size:38px;font-weight:700;color:var(--white);line-height:1}
    .hero__stat-num span{color:var(--gold)}
    .hero__stat-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px}
    .hero__dots{position:absolute;bottom:36px;right:80px;z-index:3;display:flex;gap:8px;
      opacity:0;animation:fadeUp 0.9s 1.1s forwards}
    .hero__dot{width:28px;height:2px;background:rgba(255,255,255,0.18);cursor:pointer;transition:background 0.3s,width 0.3s;border:none;padding:0}
    .hero__dot.on{background:var(--gold);width:48px}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* ══ UTILS ══ */
    .tag{font-size:9px;font-weight:500;letter-spacing:5px;text-transform:uppercase;
      color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:16px}
    .tag::before{content:'';width:24px;height:1px;background:var(--gold)}
    .sec-title{font-family:'Cormorant',serif;font-size:clamp(32px,4.5vw,58px);
      font-weight:700;color:var(--white);line-height:0.95;letter-spacing:-0.5px}
    .rule{width:40px;height:1px;background:var(--gold);margin:22px 0 30px}
    .reveal{opacity:0;transform:translateY(36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal.in{opacity:1;transform:none}
    .reveal-l{opacity:0;transform:translateX(-36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal-l.in{opacity:1;transform:none}
    .reveal-r{opacity:0;transform:translateX(36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal-r.in{opacity:1;transform:none}

    /* ══ INTRO STRIP ══ */
    .intro-strip{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:52px 80px}
    .intro-strip__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr 1px 1fr;gap:40px;align-items:center}
    .intro-strip__div{background:var(--border);height:52px}
    .intro-strip__val{font-family:'Cormorant',serif;font-size:40px;font-weight:700;color:var(--white);line-height:1}
    .intro-strip__val span{color:var(--gold)}
    .intro-strip__lbl{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim);margin-top:5px}

    /* ══ OVERVIEW ══ */
    .overview{padding:120px 80px;background:var(--bg);position:relative;overflow:hidden}
    .overview::before{content:'MEMORIAL';position:absolute;right:-20px;top:50%;transform:translateY(-50%);
      font-family:'Cormorant',serif;font-size:200px;font-weight:700;color:rgba(201,169,110,0.02);
      line-height:1;pointer-events:none;letter-spacing:-8px;white-space:nowrap}
    .overview__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:88px;align-items:center}
    .overview__body{font-size:15px;font-weight:300;color:var(--dim);line-height:1.95;margin-bottom:32px}
    .overview__img-wrap{position:relative}
    .overview__img-wrap::before{content:'';position:absolute;top:-14px;left:-14px;right:14px;bottom:14px;
      border:1px solid var(--border);pointer-events:none;z-index:0}
    .overview__img-wrap img{position:relative;z-index:1;width:100%;height:500px;object-fit:cover}
    .overview__badge{position:absolute;bottom:-18px;right:-18px;z-index:2;
      background:var(--bg2);border:1px solid var(--border);padding:18px 22px;
      display:flex;align-items:center;gap:14px}
    .overview__badge-icon{font-size:26px;line-height:1}
    .overview__badge-text strong{display:block;font-size:11px;font-weight:500;color:var(--white);letter-spacing:0.5px}
    .overview__badge-text span{font-size:10px;color:var(--gold);letter-spacing:1px;text-transform:uppercase}

    /* ══ FEATURES ══ */
    .features{background:var(--bg2);padding:0}
    .feat-header{padding:100px 80px 0;max-width:1200px;margin:0 auto;
      display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px;
      padding-bottom:52px;border-bottom:1px solid var(--border)}
    .feat-header__note{max-width:360px;font-size:13px;font-weight:300;color:var(--dim);line-height:1.85}
    .feat-block{display:grid;grid-template-columns:1fr 1fr;position:relative;border-bottom:1px solid var(--border)}
    .feat-block:last-child{border-bottom:none}
    .feat-block--flip{direction:rtl}
    .feat-block--flip>*{direction:ltr}
    .feat-block__badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
      width:52px;height:52px;background:var(--bg2);border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;z-index:4;
      font-family:'Cormorant',serif;font-size:18px;font-weight:700;color:var(--gold)}
    .feat-block__img{position:relative;overflow:hidden;aspect-ratio:4/3}
    .feat-block__img img{width:100%;height:100%;object-fit:cover;
      transition:transform 0.7s ease,filter 0.5s;filter:grayscale(20%) brightness(0.8)}
    .feat-block:hover .feat-block__img img{transform:scale(1.04);filter:grayscale(0%) brightness(1)}
    .feat-block__num{position:absolute;top:24px;left:24px;z-index:2;
      font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);
      background:rgba(0,0,0,0.6);border:1px solid var(--border);padding:5px 12px}
    .feat-block__img-ov{position:absolute;inset:0;background:linear-gradient(to right,rgba(6,5,4,0.15),transparent)}
    .feat-block--flip .feat-block__img-ov{background:linear-gradient(to left,rgba(6,5,4,0.15),transparent)}
    .feat-block__content{padding:64px 72px;display:flex;flex-direction:column;justify-content:center}
    .feat-block--flip .feat-block__content{padding:64px 72px 64px 48px}
    .feat-block__outline-num{font-family:'Cormorant',serif;font-size:100px;font-weight:700;
      line-height:0.85;color:transparent;letter-spacing:-4px;margin-bottom:18px;
      -webkit-text-stroke:1px rgba(201,169,110,0.1)}
    .feat-block__tag{font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
    .feat-block__title{font-family:'Cormorant',serif;font-size:clamp(36px,3.5vw,52px);
      font-weight:700;color:var(--white);line-height:1;margin-bottom:20px}
    .feat-block__body{font-size:13.5px;font-weight:300;color:var(--dim);line-height:1.9;margin-bottom:28px}
    .feat-block__pts{display:flex;flex-direction:column;gap:8px}
    .feat-block__pt{font-size:12.5px;color:rgba(242,236,226,0.38);font-weight:300;
      display:flex;align-items:flex-start;gap:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.04)}
    .feat-block__pt::before{content:'';width:3px;height:3px;border-radius:50%;background:var(--gold);margin-top:8px;flex-shrink:0}

    /* ══ AERIAL CTA BAND ══ */
    .aerial{position:relative;overflow:hidden;height:480px;display:flex;align-items:center;justify-content:center}
    .aerial__bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(0.45)}
    .aerial__ov{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(6,5,4,0.4),rgba(6,5,4,0.6))}
    .aerial__content{position:relative;z-index:2;text-align:center;padding:0 40px}
    .aerial__title{font-family:'Cormorant',serif;font-size:clamp(40px,6vw,80px);font-weight:700;
      color:var(--white);line-height:0.9;letter-spacing:-2px;margin-bottom:24px}
    .aerial__title span{color:var(--gold)}
    .aerial__sub{font-size:14px;font-weight:300;color:rgba(242,236,226,0.6);max-width:500px;margin:0 auto 40px;line-height:1.8}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:13px 32px;font-size:10px;
      font-weight:500;letter-spacing:2px;text-transform:uppercase;transition:var(--t);cursor:pointer}
    .btn-gold{background:var(--gold);color:#000;border:1px solid var(--gold)}
    .btn-gold:hover{background:var(--gold-lt);border-color:var(--gold-lt);transform:translateY(-2px);box-shadow:0 12px 32px rgba(201,169,110,0.25)}
    .btn-ghost{background:transparent;color:var(--white);border:1px solid rgba(255,255,255,0.25)}
    .btn-ghost:hover{border-color:var(--white);background:rgba(255,255,255,0.06);transform:translateY(-2px)}

    /* ══ VISIT INFO ══ */
    .vinfo{background:var(--bg);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:64px 80px}
    .vinfo__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr;gap:44px;align-items:start}
    .vinfo__div{background:var(--border);height:100%;min-height:80px}
    .vinfo__label{font-size:8.5px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:16px}
    .vinfo__title{font-family:'Cormorant',serif;font-size:21px;color:var(--white);margin-bottom:10px}
    .vinfo__detail{font-size:13px;font-weight:300;color:var(--dim);line-height:1.85}
    .closed-badge{display:inline-block;margin-top:8px;font-size:9.5px;letter-spacing:2px;
      text-transform:uppercase;color:#d96060;border:1px solid rgba(217,96,96,0.25);padding:3px 12px}

    /* ══ FOOTER ══ */
    .ftr{background:#000;border-top:1px solid var(--border);padding:72px 80px 36px}
    .ftr__grid{max-width:1200px;margin:0 auto}
    .ftr__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:52px;
      padding-bottom:52px;border-bottom:1px solid var(--border);margin-bottom:28px}
    .ftr__brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .ftr__brand-logo img{width:30px}
    .ftr__brand-logo strong{font-family:'Cormorant',serif;font-size:17px;color:var(--white);font-weight:600;letter-spacing:1px}
    .ftr__brand p{font-size:12.5px;color:rgba(255,255,255,0.25);line-height:1.75;font-weight:300}
    .ftr__partners{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
    .ftr__partners a{filter:none}
    .ftr__partners a:hover{opacity:0.5}
    .ftr__col h4{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
    .ftr__col a{display:block;font-size:12.5px;color:rgba(255,255,255,0.25);padding:5px 0;transition:color 0.15s,padding-left 0.2s}
    .ftr__col a:hover{color:var(--white);padding-left:6px}
    .ftr__bot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
      gap:10px;font-size:11px;color:rgba(255,255,255,0.16);letter-spacing:0.3px}
    .ftr__bot a{color:rgba(255,255,255,0.2);transition:color 0.15s}
    .ftr__bot a:hover{color:var(--white)}
    .ftr__atm{color:var(--gold)!important;font-weight:500}
    .ftr__atm:hover{color:var(--gold-lt)!important}

    /* ══ RESPONSIVE ══ */
    @@media(max-width:1100px){
      .overview__inner{grid-template-columns:1fr;gap:56px}
      .feat-block{grid-template-columns:1fr}
      .feat-block--flip{direction:ltr}
      .feat-block__badge{display:none}
      .feat-block--flip .feat-block__content{padding:48px 0}
      .intro-strip__inner{grid-template-columns:1fr 1fr;gap:32px}
      .intro-strip__div{display:none}
      .ftr__top{grid-template-columns:1fr 1fr}
      .vinfo__grid{grid-template-columns:1fr;gap:36px}
      .vinfo__div{display:none}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}
      .ham{display:flex}
      .hero__content{padding:0 24px 60px}
      .hero__line{left:24px}
      .hero__scroll-line{left:24px}
      .hero__stats{flex-wrap:wrap}
      .hero__stat{padding:14px 22px}
      .hero__dots{right:24px}
      .overview,.features,.vinfo,.ftr,.aerial,.intro-strip{padding-left:24px;padding-right:24px}
      .feat-header{padding:60px 24px 40px}
      .feat-block__content{padding:40px 24px!important}
      .feat-block__outline-num{font-size:70px}
      .ftr__top{grid-template-columns:1fr;gap:32px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
    @@media(max-width:480px){
      .hero__title{font-size:60px;letter-spacing:-2px}
      .intro-strip__inner{grid-template-columns:1fr 1fr}
    }
</style>
}

<main>
<!-- ══ HERO ══ -->
<section class="hero" id="hero">
  <div class="hero__bg">
    <div class="hero__slide active">
      <img src="~/assets/memorial.jpeg" alt="Smritivan Memorial aerial"
           onerror="this.src='https://www.smritivanearthquakemuseum.biz/assets2/DJI_0960-Enhanced-2%20.jpg'"/>
    </div>
    <div class="hero__slide">
      <img src="~/assets/memorial 3.jpg" alt="Smritivan Memorial"
           onerror="this.src='https://www.smritivanearthquakemuseum.biz/assets2/meorial1.png'"/>
    </div>
    <div class="hero__slide">
      <img src="~/assets/memorial 7.jpg" alt="Smritivan Reservoirs"
           onerror="this.src='https://www.smritivanearthquakemuseum.biz/assets2/4%265.jpeg'"/>
    </div>
  </div>
  <div class="hero__ov"></div>
  <div class="hero__line"></div>
  <div class="hero__scroll-line"></div>
  <div class="hero__content">
    <p class="hero__kicker">About the Memorial</p>
    <h1 class="hero__title">
      <em>Smritivan</em>
      Memorial
    </h1>
    <p class="hero__desc">A 170-acre living tribute to resilience — perched atop the historically significant Bhujiyo Dungar in Bhuj, Gujarat. Nature, memory, and renewal woven into one.</p>
    <div class="hero__stats">
      <div class="hero__stat"><div class="hero__stat-num">170<span> ac</span></div><div class="hero__stat-lbl">Acres of Memorial</div></div>
      <div class="hero__stat"><div class="hero__stat-num">4.5<span>L</span></div><div class="hero__stat-lbl">Plants — Miyawaki Forest</div></div>
      <div class="hero__stat"><div class="hero__stat-num">50</div><div class="hero__stat-lbl">Check-Dam Reservoirs</div></div>
      <div class="hero__stat"><div class="hero__stat-num">13<span>k</span></div><div class="hero__stat-lbl">Lives Remembered</div></div>
    </div>
  </div>
  <div class="hero__dots" id="hero-dots">
