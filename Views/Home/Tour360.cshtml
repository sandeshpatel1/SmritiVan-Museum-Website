@{
    ViewData["Title"] = "360° Virtual Tour";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>360° Virtual Tour — Smritivan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:wght@@300;400;600;700&family=DM+Sans:wght@@300;400;500&display=swap" rel="stylesheet" />
  <link rel="icon" href="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" type="image/png" />
  <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#0e0508;font-family:'DM Sans',sans-serif}
:root{--maroon:#7b2d3e;--gold:#c9955a;--gold-light:#e8c49a;}
#pano-canvas{position:fixed;inset:0;cursor:grab;background:#0e0508;display:block;}
#pano-canvas:active{cursor:grabbing;}
#loader{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#0e0508;transition:opacity 0.6s ease;}
#loader.hidden{opacity:0;pointer-events:none;}
.loader-logo{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:600;color:#fff;letter-spacing:2px;margin-bottom:28px;}
.loader-bar-wrap{width:200px;height:2px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;}
.loader-bar{height:100%;width:0;background:var(--gold);border-radius:2px;transition:width 0.3s ease;}
.loader-text{margin-top:14px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);}
#hud-top{position:fixed;top:0;left:0;right:0;z-index:100;padding:20px 28px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(to bottom,rgba(14,5,8,0.85) 0%,transparent 100%);pointer-events:none;}
.hud-logo{display:flex;align-items:center;gap:10px;}
.hud-logo img{width:36px;height:36px;object-fit:contain;}
.hud-logo span{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:#fff;}
.hud-label{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold-light);padding:6px 16px;border:1px solid rgba(201,149,90,0.35);border-radius:30px;backdrop-filter:blur(6px);background:rgba(201,149,90,0.05);}
#scene-info{position:fixed;bottom:140px;left:28px;z-index:100;max-width:320px;pointer-events:none;transition:opacity 0.4s,transform 0.4s;}
#scene-info.hidden{opacity:0;transform:translateY(8px);}
.scene-info__name{font-family:'Cormorant Garamond',serif;font-size:30px;font-weight:600;color:#fff;line-height:1.1;margin-bottom:6px;text-shadow:0 2px 12px rgba(0,0,0,0.7);}
.scene-info__desc{font-size:13px;color:rgba(255,255,255,0.6);line-height:1.55;text-shadow:0 1px 6px rgba(0,0,0,0.8);}
.scene-info__count{margin-top:10px;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);}
#scene-nav{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:100;display:flex;gap:12px;align-items:center;}
.scene-thumb{position:relative;width:80px;height:50px;border-radius:8px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color 0.25s,transform 0.25s,box-shadow 0.25s;flex-shrink:0;}
.scene-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
.scene-thumb__label{position:absolute;bottom:0;left:0;right:0;padding:3px 6px;background:linear-gradient(to top,rgba(0,0,0,0.8),transparent);font-size:9px;letter-spacing:0.5px;text-transform:uppercase;color:rgba(255,255,255,0.85);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.scene-thumb:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(0,0,0,0.5);}
.scene-thumb.active{border-color:var(--gold);}
#controls{position:fixed;right:24px;bottom:80px;z-index:100;display:flex;flex-direction:column;gap:8px;}
.ctrl-btn{width:40px;height:40px;border-radius:50%;background:rgba(14,5,8,0.75);border:1px solid rgba(255,255,255,0.15);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;transition:background 0.2s,border-color 0.2s;}
.ctrl-btn:hover{background:var(--maroon);border-color:var(--maroon);}
.ctrl-btn svg{width:16px;height:16px;pointer-events:none;}
#autorotate-pill{position:fixed;top:72px;right:24px;z-index:100;padding:6px 14px;border-radius:20px;background:rgba(14,5,8,0.7);border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(8px);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,0.5);display:flex;align-items:center;gap:6px;transition:opacity 0.3s;cursor:pointer;}
#autorotate-pill.active{border-color:var(--gold);color:var(--gold);}
#autorotate-pill .dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.3);transition:background 0.3s;}
#autorotate-pill.active .dot{background:var(--gold);animation:pulse 1.5s ease-in-out infinite;}
@@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.3;}}
#pano-fade{position:fixed;inset:0;z-index:50;background:#0e0508;opacity:0;pointer-events:none;transition:opacity 0.35s ease;}
#pano-fade.active{opacity:1;}
#compass{position:fixed;top:72px;left:28px;z-index:100;width:44px;height:44px;opacity:0.7;}
#compass svg{width:100%;height:100%;}
#gyro-hint{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:150;padding:12px 24px;border-radius:8px;background:rgba(14,5,8,0.88);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-size:13px;pointer-events:none;opacity:0;transition:opacity 0.4s;}
.key-hint{position:fixed;bottom:90px;left:28px;z-index:100;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,0.2);pointer-events:none;}
@@media(max-width:600px){.scene-thumb{width:60px;height:38px;}#scene-nav{gap:8px;bottom:20px;}#scene-info{bottom:120px;left:16px;right:16px;max-width:none;}.scene-info__name{font-size:22px;}#controls{right:12px;bottom:70px;}.key-hint{display:none;}}
  </style>
</head>
<div id="loader">
  <div class="loader-logo">Smritivan</div>
  <div class="loader-bar-wrap"><div class="loader-bar" id="loader-bar"></div></div>
  <div class="loader-text" id="loader-text">Preparing your tour&hellip;</div>
</div>
<canvas id="pano-canvas"></canvas>
<div id="pano-fade"></div>
<div id="hud-top">
  <div class="hud-logo">
    <img src="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" alt="Smritivan"/>
    <span>Smritivan</span>
  </div>
  <div class="hud-label">360&deg; Virtual Tour</div>
</div>
<div id="compass">
  <svg viewBox="0 0 44 44" fill="none">
    <circle cx="22" cy="22" r="20" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
    <circle cx="22" cy="22" r="1.5" fill="rgba(255,255,255,0.4)"/>
    <g id="compass-needle">
      <polygon points="22,6 24.5,22 22,18 19.5,22" fill="#e8c49a" opacity="0.9"/>
      <polygon points="22,38 24.5,22 22,26 19.5,22" fill="rgba(255,255,255,0.25)"/>
    </g>
    <text x="22" y="4.5" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-size="5" font-family="DM Sans">N</text>
  </svg>
</div>
<div id="autorotate-pill" onclick="toggleAutoRotate()"><div class="dot"></div>Auto-rotate</div>
<div id="scene-info">
  <div class="scene-info__name" id="si-name"></div>
  <div class="scene-info__desc" id="si-desc"></div>
  <div class="scene-info__count" id="si-count"></div>
</div>
<div id="controls">
  <button class="ctrl-btn" title="Zoom In" onclick="panoZoom(-1)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>
  <button class="ctrl-btn" title="Zoom Out" onclick="panoZoom(1)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>
  <button class="ctrl-btn" title="Reset View" onclick="resetView()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
  </button>
  <button class="ctrl-btn" title="Fullscreen" onclick="toggleFullscreen()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
  </button>
</div>
<div id="scene-nav"></div>
<div id="gyro-hint">Move your device to look around</div>
<div class="key-hint">Arrow keys to look &nbsp;|&nbsp; Scroll to zoom &nbsp;|&nbsp; Keys 1&ndash;4 to switch scenes</div>
<script>
const SCENES=[
  {id:"scene_a",label:"Main Entrance",desc:"Arrival Plaza — The iconic mushroom-canopy entrance to Smritivan",src:"data:image/jpeg;base64,"},
  {id:"scene_e",label:"Upper Courtyard",desc:"Open-air courtyard with architectural coil sculptures",src:"data:image/jpeg;base64,"},
  {id:"scene_desk",label:"Reception",desc:"Interior reception with multimedia orientation walls",src:"data:image/jpeg;base64,"},
  {id:"scene_2",label:"Simulation Theatre",desc:"World's largest immersive earthquake simulation theatre",src:"data:image/jpeg;base64,"}
];

let currentScene=0,lon=180,lat=0,fov=75;
let isDragging=false,lastX=0,lastY=0;
let autoRotate=true,autoRotateSpeed=0.03;
let textures=[],loadedCount=0,animFrame;
let compassNeedle,autoRotatePause;
let gyroEnabled=false;

const canvas=document.getElementById('pano-canvas');
const gl=canvas.getContext('webgl')||canvas.getContext('experimental-webgl');
if(!gl){document.getElementById('loader').innerHTML='<p style="color:#e8c49a;font-family:sans-serif;padding:40px;text-align:center">WebGL not supported in this browser. Please try Chrome or Firefox.</p>';throw new Error('no webgl');}

const VS=`attribute vec2 a_pos;varying vec2 v_uv;void main(){v_uv=a_pos*0.5+0.5;gl_Position=vec4(a_pos,0,1);}`;
const FS=`precision mediump float;varying vec2 v_uv;uniform sampler2D u_tex;uniform float u_lon;uniform float u_lat;uniform float u_fov;uniform vec2 u_res;
void main(){
  float aspect=u_res.x/u_res.y;
  vec2 ndc=(v_uv-0.5)*2.0;ndc.x*=aspect;
  float f=1.0/tan(u_fov*0.5);
  vec3 ray=normalize(vec3(ndc.x,ndc.y,f));
  float cosLat=cos(-u_lat),sinLat=sin(-u_lat);
  float cosLon=cos(u_lon),sinLon=sin(u_lon);
  vec3 r1=vec3(ray.x,ray.y*cosLat-ray.z*sinLat,ray.y*sinLat+ray.z*cosLat);
  vec3 r2=vec3(r1.x*cosLon-r1.z*sinLon,r1.y,r1.x*sinLon+r1.z*cosLon);
  float u=atan(r2.x,r2.z)/(2.0*3.14159265)+0.5;
  float v=asin(clamp(r2.y,-1.0,1.0))/3.14159265+0.5;
  gl_FragColor=texture2D(u_tex,vec2(u,1.0-v));
}`;

function mkShader(t,s){const sh=gl.createShader(t);gl.shaderSource(sh,s);gl.compileShader(sh);return sh;}
const prog=gl.createProgram();
gl.attachShader(prog,mkShader(gl.VERTEX_SHADER,VS));
gl.attachShader(prog,mkShader(gl.FRAGMENT_SHADER,FS));
gl.linkProgram(prog);gl.useProgram(prog);
const quad=gl.createBuffer();
gl.bindBuffer(gl.ARRAY_BUFFER,quad);
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
const aPosLoc=gl.getAttribLocation(prog,'a_pos');
gl.enableVertexAttribArray(aPosLoc);
gl.vertexAttribPointer(aPosLoc,2,gl.FLOAT,false,0,0);
const uLon=gl.getUniformLocation(prog,'u_lon'),uLat=gl.getUniformLocation(prog,'u_lat');
const uFov=gl.getUniformLocation(prog,'u_fov'),uRes=gl.getUniformLocation(prog,'u_res');
const uTex=gl.getUniformLocation(prog,'u_tex');

function loadTexture(src,index){
  const tex=gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D,tex);
  gl.texImage2D(gl.TEXTURE_2D,0,gl.RGB,1,1,0,gl.RGB,gl.UNSIGNED_BYTE,new Uint8Array([20,5,8]));
  const img=new Image();
  img.onload=()=>{
    gl.bindTexture(gl.TEXTURE_2D,tex);
    gl.texImage2D(gl.TEXTURE_2D,0,gl.RGB,gl.RGB,gl.UNSIGNED_BYTE,img);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
    loadedCount++;
    const pct=Math.round((loadedCount/SCENES.length)*100);
    document.getElementById('loader-bar').style.width=pct+'%';
    document.getElementById('loader-text').textContent='Loading scenes… '+pct+'%';
    if(loadedCount===SCENES.length){
      setTimeout(()=>{
        document.getElementById('loader').classList.add('hidden');
        setTimeout(()=>{document.getElementById('loader').style.display='none';},700);
      },400);
    }
  };
  img.src=src;
  return tex;
}

function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;gl.viewport(0,0,canvas.width,canvas.height);}

function render(){
  animFrame=requestAnimationFrame(render);
  if(autoRotate&&!isDragging)lon+=autoRotateSpeed;
  gl.uniform1f(uLon,lon*Math.PI/180);
  gl.uniform1f(uLat,Math.max(-85,Math.min(85,lat))*Math.PI/180);
  gl.uniform1f(uFov,fov*Math.PI/180);
  gl.uniform2f(uRes,canvas.width,canvas.height);
  if(textures[currentScene]){gl.bindTexture(gl.TEXTURE_2D,textures[currentScene]);gl.uniform1i(uTex,0);}
  gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
  if(compassNeedle)compassNeedle.setAttribute('transform','rotate('+(-lon%360)+',22,22)');
}

function switchScene(index){
  if(index===currentScene)return;
  const fade=document.getElementById('pano-fade');
  fade.classList.add('active');
  setTimeout(()=>{currentScene=index;lon=180;lat=0;updateSceneInfo();updateThumbs();fade.classList.remove('active');},380);
}

function updateSceneInfo(){
  const sc=SCENES[currentScene];
  const info=document.getElementById('scene-info');
  info.classList.add('hidden');
  setTimeout(()=>{
    document.getElementById('si-name').textContent=sc.label;
    document.getElementById('si-desc').textContent=sc.desc;
    document.getElementById('si-count').textContent='Scene '+(currentScene+1)+' of '+SCENES.length;
    info.classList.remove('hidden');
  },200);
}

function updateThumbs(){
  document.querySelectorAll('.scene-thumb').forEach((el,i)=>el.classList.toggle('active',i===currentScene));
}

function buildNav(){
  const nav=document.getElementById('scene-nav');
  SCENES.forEach((sc,i)=>{
    const div=document.createElement('div');
    div.className='scene-thumb'+(i===0?' active':'');
    div.title=sc.label;
    div.innerHTML='<img src="'+sc.src+'" alt="'+sc.label+'"/><div class="scene-thumb__label">'+sc.label+'</div>';
    div.addEventListener('click',()=>switchScene(i));
    nav.appendChild(div);
  });
}

window.panoZoom=(d)=>{fov=Math.max(30,Math.min(110,fov+d*6));};
window.resetView=()=>{lon=180;lat=0;fov=75;};
window.toggleFullscreen=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen().catch(()=>{});else document.exitFullscreen();};
window.toggleAutoRotate=()=>{autoRotate=!autoRotate;document.getElementById('autorotate-pill').classList.toggle('active',autoRotate);};

canvas.addEventListener('mousedown',e=>{isDragging=true;lastX=e.clientX;lastY=e.clientY;autoRotate=false;document.getElementById('autorotate-pill').classList.remove('active');clearTimeout(autoRotatePause);});
window.addEventListener('mouseup',()=>{isDragging=false;autoRotatePause=setTimeout(()=>{autoRotate=true;document.getElementById('autorotate-pill').classList.add('active');},4000);});
window.addEventListener('mousemove',e=>{if(!isDragging)return;lon-=(e.clientX-lastX)*0.18;lat+=Math.max(-85,Math.min(85,(e.clientY-lastY)*0.18));lastX=e.clientX;lastY=e.clientY;});
canvas.addEventListener('touchstart',e=>{e.preventDefault();isDragging=true;lastX=e.touches[0].clientX;lastY=e.touches[0].clientY;autoRotate=false;},{passive:false});
canvas.addEventListener('touchend',()=>{isDragging=false;});
canvas.addEventListener('touchmove',e=>{e.preventDefault();if(!isDragging)return;lon-=(e.touches[0].clientX-lastX)*0.22;lat=Math.max(-85,Math.min(85,lat+(e.touches[0].clientY-lastY)*0.22));lastX=e.touches[0].clientX;lastY=e.touches[0].clientY;},{passive:false});
let initPinchDist=null,initFov=fov;
canvas.addEventListener('touchstart',e=>{if(e.touches.length===2){initPinchDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);initFov=fov;}},{passive:true});
canvas.addEventListener('touchmove',e=>{if(e.touches.length===2&&initPinchDist){const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);fov=Math.max(30,Math.min(110,initFov*(initPinchDist/d)));}},{passive:true});
canvas.addEventListener('wheel',e=>{e.preventDefault();fov=Math.max(30,Math.min(110,fov+e.deltaY*0.04));},{passive:false});
window.addEventListener('keydown',e=>{
  if(e.key==='ArrowLeft')lon-=2;
  if(e.key==='ArrowRight')lon+=2;
  if(e.key==='ArrowUp')lat=Math.max(-85,lat-2);
  if(e.key==='ArrowDown')lat=Math.min(85,lat+2);
  if(e.key==='+'||e.key==='=')fov=Math.max(30,fov-3);
  if(e.key==='-')fov=Math.min(110,fov+3);
  if(e.key>='1'&&e.key<='4')switchScene(parseInt(e.key)-1);
});

window.addEventListener('resize',resize);
resize();
compassNeedle=document.getElementById('compass-needle');
document.getElementById('autorotate-pill').classList.add('active');
textures=SCENES.map((sc,i)=>loadTexture(sc.src,i));
buildNav();
updateSceneInfo();
render();
</script>
</html>
