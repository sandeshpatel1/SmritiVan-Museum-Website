@{
    ViewData["Title"] = "Brief History";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}

    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
      --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
      --bg:#060504;--bg2:#0a0807;
    }

    /* ══ HEADER — page-level overrides for dark/transparent style ══
       These override layout.css so the header is transparent on this dark-bg page */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent;background:transparent;box-shadow:none; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t);border:none;background:none;cursor:pointer;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center; }
    .hdr__link:hover { color:var(--white); }
    /* FIXED: active now clearly visible with gold underline */
    .hdr__link.active { color:var(--white);border-bottom:2px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px;text-decoration:none; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    /* FIXED: uses visibility so transition works, not display:none */
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#111;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s,visibility 0s linear 0.2s;z-index:999; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;visibility:visible;pointer-events:all;transform:translateY(0);transition:opacity 0.2s,transform 0.2s,visibility 0s linear 0s; }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s;text-decoration:none;white-space:nowrap; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    /* FIXED: active dropdown item highlighted */
    .hdr__drop-item.active { color:var(--white);background:rgba(201,169,110,0.08);border-left:2px solid var(--gold);padding-left:14px; }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

    /* ══ HERO ══ */
    .hero{position:relative;height:88vh;min-height:600px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center}
    .hero__ov{position:absolute;inset:0;
      background:linear-gradient(160deg,rgba(6,5,4,0.2) 0%,rgba(6,5,4,0.55) 50%,rgba(6,5,4,0.97) 100%)}
    .hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
    .hero__scroll-line{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
      width:1px;height:72px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
      animation:pulse 2.5s ease-in-out infinite}
    @@keyframes pulse{0%,100%{opacity:1;transform:translateX(-50%) scaleY(1)}50%{opacity:0.25;transform:translateX(-50%) scaleY(0.4)}}
    .hero__content{position:relative;z-index:3;padding:110px 60px 20px 110px;max-width:900px}
    .hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
      color:var(--gold);margin-bottom:22px;display:flex;align-items:center;gap:16px;
      opacity:0;animation:fadeUp 0.9s 0.2s forwards}
    .hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(52px,8vw,110px);
      font-weight:700;line-height:0.88;letter-spacing:-3px;color:var(--white);
      margin-bottom:32px;opacity:0;animation:fadeUp 1s 0.4s forwards}
    .hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.48em;
      letter-spacing:4px;color:rgba(201,169,110,0.75);margin-bottom:12px}
    .hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
      max-width:520px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
      padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* ══ UTILS ══ */
    .tag{font-size:9px;font-weight:500;letter-spacing:5px;text-transform:uppercase;
      color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:16px}
    .tag::before{content:'';width:24px;height:1px;background:var(--gold)}
    .sec-title{font-family:'Cormorant',serif;font-size:clamp(32px,4.5vw,58px);
      font-weight:700;color:var(--white);line-height:0.95;letter-spacing:-0.5px}
    .rule{width:40px;height:1px;background:var(--gold);margin:22px 0 30px}
    .reveal{opacity:0;transform:translateY(36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal.in{opacity:1;transform:none}
    .reveal-l{opacity:0;transform:translateX(-36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal-l.in{opacity:1;transform:none}
    .reveal-r{opacity:0;transform:translateX(36px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal-r.in{opacity:1;transform:none}

    /* ══ STATS STRIP ══ */
    .stats-strip{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:52px 80px}
    .stats-strip__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr 1px 1fr;gap:40px;align-items:center}
    .stats-strip__div{background:var(--border);height:52px}
    .stats-strip__val{font-family:'Cormorant',serif;font-size:40px;font-weight:700;color:var(--white);line-height:1}
    .stats-strip__val span{color:var(--gold)}
    .stats-strip__lbl{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim);margin-top:5px}

    /* ══ CHAPTER BLOCKS ══ */
    .chapters{background:var(--bg);position:relative;overflow:hidden}
    .chapters::before{content:'HISTORY';position:absolute;right:-10px;top:50%;transform:translateY(-50%);
      font-family:'Cormorant',serif;font-size:220px;font-weight:700;color:rgba(201,169,110,0.018);
      line-height:1;pointer-events:none;letter-spacing:-8px;white-space:nowrap}

    .chapter{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border);position:relative}
    .chapter:last-child{border-bottom:none}
    .chapter--flip{direction:rtl}
    .chapter--flip>*{direction:ltr}

    .chapter__badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
      width:52px;height:52px;background:var(--bg);border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;z-index:4;
      font-family:'Cormorant',serif;font-size:18px;font-weight:700;color:var(--gold)}

    .chapter__img{position:relative;overflow:hidden;aspect-ratio:4/3}
    .chapter__img img{width:100%;height:100%;object-fit:cover;object-position:center;
      transition:transform 0.7s ease,filter 0.5s;filter:grayscale(30%) brightness(0.75)}
    .chapter:hover .chapter__img img{transform:scale(1.04);filter:grayscale(0%) brightness(1)}
    .chapter__num-tag{position:absolute;top:24px;left:24px;z-index:2;
      font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);
      background:rgba(0,0,0,0.65);border:1px solid var(--border);padding:5px 12px}
    .chapter__img-ov{position:absolute;inset:0;background:linear-gradient(to right,rgba(6,5,4,0.12),transparent)}
    .chapter--flip .chapter__img-ov{background:linear-gradient(to left,rgba(6,5,4,0.12),transparent)}

    .chapter__content{padding:72px 80px;display:flex;flex-direction:column;justify-content:center}
    .chapter--flip .chapter__content{padding:72px 80px 72px 56px}
    .chapter__outline-num{font-family:'Cormorant',serif;font-size:110px;font-weight:700;
      line-height:0.85;color:transparent;letter-spacing:-4px;margin-bottom:18px;
      -webkit-text-stroke:1px rgba(201,169,110,0.08)}
    .chapter__tag{font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
    .chapter__title{font-family:'Cormorant',serif;font-size:clamp(36px,3.5vw,54px);
      font-weight:700;color:var(--white);line-height:1;margin-bottom:20px}
    .chapter__body{font-size:13.5px;font-weight:300;color:var(--dim);line-height:1.95;margin-bottom:28px}
    .chapter__facts{display:flex;flex-direction:column;gap:0}
    .chapter__fact{font-size:12px;color:rgba(242,236,226,0.38);font-weight:300;
      display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-top:1px solid rgba(255,255,255,0.04)}
    .chapter__fact::before{content:'';width:3px;height:3px;border-radius:50%;background:var(--gold);margin-top:8px;flex-shrink:0}

    /* ══ QUOTE BAND ══ */
    .quote-band{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);
      padding:88px 80px;text-align:center;position:relative;overflow:hidden}
    .quote-band::before{content:'"';font-family:'Cormorant',serif;font-size:400px;font-weight:700;
      color:rgba(201,169,110,0.04);position:absolute;top:-60px;left:50%;transform:translateX(-50%);
      line-height:1;pointer-events:none}
    .quote-band__inner{max-width:760px;margin:0 auto;position:relative;z-index:1}
    .quote-band__text{font-family:'Cormorant',serif;font-size:clamp(22px,3vw,36px);font-weight:400;
      font-style:italic;color:var(--white);line-height:1.5;margin-bottom:28px}
    .quote-band__text span{color:var(--gold)}
    .quote-band__attr{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
    .quote-band__rule{width:40px;height:1px;background:var(--gold);margin:0 auto 20px}

    /* ══ FOOTER ══ */
    .ftr{background:#000;border-top:1px solid var(--border);padding:72px 80px 36px}
    .ftr__grid{max-width:1200px;margin:0 auto}
    .ftr__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:52px;
      padding-bottom:52px;border-bottom:1px solid var(--border);margin-bottom:28px}
    .ftr__brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .ftr__brand-logo img{width:30px}
    .ftr__brand-logo strong{font-family:'Cormorant',serif;font-size:17px;color:var(--white);font-weight:600;letter-spacing:1px}
    .ftr__brand p{font-size:12.5px;color:rgba(255,255,255,0.25);line-height:1.75;font-weight:300}
    .ftr__partners{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
    .ftr__partners a{filter:none}
    .ftr__partners a:hover{opacity:0.5}
    .ftr__col h4{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
    .ftr__col a{display:block;font-size:12.5px;color:rgba(255,255,255,0.25);padding:5px 0;transition:color 0.15s,padding-left 0.2s}
    .ftr__col a:hover{color:var(--white);padding-left:6px}
    .ftr__bot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
      gap:10px;font-size:11px;color:rgba(255,255,255,0.16);letter-spacing:0.3px}
    .ftr__bot a{color:rgba(255,255,255,0.2);transition:color 0.15s}
    .ftr__bot a:hover{color:var(--white)}
    .ftr__atm{color:var(--gold)!important;font-weight:500}
    .ftr__atm:hover{color:var(--gold-lt)!important}

    /* ══ RESPONSIVE ══ */
    @@media(max-width:1100px){
      .chapter{grid-template-columns:1fr}
      .chapter--flip{direction:ltr}
      .chapter__badge{display:none}
      .chapter--flip .chapter__content{padding:48px 40px}
      .stats-strip__inner{grid-template-columns:1fr 1fr;gap:32px}
      .stats-strip__div{display:none}
      .ftr__top{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}
      .ham{display:flex}
      .hero__content{padding:0 24px 64px}
      .hero__line{left:24px}
      .hero__scroll-line{left:24px}
      .stats-strip,.quote-band,.ftr{padding-left:24px;padding-right:24px}
      .chapter__content{padding:48px 24px!important}
      .chapter__outline-num{font-size:80px}
      .ftr__top{grid-template-columns:1fr;gap:32px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
    @@media(max-width:480px){
      .hero__title{font-size:58px;letter-spacing:-2px}
      .stats-strip__inner{grid-template-columns:1fr 1fr}
    }
</style>
}

<main>
<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero__bg">
    <img src="~/assets/breif.jpg" alt="A Brief History — 2001 Kutch Earthquake"/>
  </div>
  <div class="hero__ov"></div>
  <div class="hero__line"></div>
  <div class="hero__scroll-line"></div>
  <div class="hero__content">
    <p class="hero__kicker">About Smritivan</p>
    <h1 class="hero__title">
      <em>The Story</em>
      A Brief<br>History
    </h1>
    <p class="hero__desc">From the ruins of 26th January 2001 to a thriving memorial and museum — the extraordinary journey of Kutch, its people, and the vision that shaped Smritivan.</p>
  </div>
</section>

<!-- ══ STATS STRIP ══ -->
<div class="stats-strip">
  <div class="stats-strip__inner reveal">
    <div>
      <div class="stats-strip__val">7.7<span> M</span></div>
      <div class="stats-strip__lbl">Richter Scale</div>
    </div>
    <div class="stats-strip__div"></div>
    <div>
      <div class="stats-strip__val">12,932</div>
      <div class="stats-strip__lbl">Lives Lost</div>
    </div>
    <div class="stats-strip__div"></div>
    <div>
      <div class="stats-strip__val">890</div>
      <div class="stats-strip__lbl">Villages Affected</div>
    </div>
    <div class="stats-strip__div"></div>
    <div>
      <div class="stats-strip__val">1<span>M+</span></div>
      <div class="stats-strip__lbl">Homes Destroyed</div>
    </div>
  </div>
</div>

<!-- ══ CHAPTER BLOCKS ══ -->
<section class="chapters">

  <!-- Chapter 1: The Earthquake -->
  <article class="chapter">
    <div class="chapter__badge">01</div>
    <div class="chapter__img reveal-l">
      <img src="https://www.smritivanearthquakemuseum.biz/assets2/brief1.png" alt="2001 Kutch Earthquake Devastation" loading="lazy"/>
      <div class="chapter__num-tag">01 / 03</div>
      <div class="chapter__img-ov"></div>
    </div>
    <div class="chapter__content reveal-r">
      <div class="chapter__outline-num">01</div>
      <div class="chapter__tag">26th January 2001</div>
      <h2 class="chapter__title">The<br>Earthquake</h2>
      <p class="chapter__body">India's 52nd Republic Day turned into one of the most tragic days in the country's history. At 8:46 AM, an earthquake measuring 7.7 on the Richter scale — with a maximum felt intensity of X (Extreme) on the Mercalli scale — struck the city of Bhuj in Gujarat's Kutch district. The devastation was akin to a war zone: lives, homes, temples, and livelihoods wiped away within seconds.</p>
      <p class="chapter__body">It was the worst disaster to strike India since independence in 1947.</p>
      <div class="chapter__facts">
        <div class="chapter__fact">12,932 lives lost across Kutch district</div>
        <div class="chapter__fact">164,000 people injured; 890 villages affected</div>
        <div class="chapter__fact">Over one million homes destroyed, including temples and heritage structures</div>
        <div class="chapter__fact">Worst disaster in India since independence — Republic Day, 2001</div>
      </div>
    </div>
  </article>

  <!-- Chapter 2: The Rebuilding -->
  <article class="chapter chapter--flip">
    <div class="chapter__badge">02</div>
    <div class="chapter__img reveal-r">
      <img src="https://www.smritivanearthquakemuseum.biz/assets2/brief2.png" alt="Kutch Rebuilding Effort" loading="lazy"/>
      <div class="chapter__num-tag">02 / 03</div>
      <div class="chapter__img-ov"></div>
    </div>
    <div class="chapter__content reveal-l">
      <div class="chapter__outline-num">02</div>
      <div class="chapter__tag">Resilience &amp; Renewal</div>
      <h2 class="chapter__title">The<br>Rebuilding</h2>
      <p class="chapter__body">The rebuilding that followed the 2001 earthquake is a testament to the indomitable spirit of the people of Kutch. Within a single decade, the region transformed from rubble into a thriving economic powerhouse — a transformation that set a global benchmark in post-disaster reconstruction.</p>
      <p class="chapter__body">The Gujarat State Disaster Management Authority (GSDMA) was established immediately after the earthquake to lead the reconstruction and rehabilitation effort, becoming a model institution for disaster response worldwide.</p>
      <div class="chapter__facts">
        <div class="chapter__fact">GSDMA established — setting a global benchmark in disaster management</div>
        <div class="chapter__fact">Region rebuilt within a decade; now a leading business hub in India</div>
        <div class="chapter__fact">International recognition for speed and scale of reconstruction</div>
      </div>
    </div>
  </article>

  <!-- Chapter 3: The Dream -->
  <article class="chapter">
    <div class="chapter__badge">03</div>
    <div class="chapter__img reveal-l">
      <img src="https://www.smritivanearthquakemuseum.biz/assets2/DJI_0960-Enhanced.jpeg" alt="Smritivan Memorial — Dream of Chief Minister" loading="lazy"/>
      <div class="chapter__num-tag">03 / 03</div>
      <div class="chapter__img-ov"></div>
    </div>
    <div class="chapter__content reveal-r">
      <div class="chapter__outline-num">03</div>
      <div class="chapter__tag">Vision &amp; Legacy</div>
      <h2 class="chapter__title">The<br>Dream</h2>
      <p class="chapter__body">Smritivan — meaning "Forest of Memories" — was the dream project of then Chief Minister Shri Narendra Modi. His vision was to create a living memorial that would not only honour the nearly 13,000 souls lost but also celebrate the extraordinary resilience and rebuilding spirit of the people of Kutch.</p>
      <p class="chapter__body">Inaugurated on 28th August 2022 by Prime Minister Shri Narendra Modi, Smritivan now stands as a 170-acre sanctuary of memory, ecology, and renewal atop the historically significant Bhujiyo Dungar in Bhuj — a beacon of hope rising from the ruins of 2001.</p>
      <div class="chapter__facts">
        <div class="chapter__fact">Dream project of then Chief Minister Shri Narendra Modi</div>
        <div class="chapter__fact">Inaugurated on 28th August 2022 by Prime Minister Narendra Modi</div>
        <div class="chapter__fact">170 acres — a living memorial honouring 12,932 lives on Bhujiyo Dungar</div>
      </div>
    </div>
  </article>

</section>

<!-- ══ QUOTE BAND ══ -->
<div class="quote-band">
  <div class="quote-band__inner reveal">
    <div class="quote-band__rule"></div>
    <p class="quote-band__text">"From the <span>ruins of tragedy</span> rose a forest of memory — a testament that the spirit of Kutch cannot be broken."</p>
    <div class="quote-band__attr">Smritivan Earthquake Memorial &amp; Museum — Bhuj, Gujarat</div>
  </div>
</div>
</main>

@section Scripts {
<script>
(function(){
  'use strict';

  /* ── HEADER SCROLL ── */
  var hdr = document.getElementById('hdr');
  window.addEventListener('scroll', function(){ hdr.classList.toggle('scrolled', scrollY > 40); }, {passive:true});

  /* ── HAMBURGER ── */
  var ham = document.getElementById('ham-btn'),
      mob = document.getElementById('mob-nav'),
      ov  = document.getElementById('mob-ov'),
      cl  = document.getElementById('mob-close');
  function openNav(){ mob.classList.add('open'); ov.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeNav(){ mob.classList.remove('open'); ov.classList.remove('open'); document.body.style.overflow=''; }
  ham.addEventListener('click', openNav);
  ov.addEventListener('click', closeNav);
  cl.addEventListener('click', closeNav);
  mob.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', closeNav); });

  /* ── SCROLL REVEAL ── */
  var revEls = document.querySelectorAll('.reveal,.reveal-l,.reveal-r');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold: 0.07});
  revEls.forEach(function(el){ io.observe(el); });

})();
</script>
}
