@{
    ViewData["Title"] = "Museum Map";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}

    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
      --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
      --bg:#060504;--bg2:#0a0807;
    }
    /* ══ HEADER ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo { display:flex;align-items:center;gap:12px; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
    .hdr__link:hover { color:var(--white); }
    .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

    /* ══ HERO ══ */
    .hero{position:relative;height:80vh;min-height:420px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center 35%;
      animation:heroZoom 18s ease-in-out infinite alternate}
    @@keyframes heroZoom{from{transform:scale(1.04)}to{transform:scale(1.10)}}
    .hero__ov{position:absolute;inset:0;background:linear-gradient(170deg,rgba(6,5,4,0.35) 0%,rgba(6,5,4,0.68) 50%,rgba(6,5,4,0.98) 100%)}
    .hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
    .hero__scroll-line{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
      width:1px;height:60px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
      animation:pulse 2.5s ease-in-out infinite}
    @@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.2}}
    .hero__content{position:relative;z-index:3;padding:0 80px 52px;max-width:800px}
    .hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
      color:var(--gold);margin-bottom:18px;display:flex;align-items:center;gap:16px;
      opacity:0;animation:fadeUp 0.9s 0.2s forwards}
    .hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(48px,7vw,96px);
      font-weight:700;line-height:0.9;letter-spacing:-2px;color:var(--white);
      margin-bottom:22px;opacity:0;animation:fadeUp 1s 0.4s forwards}
    .hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.48em;
      letter-spacing:4px;color:rgba(201,169,110,0.8);margin-bottom:8px}
    .hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
      max-width:500px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
      padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

    /* ══ LEGEND STRIP ══ */
    .legend-strip{background:var(--bg2);border-bottom:1px solid var(--border);
      position:sticky;top:64px;z-index:80;overflow-x:auto;scrollbar-width:none}
    .legend-strip::-webkit-scrollbar{display:none}
    .legend-strip__inner{max-width:1320px;margin:0 auto;padding:0 80px;
      display:flex;align-items:stretch;min-width:max-content}
    .legend-item{display:flex;align-items:center;gap:12px;padding:16px 24px;
      border-right:1px solid var(--border);transition:background 0.2s;cursor:default;
      position:relative}
    .legend-item::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
      background:var(--gold);transform:scaleX(0);transition:transform 0.3s}
    .legend-item:hover::after{transform:scaleX(1)}
    .legend-item:hover{background:var(--faint)}
    .legend-icon{font-size:22px;line-height:1;flex-shrink:0}
    .legend-label{font-size:11px;letter-spacing:1px;color:var(--dim);white-space:nowrap;font-weight:400}
    .legend-item:hover .legend-label{color:var(--white)}

    /* ══ MAP SECTION ══ */
    .map-section{background:var(--bg);padding:0}
    .map-wrap{position:relative;background:#000;overflow:hidden;
      border-bottom:1px solid var(--border)}
    .map-wrap__badge{position:absolute;top:20px;left:20px;z-index:10;
      background:rgba(0,0,0,0.82);border:1px solid var(--border);padding:8px 16px;
      display:flex;align-items:center;gap:10px;pointer-events:none;backdrop-filter:blur(8px)}
    .map-wrap__badge svg{width:16px;height:16px;stroke:var(--gold);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .map-wrap__badge span{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold)}
    .map-iframe{width:100%;height:660px;border:none;display:block;
      filter:brightness(0.92) saturate(0.9);transition:filter 0.4s}
    .map-iframe:hover{filter:brightness(1) saturate(1)}
    .map-fullscreen-btn{position:absolute;top:20px;right:20px;z-index:10;
      width:40px;height:40px;background:rgba(0,0,0,0.8);border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;color:var(--dim);
      transition:var(--t);backdrop-filter:blur(8px)}
    .map-fullscreen-btn:hover{border-color:var(--gold);color:var(--gold)}
    .map-fullscreen-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

    /* Fullscreen state */
    body.map-fs .map-iframe{position:fixed;inset:0;height:100vh;z-index:9000;filter:none}
    body.map-fs .map-fullscreen-btn{position:fixed;top:20px;right:20px;z-index:9001;background:rgba(0,0,0,0.9)}

    /* ══ INFO SECTION ══ */
    .info-section{background:var(--bg2);border-top:1px solid var(--border);padding:72px 80px}
    .info-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:2px}
    .info-card{background:rgba(0,0,0,0.4);border:1px solid var(--border);padding:36px 32px;
      transition:border-color var(--t),background var(--t)}
    .info-card:hover{border-color:rgba(201,169,110,0.3);background:rgba(201,169,110,0.03)}
    .info-card__icon{width:44px;height:44px;border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;margin-bottom:20px;
      transition:border-color var(--t)}
    .info-card:hover .info-card__icon{border-color:var(--gold)}
    .info-card__icon svg{width:20px;height:20px;stroke:var(--gold);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
    .info-card__label{font-size:8.5px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:10px}
    .info-card__title{font-family:'Cormorant',serif;font-size:20px;font-weight:700;color:var(--white);margin-bottom:10px}
    .info-card__text{font-size:13px;font-weight:300;color:var(--dim);line-height:1.8}
    .info-card__closed{display:inline-block;margin-top:8px;font-size:9px;letter-spacing:2px;
      text-transform:uppercase;color:#d96060;border:1px solid rgba(217,96,96,0.25);padding:3px 10px}

    /* ══ CTA STRIP ══ */
    .cta-strip{background:var(--bg);border-top:1px solid var(--border);padding:52px 80px;
      display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px}
    .cta-strip__left{}
    .cta-strip__tag{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);
      font-weight:500;margin-bottom:8px;display:flex;align-items:center;gap:10px}
    .cta-strip__tag::before{content:'';width:20px;height:1px;background:var(--gold)}
    .cta-strip__title{font-family:'Cormorant',serif;font-size:clamp(22px,3vw,38px);
      font-weight:700;color:var(--white);line-height:1}
    .cta-strip__btns{display:flex;gap:12px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;font-size:10px;
      font-weight:500;letter-spacing:2px;text-transform:uppercase;transition:var(--t);cursor:pointer}
    .btn-gold{background:var(--gold);color:#000;border:1px solid var(--gold)}
    .btn-gold:hover{background:var(--gold-lt);border-color:var(--gold-lt);transform:translateY(-2px);
      box-shadow:0 12px 32px rgba(201,169,110,0.25)}
    .btn-outline{background:transparent;border:1px solid var(--border);color:var(--dim)}
    .btn-outline:hover{border-color:var(--gold);color:var(--gold)}

    /* ══ REVEAL ══ */
    .reveal{opacity:0;transform:translateY(32px);transition:opacity 0.8s ease,transform 0.8s ease}
    .reveal.in{opacity:1;transform:none}

    /* ══ FOOTER ══ */
    .ftr{background:#000;border-top:1px solid var(--border);padding:72px 80px 36px}
    .ftr__grid{max-width:1200px;margin:0 auto}
    .ftr__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:52px;
      padding-bottom:52px;border-bottom:1px solid var(--border);margin-bottom:28px}
    .ftr__brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .ftr__brand-logo img{width:30px}
    .ftr__brand-logo strong{font-family:'Cormorant',serif;font-size:17px;color:var(--white);font-weight:600;letter-spacing:1px}
    .ftr__brand p{font-size:12.5px;color:rgba(255,255,255,0.25);line-height:1.75;font-weight:300}
    .ftr__partners{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
    .ftr__partners a{filter:none;opacity:0.9;transition:opacity 0.2s}
    .ftr__partners a:hover{opacity:0.6}
    .ftr__col h4{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
    .ftr__col a{display:block;font-size:12.5px;color:rgba(255,255,255,0.25);padding:5px 0;transition:color 0.15s,padding-left 0.2s}
    .ftr__col a:hover{color:var(--white);padding-left:6px}
    .ftr__bot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
      gap:10px;font-size:11px;color:rgba(255,255,255,0.16)}
    .ftr__bot a{color:rgba(255,255,255,0.2);transition:color 0.15s}
    .ftr__bot a:hover{color:var(--white)}
    .ftr__atm{color:var(--gold)!important;font-weight:500}
    .ftr__atm:hover{color:var(--gold-lt)!important}

    @@media(max-width:1100px){
      .info-inner{grid-template-columns:1fr 1fr}
      .ftr__top{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}.ham{display:flex}
      .hero__content{padding:0 24px 44px}.hero__line{left:24px}.hero__scroll-line{left:24px}
      .legend-strip__inner{padding:0 16px}
      .info-section,.cta-strip,.ftr{padding-left:24px;padding-right:24px}
      .info-inner{grid-template-columns:1fr}
      .map-iframe{height:440px}
      .ftr__top{grid-template-columns:1fr;gap:28px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
</style>
}

<main>
<!-- HERO -->
<section class="hero">
  <div class="hero__bg">
    <img src="https://www.smritivanearthquakemuseum.biz/assets2/BHA_7750%20.jpeg" alt="Museum Map" loading="eager"
         onerror="this.src='https://images.unsplash.com/photo-1524661135-423995f22d0b?w=1600&q=80'"/>
  </div>
  <div class="hero__ov"></div>
  <div class="hero__line"></div>
  <div class="hero__scroll-line"></div>
  <div class="hero__content">
    <p class="hero__kicker">Navigate the Museum</p>
    <h1 class="hero__title">
      <em>Interactive</em>
      Museum<br>Map
    </h1>
    <p class="hero__desc">Explore the full layout of Smritivan — all seven gallery blocks, amenities, and landmarks — across 470 acres on Bhujiyo Dungar.</p>
  </div>
</section>

<!-- LEGEND STRIP -->
<div class="legend-strip">
  <div class="legend-strip__inner">
    <div class="legend-item"><span class="legend-icon">ℹ️</span><span class="legend-label">Reception</span></div>
    <div class="legend-item"><span class="legend-icon">☕</span><span class="legend-label">Cafeteria</span></div>
    <div class="legend-item"><span class="legend-icon">🛍️</span><span class="legend-label">Gift Shop</span></div>
    <div class="legend-item"><span class="legend-icon">📚</span><span class="legend-label">Library</span></div>
    <div class="legend-item"><span class="legend-icon">🎮</span><span class="legend-label">Play Area</span></div>
    <div class="legend-item"><span class="legend-icon">🎭</span><span class="legend-label">Auditorium</span></div>
    <div class="legend-item"><span class="legend-icon">🖼️</span><span class="legend-label">Gallery</span></div>
    <div class="legend-item"><span class="legend-icon">🚻</span><span class="legend-label">Restroom</span></div>
    <div class="legend-item"><span class="legend-icon">🛗</span><span class="legend-label">Lift</span></div>
    <div class="legend-item"><span class="legend-icon">♿</span><span class="legend-label">Accessible</span></div>
    <div class="legend-item"><span class="legend-icon">🅿️</span><span class="legend-label">Parking</span></div>
  </div>
</div>

<!-- MAP -->
<div class="map-section">
  <div class="map-wrap" id="map-wrap">
    <div class="map-wrap__badge">
      <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Interactive Museum Map</span>
    </div>
    <button class="map-fullscreen-btn" id="fs-btn" title="Toggle fullscreen" onclick="toggleFullscreen()">
      <svg id="fs-icon" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
    </button>
    <iframe
      id="map-iframe"
      class="map-iframe"
      src="https://www.smritivanearthquakemuseum.biz/Museum/museumApp.html"
      allowfullscreen
      loading="lazy"
      title="Smritivan Museum Interactive Map">
    </iframe>
  </div>
</div>

<!-- INFO CARDS -->
<section class="info-section reveal">
  <div class="info-inner">
    <div class="info-card">
      <div class="info-card__icon">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="info-card__label">Museum Timings</div>
      <div class="info-card__title">Earthquake Museum</div>
      <div class="info-card__text">Open Tuesday – Sunday<br>9:00 AM – 7:00 PM<br><span class="info-card__closed">Monday Closed</span></div>
    </div>
    <div class="info-card">
      <div class="info-card__icon">
        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="info-card__label">Memorial Timings</div>
      <div class="info-card__title">Smritivan Memorial</div>
      <div class="info-card__text">Open Tuesday – Sunday<br>5:00 AM – 11:00 PM<br><span class="info-card__closed">Monday Closed</span></div>
    </div>
    <div class="info-card">
      <div class="info-card__icon">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div class="info-card__label">Getting Here</div>
      <div class="info-card__title">Bhujiyo Dungar, Bhuj</div>
      <div class="info-card__text">Located atop Bhujio Dungar, the iconic hilltop at Bhuj's entrance. Airport: 10 km · Railway: 15 km</div>
    </div>
  </div>
</section>

<!-- CTA STRIP -->
<div class="cta-strip reveal">
  <div class="cta-strip__left">
    <div class="cta-strip__tag">Plan Your Visit</div>
    <div class="cta-strip__title">Ready to Experience<br>Smritivan?</div>
  </div>
  <div class="cta-strip__btns">
    <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx" target="_blank" class="btn btn-gold">Book Tickets →</a>
    <a href="/Home/Faq" class="btn btn-outline">View FAQ</a>
  </div>
</div>
</main>

@section Scripts {
<script>
(function(){
  /* header scroll */
  var hdr=document.getElementById('hdr');
  window.addEventListener('scroll',function(){hdr.classList.toggle('scrolled',scrollY>40);},{passive:true});

  /* hamburger */
  var ham=document.getElementById('ham-btn'),mob=document.getElementById('mob-nav'),
      ov=document.getElementById('mob-ov'),cl=document.getElementById('mob-close');
  function openNav(){mob.classList.add('open');ov.classList.add('open');document.body.style.overflow='hidden';}
  function closeNav(){mob.classList.remove('open');ov.classList.remove('open');document.body.style.overflow='';}
  ham.addEventListener('click',openNav);ov.addEventListener('click',closeNav);cl.addEventListener('click',closeNav);
  mob.querySelectorAll('a').forEach(function(a){a.addEventListener('click',closeNav);});
  document.addEventListener('click',function(e){var dd=document.getElementById('nd-about');if(dd&&!dd.contains(e.target))dd.classList.remove('open');});

  /* reveal */
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:0.06});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});

  /* fullscreen toggle */
  var fsIcon = {
    expand:'<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>',
    compress:'<path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>'
  };
  var isFull=false;
  window.toggleFullscreen=function(){
    isFull=!isFull;
    document.body.classList.toggle('map-fs',isFull);
    document.getElementById('fs-icon').innerHTML=isFull?fsIcon.compress:fsIcon.expand;
    if(isFull) document.body.style.overflow='hidden';
    else document.body.style.overflow='';
  };
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&isFull) window.toggleFullscreen();
  });

  /* legend hover tooltip effect */
  document.querySelectorAll('.legend-item').forEach(function(item){
    item.addEventListener('mouseenter',function(){
      this.style.transition='background 0.2s';
    });
  });
})();
</script>
}