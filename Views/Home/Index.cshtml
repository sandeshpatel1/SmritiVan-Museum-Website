@{
    ViewData["Title"] = "SmritiVan — Earthquake Memorial & Museum";

    ViewData["ActivePage"] = "Home";
}

@section Styles {
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { font-family: 'DM Sans', sans-serif; background: #000; color: #e4ddd0; overflow-x: hidden; line-height: 1.6; }
        img { display: block; max-width: 100%; }
        a { text-decoration: none; color: inherit; }
        button { cursor: pointer; font-family: inherit; border: none; background: none; }

        :root {
          --gold: #c9a96e;
          --gold-lt: #e8d5a3;
          --gold-dk: #9a7a47;
          --white: #f2ece2;
          --dim: rgba(242,236,226,0.5);
          --faint: rgba(242,236,226,0.06);
          --border: rgba(201,169,110,0.16);
          --t: 0.4s cubic-bezier(0.4,0,0.2,1);
        }

        /* ══ HEADER ══ */
        .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
        .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
        .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
        .hdr__logo { display:flex;align-items:center;gap:12px; }
        .hdr__logo img { width:38px;height:38px;object-fit:contain; }
        .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
        .hdr__nav { display:flex;align-items:center; }
        .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
        .hdr__link:hover { color:var(--white); }
        .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
        .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
        .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
        .hdr__drop { position:relative; }
        .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
        .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
        .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
        .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
        .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
        .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
        .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
        .mob-ov.open { opacity:1;pointer-events:all; }
        .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
        .mob-nav.open { transform:translateX(0); }
        .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
        .mob-nav__close { font-size:24px;color:var(--dim); }
        .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
        .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
        .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
        .mob-nav__links a.active { color:var(--white); }
        .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
        .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
        .mob-nav__foot a:hover { color:var(--gold); }

        /* ══ HERO ══ */
        .hero { position:relative;height:100vh;min-height:700px;display:grid;grid-template-columns:55fr 45fr;overflow:hidden; }
        .hero__bg { position:absolute;inset:0;z-index:0; }
        .hero__slide { position:absolute;inset:0;opacity:0;transition:opacity 2s ease; }
        .hero__slide.active { opacity:1; }
        .hero__slide img { width:100%;height:100%;object-fit:cover;object-position:center; }
        .hero__ov {
          position:absolute;inset:0;z-index:1;
          background: linear-gradient(105deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.42) 50%, rgba(0,0,0,0.15) 100%),
                      linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 40%);
        }
        .hero__accent { position:absolute;top:0;left:0;bottom:0;width:3px;background:linear-gradient(to bottom,transparent 0%,var(--gold) 30%,var(--gold) 70%,transparent 100%);z-index:3; }
        .hero__content { position:relative;z-index:2;display:flex;flex-direction:column;justify-content:flex-end;padding:0 64px 88px 80px;grid-column:1; }
        .hero__kicker { display:flex;align-items:center;gap:14px;font-size:10px;font-weight:500;letter-spacing:5px;text-transform:uppercase;color:var(--gold);margin-bottom:20px;opacity:0;animation:aUp 1s 0.3s forwards; }
        .hero__kicker::before { content:'';display:block;width:36px;height:1px;background:var(--gold); }
        .hero__title { font-family:'Cormorant',serif;line-height:1;margin-bottom:32px;opacity:0;animation:aUp 1.1s 0.5s forwards; }
        .hero__title-welcome { display:block;font-size:clamp(16px,1.8vw,24px);font-weight:300;color:var(--dim);letter-spacing:8px;text-transform:uppercase;margin-bottom:10px; }
        .hero__title-smritivan {
          display:block;font-size:clamp(86px,12vw,160px);font-weight:700;line-height:0.87;letter-spacing:-4px;
          background:linear-gradient(145deg, #fff 0%, var(--gold-lt) 35%, var(--gold) 65%, var(--gold-dk) 100%);
          -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
          filter: drop-shadow(0 4px 32px rgba(0,0,0,0.7));
        }
        .hero__desc { font-size:14px;font-weight:300;color:rgba(242,236,226,0.75);line-height:1.85;max-width:480px;overflow:hidden;max-height:64px;transition:max-height 0.6s ease;opacity:0;animation:aUp 1s 0.75s forwards;text-shadow:0 1px 8px rgba(0,0,0,0.8); }
        .hero__desc.expanded { max-height:400px; }
        .hero__more { display:inline-flex;align-items:center;gap:6px;margin-top:10px;color:var(--gold);font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;opacity:0;animation:aUp 1s 0.9s forwards;transition:color 0.2s; }
        .hero__more:hover { color:var(--gold-lt); }
        .hero__actions { display:flex;gap:14px;margin-top:36px;flex-wrap:wrap;opacity:0;animation:aUp 1s 1s forwards; }
        .btn { display:inline-flex;align-items:center;gap:10px;padding:14px 36px;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;transition:var(--t);cursor:pointer;white-space:nowrap; }
        .btn-gold { background:var(--gold);color:#000;border:1px solid var(--gold); }
        .btn-gold:hover { background:var(--gold-lt);border-color:var(--gold-lt);transform:translateY(-2px);box-shadow:0 14px 36px rgba(201,169,110,0.3); }
        .btn-ghost { background:transparent;color:var(--white);border:1px solid rgba(255,255,255,0.25); }
        .btn-ghost:hover { border-color:var(--white);background:rgba(255,255,255,0.06);transform:translateY(-2px); }
        .hero__stats { position:relative;z-index:2;grid-column:2;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-end;padding:0 80px 88px 40px;opacity:0;animation:aRight 1s 1.1s forwards; }
        .hero__stat { text-align:right;padding:24px 0;border-bottom:1px solid var(--border);width:100%;max-width:260px; }
        .hero__stat:last-child { border-bottom:none; }
        .hero__stat-num { font-family:'Cormorant',serif;font-size:52px;font-weight:700;color:var(--white);line-height:1;letter-spacing:-1px; }
        .hero__stat-num span { color:var(--gold); }
        .hero__stat-lbl { font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px; }
        .hero__dots { position:absolute;bottom:36px;left:50%;transform:translateX(-50%);z-index:3;display:flex;gap:8px;opacity:0;animation:aUp 1s 1.4s forwards; }
        .hero__dot { width:30px;height:2px;background:rgba(255,255,255,0.18);cursor:pointer;transition:background 0.3s,width 0.3s; }
        .hero__dot.on { background:var(--gold);width:52px; }
        .hero__scroll { position:absolute;bottom:32px;right:80px;z-index:3;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:aUp 1s 1.6s forwards; }
        .hero__scroll-txt { font-size:9px;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,0.22);writing-mode:vertical-rl; }
        .hero__scroll-line { width:1px;height:56px;background:linear-gradient(to bottom,rgba(201,169,110,0.5),transparent);animation:scrl 2.2s ease-in-out infinite; }
        @@keyframes scrl { 0%,100%{transform:scaleY(1);opacity:1}50%{transform:scaleY(0.3);opacity:0.2} }
        @@keyframes aUp { from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)} }
        @@keyframes aRight { from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:translateX(0)} }

        /* ══ VISITOR COUNTER BADGE ══ */
        .visitor-badge {
          position: fixed;
          bottom: 28px;
          right: 28px;
          z-index: 800;
          display: flex;
          align-items: center;
          gap: 10px;
          background: rgba(5, 5, 5, 0.88);
          border: 1px solid var(--border);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          padding: 10px 14px 10px 12px;
          opacity: 0;
          transform: translateY(12px);
          transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.3s;
          pointer-events: all;
        }
        .visitor-badge.visible { opacity: 1; transform: translateY(0); }
        .visitor-badge:hover { border-color: rgba(201,169,110,0.36); }
        .visitor-badge__dot {
          width: 6px; height: 6px; border-radius: 50%;
          background: var(--gold);
          flex-shrink: 0;
          animation: vbPulse 2.4s ease-in-out infinite;
        }
        @@keyframes vbPulse {
          0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(201,169,110,0.4); }
          50%      { opacity: 0.7; box-shadow: 0 0 0 5px rgba(201,169,110,0); }
        }
        .visitor-badge__body { display: flex; flex-direction: column; line-height: 1; gap: 3px; }
        .visitor-badge__label { font-size: 8px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); font-weight: 600; }
        .visitor-badge__count { font-family: 'Cormorant', serif; font-size: 20px; font-weight: 700; color: var(--white); letter-spacing: -0.5px; line-height: 1; }
        .visitor-badge__dismiss {
          width: 18px; height: 18px;
          display: flex; align-items: center; justify-content: center;
          color: rgba(242,236,226,0.2);
          font-size: 13px; line-height: 1;
          flex-shrink: 0;
          margin-left: 2px;
          transition: color 0.2s;
          cursor: pointer;
        }
        .visitor-badge__dismiss:hover { color: rgba(242,236,226,0.7); }

        /* ══ UTILS ══ */
        .tag { display:inline-flex;align-items:center;gap:10px;font-size:10px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:18px; }
        .tag::before { content:'';display:block;width:28px;height:1px;background:var(--gold); }
        .sec-title { font-family:'Cormorant',serif;font-size:clamp(34px,5vw,60px);font-weight:700;color:var(--white);line-height:1.0;letter-spacing:-0.5px; }
        .gold-line { width:48px;height:1px;background:var(--gold);margin:20px 0 32px; }
        .reveal { opacity:0;transform:translateY(40px);transition:opacity 0.9s ease,transform 0.9s ease; }
        .reveal.in { opacity:1;transform:translateY(0); }
        .reveal-l { opacity:0;transform:translateX(-40px);transition:opacity 0.9s ease,transform 0.9s ease; }
        .reveal-l.in { opacity:1;transform:translateX(0); }
        .reveal-r { opacity:0;transform:translateX(40px);transition:opacity 0.9s ease,transform 0.9s ease; }
        .reveal-r.in { opacity:1;transform:translateX(0); }

        /* ══ SECTIONS ══ */
        .sec { padding:120px 80px; }
        .sec--alt { background:#040404; }
        .sec--deep { background:#020202; }
        .sec__inner { max-width:1200px;margin:0 auto; }

        /* ══ PM SECTION ══ */
        .pm { padding:120px 80px;background:#000;position:relative;overflow:hidden; }
        .pm::after { content:'';position:absolute;top:0;right:0;width:40%;height:100%;background:radial-gradient(ellipse at right,rgba(201,169,110,0.04) 0%,transparent 70%);pointer-events:none; }
        .pm__inner { max-width:1200px;margin:0 auto;display:grid;grid-template-columns:5fr 6fr;gap:80px;align-items:center; }
        .pm__frame { position:relative; }
        .pm__frame::before { content:'';position:absolute;top:-18px;left:-18px;right:18px;bottom:18px;border:1px solid var(--border);z-index:1;pointer-events:none; }
        .pm__frame::after { content:'';position:absolute;top:18px;left:18px;right:-18px;bottom:-18px;background:rgba(201,169,110,0.06);z-index:0; }
        .pm__img { position:relative;z-index:2;overflow:hidden;background:#111;min-height:520px;display:flex;align-items:center;justify-content:center; }
        .pm__img img { width:100%;height:580px;object-fit:cover;object-position:top;display:block; }
        .pm__quote { font-family:'Cormorant',serif;font-size:clamp(18px,2vw,23px);font-weight:400;font-style:italic;color:rgba(242,236,226,0.65);line-height:1.8;border-left:2px solid var(--gold);padding-left:24px;margin-bottom:40px; }
        .aud-wrap { background:#060606;border:1px solid var(--border);padding:22px 24px;display:flex;align-items:center;gap:18px; }
        .aud-play { width:50px;height:50px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;color:#000;flex-shrink:0;transition:background var(--t),transform 0.2s; }
        .aud-play:hover { background:var(--gold-lt);transform:scale(1.08); }
        .aud-info { flex:1; }
        .aud-label { font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:500; }
        .aud-bar { width:100%;-webkit-appearance:none;height:2px;background:rgba(255,255,255,0.08);outline:none;cursor:pointer; }
        .aud-bar::-webkit-slider-thumb { -webkit-appearance:none;width:12px;height:12px;border-radius:50%;background:var(--gold);cursor:pointer;transition:transform 0.2s; }
        .aud-bar::-webkit-slider-thumb:hover { transform:scale(1.4); }
        .aud-time { font-size:11px;color:var(--dim);flex-shrink:0;min-width:96px;text-align:right;font-variant-numeric:tabular-nums; }

        /* ══ FEATURE GRID ══ */
        .feat-grid { display:grid;grid-template-columns:1fr 1fr;gap:2px;margin-top:56px; }
        .feat-cell { position:relative;overflow:hidden;cursor:pointer;aspect-ratio:4/3; }
        .feat-cell--wide { grid-column:span 2;aspect-ratio:21/7; }
        .feat-cell img { width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.8s ease,filter 0.5s;filter:grayscale(20%) brightness(0.75); }
        .feat-cell:hover img { transform:scale(1.06);filter:grayscale(0%) brightness(1); }
        .feat-ov { position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.88) 0%,rgba(0,0,0,0.04) 55%);display:flex;flex-direction:column;justify-content:flex-end;padding:32px 28px;transition:background 0.4s; }
        .feat-cell:hover .feat-ov { background:linear-gradient(to top,rgba(0,0,0,0.7) 0%,transparent 50%); }
        .feat-num { font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:8px; }
        .feat-ttl { font-family:'Cormorant',serif;font-size:28px;font-weight:700;color:var(--white);line-height:1.1; }
        .feat-cell--wide .feat-ttl { font-size:42px; }
        .feat-sub { font-size:13px;color:var(--dim);margin-top:6px;font-weight:300; }

        /* ══ CAROUSEL ══ */
        .cw { overflow:hidden;position:relative; }
        .ct { display:flex;transition:transform 0.65s cubic-bezier(0.4,0,0.2,1); }
        .cs { flex:0 0 100%;min-width:0; }
        .c-dots { display:flex;justify-content:center;gap:8px;margin-top:28px; }
        .c-dot { width:28px;height:2px;background:rgba(255,255,255,0.1);border:none;cursor:pointer;padding:0;transition:background 0.3s,width 0.3s; }
        .c-dot.on { background:var(--gold);width:44px; }
        .c-arrows { display:flex;gap:10px; }
        .c-arrow { width:46px;height:46px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);background:transparent;transition:var(--t); }
        .c-arrow:hover { background:var(--gold);color:#000;border-color:var(--gold); }
        .c-arrow svg { width:15px;height:15px; }
        .ig-card { background:#060606; }
        .ig-card__img { overflow:hidden; }
        .ig-card__img img { width:100%;height:500px;object-fit:cover;display:block;transition:transform 0.7s,filter 0.5s;filter:grayscale(8%); }
        .ig-card:hover .ig-card__img img { transform:scale(1.04);filter:grayscale(0%); }
        .ig-card__cap { padding:28px 32px;font-size:14px;line-height:1.8;color:var(--dim);font-weight:300;border-top:1px solid var(--border); }

        /* ══ 360° VIRTUAL TOUR SECTION ══ */
        .t360 { padding:120px 0 0;background:#000;position:relative;overflow:hidden; }
        .t360::before {
          content:'360';
          position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
          font-family:'Cormorant',serif;font-size:600px;font-weight:700;
          color:rgba(201,169,110,0.018);line-height:1;pointer-events:none;
          letter-spacing:-20px;white-space:nowrap;
        }
        .t360__inner { max-width:1280px;margin:0 auto;padding:0 80px; }
        .t360__head { display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:32px;margin-bottom:52px; }
        .t360__desc { max-width:380px;font-size:14px;font-weight:300;color:var(--dim);line-height:1.85; }
        .t360__scenes { display:grid;grid-template-columns:repeat(4,1fr);gap:3px; }
        .t-scene { position:relative;overflow:hidden;cursor:pointer;aspect-ratio:2/3;background:#0a0a0a;transition:transform 0.4s ease,box-shadow 0.4s; }
        .t-scene:hover { transform:translateY(-10px);box-shadow:0 30px 70px rgba(0,0,0,0.9);z-index:2; }
        .t-scene img { width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.7s,filter 0.6s;filter:grayscale(55%) brightness(0.5) contrast(1.1); }
        .t-scene:hover img { transform:scale(1.08);filter:grayscale(0%) brightness(0.85); }
        .t-scene__ov { position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.96) 0%,rgba(0,0,0,0.5) 40%,rgba(0,0,0,0.1) 70%,transparent 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:28px 22px;transition:background 0.5s; }
        .t-scene:hover .t-scene__ov { background:linear-gradient(to top,rgba(0,0,0,0.92) 0%,rgba(0,0,0,0.3) 45%,rgba(0,0,0,0.05) 70%,transparent 100%); }
        .t-scene__num { font-size:9px;letter-spacing:3.5px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:600; }
        .t-scene__lbl { font-family:'Cormorant',serif;font-size:20px;font-weight:600;color:var(--white);line-height:1.1;margin-bottom:4px; }
        .t-scene__sub { font-size:12px;color:var(--dim);font-weight:300;line-height:1.5;max-height:0;overflow:hidden;transition:max-height 0.4s ease,opacity 0.4s;opacity:0; }
        .t-scene:hover .t-scene__sub { max-height:60px;opacity:1; }
        .t-scene__play { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s; }
        .t-scene:hover .t-scene__play { opacity:1; }
        .t-scene__play-ring { width:72px;height:72px;border-radius:50%;border:1.5px solid rgba(201,169,110,0.7);background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);transition:background 0.2s,transform 0.2s,border-color 0.2s; }
        .t-scene:hover .t-scene__play-ring { background:rgba(201,169,110,0.2);transform:scale(1.08); }
        .t-scene__play-ring svg { color:var(--gold);width:24px;height:24px;margin-left:4px; }
        .t-scene__badge { position:absolute;top:14px;left:14px;z-index:2;background:rgba(0,0,0,0.7);border:1px solid rgba(201,169,110,0.3);padding:4px 10px;display:flex;align-items:center;gap:7px;pointer-events:none; }
        .t-scene__badge-ring { width:16px;height:16px;border-radius:50%;border:1.5px solid var(--gold);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
        .t-scene__badge-ring span { font-size:4px;color:var(--gold);font-weight:700;letter-spacing:-0.2px; }
        .t-scene__badge-lbl { font-size:8px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold); }
        .t360__info-band { background:#070707;border:1px solid var(--border);padding:28px 48px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-top:3px; }
        .t360__info-band-title { font-family:'Cormorant',serif;font-size:20px;font-weight:600;color:var(--white);margin-bottom:2px; }
        .t360__info-band-meta { font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim); }
        .t360__hint { font-size:12px;color:rgba(255,255,255,0.25);display:flex;align-items:center;gap:8px; }
        .t360__hint svg { opacity:0.5; }

        /* ══ 360° PANORAMA MODAL ══ */
        .pano-modal { position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.97);display:flex;flex-direction:column;opacity:0;pointer-events:none;transition:opacity 0.4s ease; }
        .pano-modal.open { opacity:1;pointer-events:all; }
        .pano-modal__hdr { position:absolute;top:0;left:0;right:0;z-index:10;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(to bottom,rgba(0,0,0,0.9) 0%,transparent 100%); }
        .pano-modal__title { font-family:'Cormorant',serif;font-size:20px;font-weight:600;color:var(--white);display:flex;align-items:center;gap:14px; }
        .pano-modal__title-tag { font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-family:'DM Sans',sans-serif;font-weight:500; }
        .pano-close { width:44px;height:44px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);background:rgba(0,0,0,0.5);transition:border-color 0.2s,color 0.2s,background 0.2s;cursor:pointer;font-size:20px; }
        .pano-close:hover { border-color:var(--gold);color:var(--white);background:rgba(201,169,110,0.1); }
        .pano-canvas-wrap { flex:1;position:relative;overflow:hidden; }
        #pano-canvas { width:100%;height:100%;display:block;cursor:grab; }
        #pano-canvas:active { cursor:grabbing; }
        .pano-loading { position:absolute;inset:0;z-index:5;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity 0.5s; }
        .pano-loading.done { opacity:0;pointer-events:none; }
        .pano-spinner { width:36px;height:36px;border:2px solid rgba(201,169,110,0.15);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite; }
        .pano-loading-txt { font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--dim); }
        @@keyframes spin { to{transform:rotate(360deg)} }
        .pano-hint { position:absolute;top:72px;left:50%;transform:translateX(-50%);z-index:10;background:rgba(0,0,0,0.6);border:1px solid var(--border);padding:9px 22px;font-size:11px;letter-spacing:1.5px;color:var(--dim);text-transform:uppercase;border-radius:2px;backdrop-filter:blur(4px);pointer-events:none;white-space:nowrap;animation:hintFade 4s 0.8s forwards; }
        @@keyframes hintFade { 0%,80%{opacity:1}100%{opacity:0} }
        .pano-scenes { position:absolute;bottom:0;left:0;right:0;z-index:10;padding:16px 28px;background:linear-gradient(to top,rgba(0,0,0,0.94) 0%,transparent 100%);display:flex;align-items:center;gap:10px; }
        .pano-thumb { width:88px;height:52px;overflow:hidden;cursor:pointer;flex-shrink:0;border:2px solid transparent;transition:border-color 0.2s,transform 0.2s;background:#111; }
        .pano-thumb.sel { border-color:var(--gold); }
        .pano-thumb:hover { transform:translateY(-3px); }
        .pano-thumb img { width:100%;height:100%;object-fit:cover;display:block;filter:brightness(0.65); }
        .pano-thumb.sel img { filter:brightness(1); }
        .pano-scene-label { flex:1;padding-left:18px;border-left:1px solid var(--border); }
        .pano-scene-label__num { font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:2px; }
        .pano-scene-label__name { font-family:'Cormorant',serif;font-size:18px;color:var(--white); }
        .pano-zoom { position:absolute;right:28px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:10; }
        .pano-zoom-btn { width:38px;height:38px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);background:rgba(0,0,0,0.7);transition:var(--t);font-size:18px;line-height:1; }
        .pano-zoom-btn:hover { border-color:var(--gold);color:var(--gold); }

        /* ══ EVENTS ══ */
        .ev-tabs { display:flex;border-bottom:1px solid var(--border);margin-bottom:48px; }
        .ev-tab { padding:12px 32px;font-size:11px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim);border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color 0.2s,border-color 0.2s; }
        .ev-tab.on { color:var(--gold);border-bottom-color:var(--gold); }
        .ev-panel { display:none; }
        .ev-panel.on { display:block; }
        .ev-card { background:#060606;border:1px solid var(--border);display:flex;flex-direction:column;transition:border-color 0.3s,transform 0.3s; }
        .ev-card:hover { border-color:var(--gold);transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,0.6); }
        .ev-card__imgw { overflow:hidden; }
        .ev-card__img { width:100%;height:280px;object-fit:cover;display:block;transition:transform 0.6s;filter:grayscale(15%); }
        .ev-card:hover .ev-card__img { transform:scale(1.04);filter:grayscale(0%); }
        .ev-card__body { padding:28px;flex:1; }
        .ev-card__date { font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block; }
        .ev-card__title { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);margin-bottom:8px;line-height:1.2; }
        .ev-card__sub { font-size:13px;color:var(--dim);line-height:1.65;font-weight:300; }
        .ev-empty { text-align:center;padding:80px 20px; }
        .ev-empty p { font-family:'Cormorant',serif;font-size:26px;color:rgba(255,255,255,0.15); }

        /* ══ GUJARAT ══ */
        .guj-card { position:relative;overflow:hidden;cursor:pointer;border:1px solid var(--border);transition:border-color 0.3s; }
        .guj-card:hover { border-color:var(--gold); }
        .guj-card img { width:100%;height:500px;object-fit:cover;display:block;transition:transform 0.65s,filter 0.5s;filter:grayscale(15%); }
        .guj-card:hover img { transform:scale(1.04);filter:grayscale(0%); }
        .guj-card__ov { position:absolute;bottom:0;left:0;right:0;padding:48px 32px 32px;background:linear-gradient(to top,rgba(0,0,0,0.92) 0%,transparent); }
        .guj-lbl { font-size:9px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:6px;display:block; }
        .guj-name { font-family:'Cormorant',serif;font-size:30px;font-weight:700;color:var(--white);line-height:1.05; }
        .guj-area { font-size:12px;color:var(--dim);margin:4px 0 20px;display:block;font-weight:300; }
        .guj-btn { display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border:1px solid rgba(255,255,255,0.25);font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--white);transition:background 0.2s,border-color 0.2s; }
        .guj-btn:hover { background:var(--gold);border-color:var(--gold);color:#000; }

        /* ══ TIMINGS ══ */
        .timings { background:#070707;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:56px 80px; }
        .timings__inner { max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr; }
        .timings__l { padding-right:60px;border-right:1px solid var(--border); }
        .timings__r { padding-left:60px;display:flex;flex-direction:column;justify-content:center; }
        .t-lbl { font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:28px;font-weight:600; }
        .t-item { margin-bottom:20px; }
        .t-item__n { font-family:'Cormorant',serif;font-size:20px;color:var(--white); }
        .t-item__h { font-size:13px;color:var(--dim);font-weight:300; }
        .t-closed { display:inline-block;margin-top:10px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#e05555;border:1px solid rgba(224,85,85,0.3);padding:4px 14px; }
        .t-head { font-family:'Cormorant',serif;font-size:26px;color:var(--white);margin-bottom:12px;line-height:1.2; }
        .t-body { font-size:14px;color:var(--dim);line-height:1.75;margin-bottom:28px;font-weight:300; }

        /* ══ TESTIMONIALS ══ */
        .testi { padding:120px 80px;background:#020202;position:relative;overflow:hidden; }
        .testi::before { content:'\201C';position:absolute;top:-80px;left:20px;font-family:'Cormorant',serif;font-size:600px;color:rgba(201,169,110,0.022);line-height:1;pointer-events:none; }
        .testi__inner { max-width:780px;margin:0 auto; }
        .t-card { background:#060606;border:1px solid var(--border);padding:60px 52px 48px;text-align:center; }
        .t-card__icon { font-family:'Cormorant',serif;font-size:60px;color:var(--gold);line-height:1;margin-bottom:28px;opacity:0.5; }
        .t-card__q { font-family:'Cormorant',serif;font-size:20px;line-height:1.8;color:rgba(242,236,226,0.72);font-style:italic;margin-bottom:36px;font-weight:400; }
        .t-card__div { width:40px;height:1px;background:var(--gold);margin:0 auto 24px; }
        .t-card__au { font-size:15px;font-weight:600;color:var(--white);margin-bottom:4px;letter-spacing:0.5px; }
        .t-card__co { font-size:10px;font-weight:500;color:var(--gold);letter-spacing:3px;text-transform:uppercase; }

        /* ══ FOOTER ══ */
        .ftr { background:#000;border-top:1px solid var(--border);padding:80px 80px 40px; }
        .ftr__inner { max-width:1200px;margin:0 auto; }
        .ftr__top { display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:56px;padding-bottom:60px;border-bottom:1px solid var(--border);margin-bottom:32px; }
        .ftr__brand { display:flex;flex-direction:column;gap:16px; }
        .ftr__logo { display:flex;align-items:center;gap:12px; }
        .ftr__logo img { width:34px; }
        .ftr__logo strong { font-family:'Cormorant',serif;font-size:18px;color:var(--white);font-weight:600;letter-spacing:1px; }
        .ftr__brand p { font-size:13px;color:rgba(255,255,255,0.28);line-height:1.7;font-weight:300; }
        .ftr__partners { display:flex;gap:18px;flex-wrap:wrap;margin-top:8px; }
        .ftr__partners a:hover { opacity:0.6; }
        .ftr__col h4 { font-size:9px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:20px; }
        .ftr__col a { display:block;font-size:13px;color:rgba(255,255,255,0.3);padding:6px 0;transition:color 0.2s,padding-left 0.2s; }
        .ftr__col a:hover { color:var(--white);padding-left:8px; }
        .ftr__bot { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:11px;color:rgba(255,255,255,0.18);letter-spacing:0.5px; }
        .ftr__bot a { color:rgba(255,255,255,0.22);transition:color 0.2s; }
        .ftr__bot a:hover { color:var(--white); }
        .ftr__atm { color:var(--gold) !important;font-weight:500; }
        .ftr__atm:hover { color:var(--gold-lt) !important; }
        .sp-wrap { display:flex;align-items:center;justify-content:center;min-height:300px; }
        .sp { width:30px;height:30px;border:1.5px solid rgba(201,169,110,0.1);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite; }

        /* ══ RESPONSIVE ══ */
        @@media(max-width:1100px){
          .hero{grid-template-columns:1fr}
          .hero__stats{display:none}
          .pm__inner{grid-template-columns:1fr;gap:60px}
          .ftr__top{grid-template-columns:1fr 1fr}
          .timings__inner{grid-template-columns:1fr}
          .timings__l{border-right:none;padding-right:0;border-bottom:1px solid var(--border);padding-bottom:40px;margin-bottom:40px}
          .timings__r{padding-left:0}
        }
        @@media(max-width:768px){
          .hdr__nav{display:none}
          .ham{display:flex}
          .hero__content{padding:60px 24px}
          .hero__title-smritivan{font-size:clamp(72px,18vw,100px);letter-spacing:-3px}
          .sec,.pm,.testi,.timings,.ftr{padding-left:24px;padding-right:24px}
          .sec{padding:80px 24px}
          .pm{padding:80px 24px}
          .testi{padding:80px 24px}
          .timings{padding:56px 24px}
          .t360__inner{padding:0 24px}
          .feat-grid{grid-template-columns:1fr}
          .feat-cell--wide{aspect-ratio:16/9;grid-column:1}
          .t360__scenes{grid-template-columns:1fr 1fr}
          .ftr{padding:60px 24px 32px}
          .ftr__top{grid-template-columns:1fr;gap:36px}
          .ftr__bot{flex-direction:column;align-items:flex-start}
          .hero__dots{display:none}
          .t360__info-band{padding:24px}
          .pano-scenes{flex-wrap:wrap}
          .pano-thumb{width:60px;height:38px}
          .visitor-badge { bottom:16px; right:16px; }
        }
        @@media(max-width:480px){
          .hero__title-smritivan{font-size:68px;letter-spacing:-2px}
          .t-card{padding:40px 24px 32px}
          .aud-time{display:none}
          .btn{padding:13px 28px;font-size:11px}
        }
    </style>
}


<!-- ══ VISITOR COUNTER BADGE ══ -->
@* <div class="visitor-badge" id="visitor-badge" role="status" aria-live="polite">
    <div class="visitor-badge__dot"></div>
    <div class="visitor-badge__body">
        <span class="visitor-badge__label">Total Visitors</span>
        <span class="visitor-badge__count" id="visitor-count">@ViewBag.VisitorCount</span>
    </div>
    <button class="visitor-badge__dismiss" id="visitor-dismiss" aria-label="Dismiss visitor counter" title="Dismiss">&#10005;</button>
</div> *@


<!-- ══ 360° PANORAMA MODAL ══ -->
<div class="pano-modal" id="pano-modal" role="dialog" aria-label="360° Virtual Tour">
    <div class="pano-modal__hdr">
        <div class="pano-modal__title">
            <span class="pano-modal__title-tag">360° Virtual Tour</span>
            <span id="pano-modal-scene-name">Main Entrance</span>
        </div>
        <button class="pano-close" id="pano-close" aria-label="Close">&#10005;</button>
    </div>
    <div class="pano-hint" id="pano-hint">🖱&nbsp;Click &amp; drag to look around &nbsp;·&nbsp; Scroll to zoom</div>
    <div class="pano-canvas-wrap">
        <canvas id="pano-canvas"></canvas>
        <div class="pano-loading" id="pano-loading">
            <div class="pano-spinner"></div>
            <div class="pano-loading-txt">Loading 360° Scene…</div>
        </div>
    </div>
    <div class="pano-zoom">
        <button class="pano-zoom-btn" id="pz-in">+</button>
        <button class="pano-zoom-btn" id="pz-out">−</button>
    </div>
    <div class="pano-scenes" id="pano-scenes-strip">
        <div class="pano-thumb sel" data-idx="0"><img src="@Url.Content("~/assets/360/A.jpg")" alt="Main Entrance" /></div>
        <div class="pano-thumb" data-idx="1"><img src="@Url.Content("~/assets/360/B.jpg")" alt="Upper Courtyard" /></div>
        <div class="pano-thumb" data-idx="2"><img src="@Url.Content("~/assets/360/C.jpg")" alt="Reception Hall" /></div>
        <div class="pano-thumb" data-idx="3"><img src="@Url.Content("~/assets/360/D.jpg")" alt="Simulation Theatre" /></div>
        <div class="pano-scene-label">
            <div class="pano-scene-label__num" id="pano-lbl-num">Scene 01</div>
            <div class="pano-scene-label__name" id="pano-lbl-name">Main Entrance</div>
        </div>
    </div>
</div>

<main>

    <!-- ══ 1. HERO ══ -->
    <section class="hero" id="hero">
        <div class="hero__bg">
            <div class="hero__slide active"><img src="@Url.Content("~/assets/bg-og.jpg")" alt="Smritivan" /></div>
            <div class="hero__slide"><img src="@Url.Content("~/assets/bg-1.jpg")" alt="Smritivan 2" /></div>
            <div class="hero__slide"><img src="@Url.Content("~/assets/bg-2.jpeg")" alt="Smritivan 3" /></div>
            <div class="hero__slide"><img src="@Url.Content("~/assets/bg-3.jpg")" alt="Smritivan 4" /></div>
            <div class="hero__slide"><img src="@Url.Content("~/assets/bg-4.jpg")" alt="Smritivan 5" /></div>
        </div>
        <div class="hero__ov"></div>
        <div class="hero__accent"></div>
        <div class="hero__content">
            <p class="hero__kicker">India's Largest Memorial Museum</p>
            <h1 class="hero__title">
                <span class="hero__title-welcome">Welcome to</span>
                <span class="hero__title-smritivan">Smritivan</span>
            </h1>
            <p class="hero__desc" id="hero-desc">The Honorable Prime Minister, Shri Narendra Modi, inaugurated Smritivan on August 28, 2022. This project extends homage to the almost 13,000 victims of the massive Gujarat earthquake of 2001. Located atop Bhujia Hill in Gujarat, the memorial spans an impressive 170 acres on the historically significant Bhujiyo Dungar.</p>
            <button class="hero__more" id="hero-tog">Read More ↓</button>
            <div class="hero__actions">
                <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx" target="_blank" class="btn btn-gold">Book Tickets</a>
                <a href="@Url.Action("Museum","Home")" class="btn btn-ghost">Explore Museum</a>
            </div>
        </div>
        <div class="hero__stats">
            <div class="hero__stat"><div class="hero__stat-num">13<span>,000</span></div><div class="hero__stat-lbl">Lives Remembered</div></div>
            <div class="hero__stat"><div class="hero__stat-num">170<span> ac</span></div><div class="hero__stat-lbl">Acres of Memorial Park</div></div>
            <div class="hero__stat"><div class="hero__stat-num">7</div><div class="hero__stat-lbl">Immersive Museum Zones</div></div>
            <div class="hero__stat"><div class="hero__stat-num">2001</div><div class="hero__stat-lbl">Year of the Earthquake</div></div>
        </div>
        <div class="hero__dots" id="hero-dots">
            <div class="hero__dot on" onclick="heroGoTo(0)"></div>
            <div class="hero__dot" onclick="heroGoTo(1)"></div>
            <div class="hero__dot" onclick="heroGoTo(2)"></div>
            <div class="hero__dot" onclick="heroGoTo(3)"></div>
            <div class="hero__dot" onclick="heroGoTo(4)"></div>
        </div>
        <div class="hero__scroll"><div class="hero__scroll-line"></div><span class="hero__scroll-txt">Scroll</span></div>
    </section>

    <!-- ══ 2. PM SECTION ══ -->
    <section class="pm">
        <div class="pm__inner">
            <div class="pm__frame reveal-l">
                <div class="pm__img" id="pm-img-wrap">
                    <img src="@Url.Content("~/assets/pm.png")" alt="PM Narendra Modi"
                         onerror="this.src='https://www.smritivanearthquakemuseum.biz/assets2/image.png'" />
                </div>
            </div>
            <div class="reveal-r">
                <span class="tag">Hon'ble Prime Minister's Message</span>
                <h2 class="sec-title">Hon'ble PM Modi's Speech on Smritivan</h2>
                <div class="gold-line"></div>
                <p class="pm__quote">"Smritivan is not just a memorial — it is a symbol of the indomitable spirit of Gujarat, a testament to how a society rises from devastation and transforms tragedy into triumph."</p>
                <div class="aud-wrap">
                    <button class="aud-play" id="aud-btn" aria-label="Play">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg>
                    </button>
                    <div class="aud-info">
                        <div class="aud-label">Hon'ble PM Modi — Official Speech</div>
                        <input type="range" class="aud-bar" id="aud-bar" min="0" max="100" value="0" step="0.1" />
                    </div>
                    <span class="aud-time" id="aud-time">00:00 / 00:00</span>
                </div>
                <audio id="pm-audio" src="@Url.Content("~/audio/audio.mp3")" preload="metadata"></audio>
            </div>
        </div>
    </section>

    <!-- ══ 3. FEATURE GRID ══ -->
    <section class="sec sec--alt">
        <div class="sec__inner">
            <div class="reveal" style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px">
                <div><span class="tag">The Experience</span><h2 class="sec-title">A Living<br>Memorial</h2></div>
                <p style="max-width:300px;font-size:14px;color:var(--dim);font-weight:300;line-height:1.85">Where nature, technology, and remembrance converge across 170 acres of history.</p>
            </div>
            <div class="feat-grid reveal">
                <div class="feat-cell">
                    <img src="https://www.smritivanearthquakemuseum.biz/assets2/DJI_0960-Enhanced-2%20.jpg" alt="Aerial" loading="lazy" />
                    <div class="feat-ov"><span class="feat-num">01 / 03</span><h3 class="feat-ttl">Aerial Grandeur</h3><p class="feat-sub">170 acres atop Bhujiyo Dungar</p></div>
                </div>
                <div class="feat-cell">
                    <img src="https://www.smritivanearthquakemuseum.biz/assets2/insta1.jpeg" alt="Museum" loading="lazy" />
                    <div class="feat-ov"><span class="feat-num">02 / 03</span><h3 class="feat-ttl">Museum Galleries</h3><p class="feat-sub">7 immersive thematic zones</p></div>
                </div>
                <div class="feat-cell feat-cell--wide">
                    <img src="https://www.smritivanearthquakemuseum.biz/assets2/Rectangle%2026.png" alt="360 Experience" loading="lazy" />
                    <div class="feat-ov"><span class="feat-num">03 / 03</span><h3 class="feat-ttl">World's Largest 360° Simulation</h3><p class="feat-sub">An earthquake you will never forget</p></div>
                </div>
            </div>
        </div>
