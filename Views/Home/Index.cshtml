@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        (function(){
          'use strict';

          /* ── CONFIG ── */
          var BASE = 'https://www.smritivanearthquakemuseum.biz/';
          var API  = 'https://www.smritivanearthquakemuseum.biz';

          /* ── Asset helper: resolves local paths via Razor at render time ── */
          var ASSET = {
            '360A': '@Url.Content("~/assets/360/A.jpg")',
            '360B': '@Url.Content("~/assets/360/B.jpg")',
            '360C': '@Url.Content("~/assets/360/C.jpg")',
            '360D': '@Url.Content("~/assets/360/D.jpg")'
          };

          /* ════════════════════════════════════════
             STATIC FALLBACK EVENT DATA
          ════════════════════════════════════════ */
          var FALLBACK_PAST = [
            { img:'https://images.unsplash.com/photo-1512389142860-9c449e58a543?w=800&q=80', title:'Christmas Party at Smritivan', date:'Dec 24, 2023', sub:'Join us for a spectacular Christmas bash with part of our proceeds going to charity.' },
            { img:'https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=800&q=80', title:'Kachh Sahitya Utsav', date:'Dec 9, 2023', sub:'A celebration of Kutchi literature and culture, starting at 8PM from Smritivan.' },
            { img:'https://images.unsplash.com/photo-1580893246395-52aead8960dc?w=800&q=80', title:'Smritivan Deep Utsav 2023', date:'Nov 8, 2023', sub:'This Dhanteras, join us in lighting 51,000 diyas at Smritivan — a spectacle of light and remembrance.' },
            { img:'https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&q=80', title:"Forest Walk — World's Largest Miyawaki Forest", date:'Jun 4, 2023', sub:'With Dr. R.K. Nair and Mission Life Program by Gujarat Pollution Control Board.' },
            { img:'https://images.unsplash.com/photo-1502082553048-f009c37129b9?w=800&q=80', title:'World Environment Day Celebrations', date:'Jun 2, 2023', sub:"A day of plantation, awareness walks, and community action at Smritivan's Miyawaki Forest." },
            { img:'https://images.unsplash.com/photo-1476611338391-6f395a0ebc7b?w=800&q=80', title:'Shraddhanjali Walk', date:'Jan 26, 2023', sub:'A remembrance walk honouring the victims of the 2001 Kutch earthquake on Republic Day.' }
          ];
          var FALLBACK_UPCOMING = [
            { img:'https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&q=80', title:'Miyawaki Forest Morning Walk', date:'Apr 20, 2026', sub:"A guided morning walk through the verdant world's largest Miyawaki Forest with expert naturalists." },
            { img:'https://images.unsplash.com/photo-1508193638397-1c4234db14d8?w=800&q=80', title:'World Earth Day at Smritivan', date:'Apr 22, 2026', sub:'Plantation drives, nature talks, and activities for all ages celebrating our planet.' }
          ];

          /* ── VISITOR BADGE ── */
          (function(){
            var badge   = document.getElementById('visitor-badge');
            var dismiss = document.getElementById('visitor-dismiss');
            if(!badge) return;

            // Don't show if previously dismissed in this session
            if(sessionStorage.getItem('vbDismissed') === '1'){
              badge.style.display = 'none';
              return;
            }

            // Animate in after short delay
            setTimeout(function(){ badge.classList.add('visible'); }, 800);

            dismiss.addEventListener('click', function(e){
              e.stopPropagation();
              badge.classList.remove('visible');
              sessionStorage.setItem('vbDismissed', '1');
              setTimeout(function(){ badge.style.display = 'none'; }, 500);
            });
          })();

          /* ── HEADER SCROLL ── */
          var hdr = document.getElementById('hdr');
          window.addEventListener('scroll', function(){ hdr.classList.toggle('scrolled', window.scrollY > 50); }, { passive:true });

          /* ── HAMBURGER ── */
          var ham = document.getElementById('ham-btn'),
              mobNav = document.getElementById('mob-nav'),
              mobOv  = document.getElementById('mob-ov'),
              mobClose = document.getElementById('mob-close');
          function nOpen(){ mobNav.classList.add('open'); mobOv.classList.add('open'); document.body.style.overflow='hidden'; }
          function nClose(){ mobNav.classList.remove('open'); mobOv.classList.remove('open'); document.body.style.overflow=''; }
          ham.addEventListener('click', nOpen);
          mobOv.addEventListener('click', nClose);
          mobClose.addEventListener('click', nClose);
          mobNav.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', nClose); });

          /* ── HERO SLIDESHOW ── */
          var slides = document.querySelectorAll('.hero__slide'),
              dots   = document.querySelectorAll('.hero__dot'),
              cur = 0, tmr;
          window.heroGoTo = function(n){
            slides[cur].classList.remove('active'); dots[cur].classList.remove('on');
            cur = n;
            slides[cur].classList.add('active'); dots[cur].classList.add('on');
          };
          function heroNext(){ heroGoTo((cur + 1) % slides.length); }
          tmr = setInterval(heroNext, 5500);
          var heroEl = document.getElementById('hero');
          heroEl.addEventListener('mouseenter', function(){ clearInterval(tmr); });
          heroEl.addEventListener('mouseleave', function(){ tmr = setInterval(heroNext, 5500); });

          /* ── HERO "READ MORE" ── */
          var desc = document.getElementById('hero-desc'), tog = document.getElementById('hero-tog');
          tog.addEventListener('click', function(){
            var ex = desc.classList.toggle('expanded');
            tog.textContent = ex ? 'Read Less ↑' : 'Read More ↓';
          });

          /* ── SCROLL REVEAL ── */
          var io = new IntersectionObserver(function(entries){
            entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
          }, { threshold: 0.08 });
          document.querySelectorAll('.reveal,.reveal-l,.reveal-r').forEach(function(el){ io.observe(el); });

          /* ── CAROUSEL ENGINE ── */
          var cState = {};
          window.cGoTo = function(id, idx){
            if(!cState[id]) return;
            var tr = document.getElementById('ct-' + id), dt = document.getElementById('cd-' + id);
            if(!tr) return;
            cState[id].cur = idx;
            tr.style.transform = 'translateX(-' + (idx * 100) + '%)';
            if(dt) dt.querySelectorAll('.c-dot').forEach(function(b,i){ b.classList.toggle('on', i === idx); });
          };
          window.cNext = function(id){
            if(!cState[id]) return;
            var tr = document.getElementById('ct-' + id); if(!tr) return;
            cGoTo(id, (cState[id].cur + 1) % tr.children.length);
          };
          window.cPrev = function(id){
            if(!cState[id]) return;
            var tr = document.getElementById('ct-' + id); if(!tr) return;
            cGoTo(id, (cState[id].cur - 1 + tr.children.length) % tr.children.length);
          };
          function initC(id, auto, ms){
            cState[id] = { cur:0 };
            var w = document.getElementById('cw-' + id);
            if(w){
              var sx = 0;
              w.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, { passive:true });
              w.addEventListener('touchend', function(e){
                var d = sx - e.changedTouches[0].clientX;
                if(Math.abs(d) > 40){ d > 0 ? cNext(id) : cPrev(id); }
              }, { passive:true });
            }
            if(auto) setInterval(function(){ cNext(id); }, ms || 5500);
          }
          initC('ig', true, 5500);
          initC('guj', false);

          /* ════════════════════════════════════════
             360° PANORAMA MODAL — Three.js viewer
          ════════════════════════════════════════ */
          var SCENES = [
            { name:'Main Entrance',      src: ASSET['360A'] },
            { name:'Upper Courtyard',    src: ASSET['360B'] },
            { name:'Reception Hall',     src: ASSET['360C'] },
            { name:'Simulation Theatre', src: ASSET['360D'] }
          ];

          var panoModal   = document.getElementById('pano-modal'),
              panoClose   = document.getElementById('pano-close'),
              panoLoading = document.getElementById('pano-loading'),
              panoCanvas  = document.getElementById('pano-canvas'),
              panoLblNum  = document.getElementById('pano-lbl-num'),
              panoLblName = document.getElementById('pano-lbl-name');

          var panoScene, panoCamera, panoRenderer, panoSphere, panoMat, panoAnimFrame;
          var isDragging = false, prevX = 0, prevY = 0;
          var lon = 0, lat = 0, fov = 75, panoReady = false, autoLon = 0;

          function initThree(){
            if(panoRenderer) return;
            panoScene  = new THREE.Scene();
            panoCamera = new THREE.PerspectiveCamera(fov, panoCanvas.clientWidth / panoCanvas.clientHeight, 0.1, 1000);
            panoCamera.position.set(0, 0, 0.001);
            panoRenderer = new THREE.WebGLRenderer({ canvas: panoCanvas, antialias:true });
            panoRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            panoRenderer.setSize(panoCanvas.clientWidth, panoCanvas.clientHeight);

            var geo = new THREE.SphereGeometry(500, 72, 48);
            geo.scale(-1, 1, 1);
            panoMat    = new THREE.MeshBasicMaterial({ color:0x111111 });
            panoSphere = new THREE.Mesh(geo, panoMat);
            panoScene.add(panoSphere);

            /* Mouse drag */
            panoCanvas.addEventListener('mousedown', function(e){ isDragging=true; prevX=e.clientX; prevY=e.clientY; });
            window.addEventListener('mouseup',       function(){ isDragging=false; });
            window.addEventListener('mousemove',     function(e){
              if(!isDragging) return;
              lon -= (e.clientX - prevX) * 0.15;
              lat += (e.clientY - prevY) * 0.09;
              lat = Math.max(-85, Math.min(85, lat));
              prevX=e.clientX; prevY=e.clientY;
            });

            /* Touch drag */
            var tx=0, ty=0;
            panoCanvas.addEventListener('touchstart', function(e){ if(e.touches.length===1){ tx=e.touches[0].clientX; ty=e.touches[0].clientY; } }, { passive:true });
            panoCanvas.addEventListener('touchmove',  function(e){
              if(e.touches.length===1){
                lon -= (e.touches[0].clientX - tx) * 0.2;
                lat += (e.touches[0].clientY - ty) * 0.12;
                lat = Math.max(-85, Math.min(85, lat));
                tx=e.touches[0].clientX; ty=e.touches[0].clientY; e.preventDefault();
              }
            }, { passive:false });

            /* Scroll to zoom */
            panoCanvas.addEventListener('wheel', function(e){
              fov = Math.max(30, Math.min(100, fov + e.deltaY * 0.05));
              panoCamera.fov = fov; panoCamera.updateProjectionMatrix();
            }, { passive:true });

            /* Resize */
            window.addEventListener('resize', function(){
              if(!panoRenderer) return;
              panoCamera.aspect = panoCanvas.clientWidth / panoCanvas.clientHeight;
              panoCamera.updateProjectionMatrix();
              panoRenderer.setSize(panoCanvas.clientWidth, panoCanvas.clientHeight);
            });

            /* Zoom buttons */
            document.getElementById('pz-in').addEventListener('click',  function(){ fov=Math.max(30,fov-8);  panoCamera.fov=fov; panoCamera.updateProjectionMatrix(); });
            document.getElementById('pz-out').addEventListener('click', function(){ fov=Math.min(100,fov+8); panoCamera.fov=fov; panoCamera.updateProjectionMatrix(); });

            renderLoop();
          }

          function renderLoop(){
            panoAnimFrame = requestAnimationFrame(renderLoop);
            if(!panoReady) return;
            if(!isDragging) autoLon += 0.025;
            var useLon = isDragging ? lon : lon + autoLon;
            var phi   = THREE.MathUtils.degToRad(90 - lat);
            var theta = THREE.MathUtils.degToRad(useLon);
            panoCamera.lookAt(Math.sin(phi)*Math.cos(theta), Math.cos(phi), Math.sin(phi)*Math.sin(theta));
            panoRenderer.render(panoScene, panoCamera);
          }

          function loadScene(idx){
            panoReady=false; panoLoading.classList.remove('done');
            lat=0; lon=0; autoLon=0; fov=75;
            if(panoCamera){ panoCamera.fov=fov; panoCamera.updateProjectionMatrix(); }
            var s = SCENES[idx];
            var nameEl = document.getElementById('pano-modal-scene-name');
            if(nameEl) nameEl.textContent = s.name;
            panoLblNum.textContent  = 'Scene 0' + (idx + 1);
            panoLblName.textContent = s.name;
            document.querySelectorAll('.pano-thumb').forEach(function(t,i){ t.classList.toggle('sel', i===idx); });
            new THREE.TextureLoader().load(s.src,
              function(tex){
                tex.minFilter = THREE.LinearFilter;
                panoMat.map = tex; panoMat.color.set(0xffffff); panoMat.needsUpdate=true;
                panoReady=true; panoLoading.classList.add('done');
              },
              undefined,
              function(){ panoReady=true; panoLoading.classList.add('done'); }
            );
          }

          window.openPanoModal = function(idx){
            document.body.style.overflow='hidden';
            panoModal.classList.add('open');
            var hint = document.getElementById('pano-hint');
            hint.style.animation='none'; void hint.offsetWidth; hint.style.animation='';
            if(!panoRenderer){ setTimeout(function(){ initThree(); loadScene(idx); }, 60); }
            else { loadScene(idx); }
          };

          document.querySelectorAll('.pano-thumb').forEach(function(thumb){
            thumb.addEventListener('click', function(){ loadScene(parseInt(this.getAttribute('data-idx'))); });
          });

          panoClose.addEventListener('click', function(){
            panoModal.classList.remove('open'); document.body.style.overflow='';
            if(panoAnimFrame){ cancelAnimationFrame(panoAnimFrame); panoAnimFrame=null; }
            panoReady=false; panoRenderer=null; panoScene=null; panoCamera=null; panoSphere=null; panoMat=null;
          });
          document.addEventListener('keydown', function(e){
            if(e.key==='Escape' && panoModal.classList.contains('open')) panoClose.click();
          });

          /* ════════════════════════════════════════
             EVENTS — API-first with static fallback
          ════════════════════════════════════════ */
          window.evTab = function(tab){
            document.querySelectorAll('.ev-tab').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-panel')===tab); });
            document.querySelectorAll('.ev-panel').forEach(function(p){ p.classList.remove('on'); });
            var p = document.getElementById('evp-' + tab); if(p) p.classList.add('on');
          };

          function esc(s){ return s ? String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') : ''; }

          function buildEv(cid, carid, cards){
            var c = document.getElementById(cid); if(!c) return;
            if(!cards || !cards.length){ c.innerHTML='<div class="ev-empty"><p>No events at this time</p></div>'; return; }
            var h = '<div style="position:relative;">';
            if(cards.length > 1){
              h += '<div style="position:absolute;top:50%;left:-20px;right:-20px;transform:translateY(-60%);z-index:10;pointer-events:none;display:flex;justify-content:space-between;">';
              h += '<button class="c-arrow" onclick="cPrev(\'' + carid + '\')" style="pointer-events:all;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg></button>';
              h += '<button class="c-arrow" onclick="cNext(\'' + carid + '\')" style="pointer-events:all;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 6 15 12 9 18"/></svg></button>';
              h += '</div>';
            }
            h += '<div class="cw" id="cw-' + carid + '"><div class="ct" id="ct-' + carid + '">';
            cards.forEach(function(d){
              h += '<div class="cs"><div class="ev-card">';
              if(d.img) h += '<div class="ev-card__imgw"><img class="ev-card__img" src="' + esc(d.img) + '" alt="' + esc(d.title) + '" loading="lazy" onerror="this.style.display=\'none\'"/></div>';
              h += '<div class="ev-card__body">';
              if(d.date)  h += '<span class="ev-card__date">'  + esc(d.date)  + '</span>';
              h           += '<h3 class="ev-card__title">'     + esc(d.title) + '</h3>';
              if(d.sub)   h += '<p class="ev-card__sub">'      + esc(d.sub)   + '</p>';
              h += '</div></div></div>';
            });
            h += '</div></div>';
            if(cards.length > 1){
              h += '<div class="c-dots" id="cd-' + carid + '">';
              cards.forEach(function(_,i){ h += '<button class="c-dot' + (i===0?' on':'') + '" onclick="cGoTo(\'' + carid + '\',' + i + ')"></button>'; });
              h += '</div>';
            }
            h += '</div>';
            c.innerHTML = h;
            initC(carid, cards.length > 1, 6000);
          }

          function mapEv(e){
            return {
              img:   BASE + 'event/' + (e.Event_image || e.Event_Image || ''),
              title: e.Title        || e.Event_Title       || '',
              sub:   e.sub_title    || e.Event_Description || '',
              date:  e.event_date   || e.Event_Date        || ''
            };
          }

          fetch(API + '/GetSmritivanUpcomingEvents')
            .then(function(r){ return r.ok ? r.json() : []; })
            .then(function(d){ buildEv('evc-upcoming', 'ev-up',   Array.isArray(d)&&d.length ? d.map(mapEv) : FALLBACK_UPCOMING); })
            .catch(function(){  buildEv('evc-upcoming', 'ev-up',   FALLBACK_UPCOMING); });

          fetch(API + '/GetSmritivanEvents')
            .then(function(r){ return r.ok ? r.json() : []; })
            .then(function(d){ buildEv('evc-past',     'ev-past', Array.isArray(d)&&d.length ? d.map(mapEv) : FALLBACK_PAST); })
            .catch(function(){  buildEv('evc-past',     'ev-past', FALLBACK_PAST); });

          /* ── AUDIO PLAYER ── */
          var aud=document.getElementById('pm-audio'),
              audBtn=document.getElementById('aud-btn'),
              audBar=document.getElementById('aud-bar'),
              audTime=document.getElementById('aud-time'),
              playing=false;
          var PLAY  = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg>';
          var PAUSE = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="4" width="4" height="16"/><rect x="15" y="4" width="4" height="16"/></svg>';
          function fmt(s){ if(!s||!isFinite(s)) return '00:00'; var m=Math.floor(s/60),sc=Math.floor(s%60); return (m<10?'0':'')+m+':'+(sc<10?'0':'')+sc; }
          audBtn.addEventListener('click', function(){
            if(playing){ aud.pause(); audBtn.innerHTML=PLAY; } else { aud.play().catch(function(){}); audBtn.innerHTML=PAUSE; }
            playing=!playing;
          });
          aud.addEventListener('loadedmetadata', function(){ audTime.textContent='00:00 / '+fmt(aud.duration); });
          aud.addEventListener('timeupdate', function(){
            if(!aud.duration) return;
            audBar.value=(aud.currentTime/aud.duration)*100;
            audTime.textContent=fmt(aud.currentTime)+' / '+fmt(aud.duration);
          });
          aud.addEventListener('ended', function(){ playing=false; audBtn.innerHTML=PLAY; audBar.value=0; });
          audBar.addEventListener('input', function(){ if(aud.duration) aud.currentTime=(audBar.value/100)*aud.duration; });

          /* ── PM IMAGE FROM API ── */
          fetch(API + '/GetPmAudioDetails')
            .then(function(r){ return r.ok ? r.json() : null; })
            .then(function(d){
              if(!Array.isArray(d)||!d.length) return;
              var pm=d[0]; if(!pm.Pm_Image_Path) return;
              var w=document.getElementById('pm-img-wrap'), i=document.createElement('img');
              i.src=BASE+pm.Pm_Image_Path; i.alt='PM Modi';
              i.style.cssText='width:100%;height:580px;object-fit:cover;object-position:top';
              w.innerHTML=''; w.appendChild(i);
            }).catch(function(){});

          /* ── TESTIMONIALS ── */
          var fb=[
            { q:'Amazing experience! I love how you managed to combine lessons from the past, current & future technology. I hope the people of Gujarat will be forever safe & resilient.', a:'Meshgue', c:'Indonesia' },
            { q:'A truly moving tribute. The museum beautifully captures the resilience of the people of Kutch. Every Indian must visit Smritivan at least once.', a:'Priya R.', c:'India' },
            { q:"The 360° simulation was unlike anything I have ever seen. A powerful reminder of nature's force and humanity's strength to rebuild.", a:'Lena K.', c:'Germany' }
          ];
          function buildTesti(items){
            var tr=document.getElementById('ct-testi'), dt=document.getElementById('cd-testi'); if(!tr) return;
            items.forEach(function(t){
              var s=document.createElement('div'); s.className='cs';
              s.innerHTML='<div class="t-card"><div class="t-card__icon">\u201c</div><p class="t-card__q">'+esc(t.q)+'</p><div class="t-card__div"></div><div class="t-card__au">'+esc(t.a)+'</div><div class="t-card__co">'+esc(t.c)+'</div></div>';
              tr.appendChild(s);
            });
            dt.innerHTML='';
            items.forEach(function(_,i){
              var b=document.createElement('button'); b.className='c-dot'+(i===0?' on':'');
              b.addEventListener('click',function(){ cGoTo('testi',i); }); dt.appendChild(b);
            });
            initC('testi',true,7000);
          }
          fetch(API+'/GetTestimonialDetails')
            .then(function(r){ return r.ok?r.json():null; })
            .then(function(d){
              buildTesti((Array.isArray(d)&&d.length)
                ? d.map(function(t){ return { q:t.Testimonial||t.testimonial||'', a:t.name||t.Name||'', c:t.designation||t.Designation||'' }; })
                : fb);
            }).catch(function(){ buildTesti(fb); });

          /* ── DROPDOWN CLOSE ON OUTSIDE CLICK ── */
          document.addEventListener('click', function(e){
            var dd=document.getElementById('nd-about'); if(dd&&!dd.contains(e.target)) dd.classList.remove('open');
          });

        })();
    </script>
}
