@{
    ViewData["Title"] = "Gallery";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6;cursor:default}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}

    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
      --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
      --bg:#060504;--bg2:#0a0807;
    }

    /* ══ GRAIN OVERLAY ══ */
    body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9999;opacity:0.4}

  
    /* ══ HEADER ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo { display:flex;align-items:center;gap:12px; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
    .hdr__link:hover { color:var(--white); }
    .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }


    /* ══ HERO ══ */
    .hero{position:relative;height:90vh;min-height:600px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center;
      transform:scale(1.06);animation:heroZoom 18s ease-in-out infinite alternate}
    @@keyframes heroZoom{from{transform:scale(1.06) translate(0,0)}to{transform:scale(1.12) translate(-1%,-0.5%)}}
    .hero__ov{position:absolute;inset:0;
      background:linear-gradient(170deg,rgba(6,5,4,0.15) 0%,rgba(6,5,4,0.5) 45%,rgba(6,5,4,0.97) 100%)}
    .hero__grain{position:absolute;inset:0;opacity:0.06;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
    .hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
    .hero__scroll-line{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
      width:1px;height:72px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
      animation:pulse 2.5s ease-in-out infinite}
    @@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.2}}
    .hero__content{position:relative;z-index:3;padding:110px 60px 20px 110px;max-width:1000px}
    .hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
      color:var(--gold);margin-bottom:22px;display:flex;align-items:center;gap:16px;
      opacity:0;animation:fadeUp 0.9s 0.2s forwards}
    .hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(56px,9vw,120px);
      font-weight:700;line-height:0.88;letter-spacing:-3px;color:var(--white);
      margin-bottom:28px;opacity:0;animation:fadeUp 1s 0.4s forwards}
    .hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.45em;
      letter-spacing:5px;color:rgba(201,169,110,0.75);margin-bottom:10px}
    .hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
      max-width:480px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
      padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
    .hero__count{position:absolute;bottom:44px;right:80px;z-index:3;text-align:right;
      opacity:0;animation:fadeUp 0.9s 1s forwards}
    .hero__count-num{font-family:'Cormorant',serif;font-size:52px;font-weight:700;color:rgba(201,169,110,0.15);line-height:1}
    .hero__count-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:rgba(201,169,110,0.3)}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* ══ ALBUM STRIP ══ */
    .album-section{background:var(--bg2);border-bottom:1px solid var(--border);position:sticky;top:64px;z-index:80}
    .album-section__inner{max-width:1320px;margin:0 auto;padding:0 80px}
    .album-scroll{display:flex;gap:0;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .album-scroll::-webkit-scrollbar{display:none}
    .album-tab{flex-shrink:0;display:flex;align-items:center;gap:10px;padding:18px 24px;
      border-right:1px solid var(--border);cursor:pointer;transition:background var(--t);
      position:relative;overflow:hidden}
    .album-tab::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
      background:var(--gold);transform:scaleX(0);transition:transform 0.3s ease}
    .album-tab.active::after{transform:scaleX(1)}
    .album-tab:hover{background:var(--faint)}
    .album-tab.active{background:rgba(201,169,110,0.05)}
    .album-tab__thumb{width:44px;height:44px;object-fit:cover;border:1px solid var(--border);
      transition:border-color 0.3s;flex-shrink:0}
    .album-tab.active .album-tab__thumb{border-color:var(--gold)}
    .album-tab__name{font-size:11px;font-weight:400;color:var(--dim);white-space:nowrap;
      max-width:120px;overflow:hidden;text-overflow:ellipsis;transition:color 0.3s}
    .album-tab.active .album-tab__name{color:var(--white)}
    .album-tab__skeleton{width:44px;height:44px;background:rgba(255,255,255,0.04);flex-shrink:0;animation:shimmer 1.5s infinite}

    /* ══ GALLERY MAIN ══ */
    .gallery-main{padding:64px 80px;max-width:1320px;margin:0 auto}
    .gallery-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:44px;flex-wrap:wrap;gap:20px}
    .gallery-header__left{}
    .gallery-header__tag{font-size:9px;font-weight:500;letter-spacing:5px;text-transform:uppercase;
      color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:10px}
    .gallery-header__tag::before{content:'';width:24px;height:1px;background:var(--gold)}
    .gallery-header__title{font-family:'Cormorant',serif;font-size:clamp(28px,3vw,44px);
      font-weight:700;color:var(--white);line-height:1}
    .gallery-header__count{font-size:11px;color:var(--dim);margin-top:6px}
    .gallery-header__view{display:flex;gap:8px}
    .view-btn{width:38px;height:38px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
      transition:var(--t);color:var(--dim)}
    .view-btn:hover,.view-btn.active{border-color:var(--gold);color:var(--gold);background:rgba(201,169,110,0.06)}

    /* ══ MASONRY / GRID ══ */
    .photo-grid{columns:3;column-gap:12px;transition:opacity 0.4s}
    .photo-grid.view-2{columns:2}
    .photo-grid.view-4{columns:4}
        .photo-grid { columns: 3; }
    .photo-grid.view-2 { columns: 2; }
    .photo-grid.view-4 { columns: 4; }
        .photo-grid {
      transition: all 0.3s ease;
    }
    .photo-grid.fading{opacity:0}
    .photo-item{break-inside:avoid;margin-bottom:12px;position:relative;overflow:hidden;cursor:pointer;
      border:1px solid transparent;transition:border-color 0.3s}
    .photo-item:hover{border-color:var(--border)}
    .photo-item img{width:100%;display:block;transition:transform 0.7s ease,filter 0.5s;
      filter:brightness(0.85)}
    .photo-item:hover img{transform:scale(1.04);filter:brightness(1)}
    .photo-item__ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(6,5,4,0.75) 0%,transparent 50%);
      opacity:0;transition:opacity 0.4s}
    .photo-item:hover .photo-item__ov{opacity:1}
    .photo-item__title{position:absolute;bottom:0;left:0;right:0;padding:16px;
      font-size:11px;letter-spacing:1px;color:var(--white);opacity:0;
      transform:translateY(8px);transition:opacity 0.4s,transform 0.4s}
    .photo-item:hover .photo-item__title{opacity:1;transform:translateY(0)}
    .photo-item__zoom{position:absolute;top:12px;right:12px;width:32px;height:32px;
      background:rgba(6,5,4,0.7);border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;
      opacity:0;transform:translateY(-8px);transition:opacity 0.3s,transform 0.3s;color:var(--gold)}
    .photo-item:hover .photo-item__zoom{opacity:1;transform:translateY(0)}

    /* ── Skeleton loaders ── */
    @@keyframes shimmer{0%{background-position:-400px 0}100%{background-position:400px 0}}
    .skeleton{background:linear-gradient(90deg,rgba(255,255,255,0.03) 25%,rgba(255,255,255,0.07) 50%,rgba(255,255,255,0.03) 75%);
      background-size:800px 100%;animation:shimmer 1.6s infinite;border:1px solid var(--border)}
    .skeleton-item{break-inside:avoid;margin-bottom:12px}

    /* ── Empty state ── */
    .empty-state{text-align:center;padding:80px 20px;color:var(--dim)}
    .empty-state__icon{font-size:48px;margin-bottom:16px;opacity:0.3}
    .empty-state__text{font-family:'Cormorant',serif;font-size:24px;color:rgba(201,169,110,0.4)}

    /* ══ LIGHTBOX ══ */
    .lb{position:fixed;inset:0;z-index:9000;display:flex;align-items:center;justify-content:center;
      background:rgba(0,0,0,0);pointer-events:none;transition:background 0.4s}
    .lb.open{background:rgba(0,0,0,0.96);pointer-events:all}
    .lb__inner{position:relative;max-width:90vw;max-height:90vh;
      opacity:0;transform:scale(0.92);transition:opacity 0.4s,transform 0.4s}
    .lb.open .lb__inner{opacity:1;transform:scale(1)}
    .lb__img{max-width:90vw;max-height:82vh;object-fit:contain;display:block;border:1px solid var(--border)}
    .lb__title{font-family:'Cormorant',serif;font-size:16px;color:var(--white);margin-top:16px;
      text-align:center;font-style:italic;min-height:24px}
    .lb__caption{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);
      text-align:center;margin-top:6px}
    .lb__close{position:fixed;top:24px;right:32px;font-size:28px;color:var(--dim);
      cursor:pointer;transition:color 0.2s,transform 0.2s;line-height:1;z-index:10;display:none}
    .lb.open .lb__close{display:block}
    .lb__close:hover{color:var(--white);transform:rotate(90deg)}
    .lb__nav{position:fixed;top:50%;transform:translateY(-50%);
      width:52px;height:52px;border:1px solid var(--border);
      align-items:center;justify-content:center;
      cursor:pointer;transition:var(--t);color:var(--dim);background:rgba(6,5,4,0.6);font-size:20px;display:none}
    .lb.open .lb__nav{display:flex}
    .lb__nav:hover{border-color:var(--gold);color:var(--gold);background:rgba(6,5,4,0.9)}
    .lb__prev{left:24px}
    .lb__next{right:24px}
    .lb__counter{position:fixed;bottom:32px;left:50%;transform:translateX(-50%);
      font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--dim);display:none}
    .lb.open .lb__counter{display:block}

    /* ══ LIVE TICKER ══ */
    .ticker{background:var(--bg2);border-bottom:1px solid var(--border);overflow:hidden;
      padding:10px 0;display:flex;gap:0}
    .ticker__track{display:flex;gap:0;animation:tickerRoll 40s linear infinite;white-space:nowrap}
    .ticker__track:hover{animation-play-state:paused}
    @@keyframes tickerRoll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
    .ticker__item{padding:0 40px;font-size:10px;letter-spacing:3px;text-transform:uppercase;
      color:rgba(201,169,110,0.4);display:flex;align-items:center;gap:12px;flex-shrink:0}
    .ticker__dot{width:4px;height:4px;border-radius:50%;background:var(--gold);opacity:0.4}

     /* ══ FOOTER ══ */
   .ftr { background:#000;border-top:1px solid var(--border);padding:80px 80px 40px; }
   .ftr__inner { max-width:1200px;margin:0 auto; }
   .ftr__top { display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:56px;padding-bottom:60px;border-bottom:1px solid var(--border);margin-bottom:32px; }
   .ftr__brand { display:flex;flex-direction:column;gap:16px; }
   .ftr__logo { display:flex;align-items:center;gap:12px; }
   .ftr__logo img { width:34px; }
   .ftr__logo strong { font-family:'Cormorant',serif;font-size:18px;color:var(--white);font-weight:600;letter-spacing:1px; }
   .ftr__brand p { font-size:13px;color:rgba(255,255,255,0.28);line-height:1.7;font-weight:300; }
   .ftr__partners { display:flex;gap:18px;flex-wrap:wrap;margin-top:8px; }
   .ftr__partners a:hover { opacity:0.6; }
   .ftr__col h4 { font-size:9px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:20px; }
   .ftr__col a { display:block;font-size:13px;color:rgba(255,255,255,0.3);padding:6px 0;transition:color 0.2s,padding-left 0.2s; }
   .ftr__col a:hover { color:var(--white);padding-left:8px; }
   .ftr__bot { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:11px;color:rgba(255,255,255,0.18);letter-spacing:0.5px; }
   .ftr__bot a { color:rgba(255,255,255,0.22);transition:color 0.2s; }
   .ftr__bot a:hover { color:var(--white); }
   .ftr__atm { color:var(--gold) !important;font-weight:500; }
   .ftr__atm:hover { color:var(--gold-lt) !important; }
   .sp-wrap { display:flex;align-items:center;justify-content:center;min-height:300px; }
   .sp { width:30px;height:30px;border:1.5px solid rgba(201,169,110,0.1);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite; }


    /* ══ RESPONSIVE ══ */
    @@media(max-width:1100px){
      .gallery-main{padding:48px 40px}
      .album-section__inner{padding:0 40px}
      .photo-grid{columns:2}
      .photo-grid.view-4{columns:3}
      .ftr__top{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}
      .ham{display:flex}
      .hero__content{padding:0 24px 64px}
      .hero__line{left:24px}
      .hero__scroll-line{left:24px}
      .hero__count{right:24px}
      .album-section__inner{padding:0 16px}
      .gallery-main{padding:32px 20px}
      .photo-grid,.photo-grid.view-2,.photo-grid.view-4{columns:2}
      .ftr{padding:48px 24px 28px}
      .ftr__top{grid-template-columns:1fr;gap:32px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
    @@media(max-width:480px){
      .hero__title{font-size:56px;letter-spacing:-2px}
      .photo-grid,.photo-grid.view-2,.photo-grid.view-4{columns:1}
    }
</style>
}

<main>
<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero__bg">
    <img src="https://www.smritivanearthquakemuseum.biz/assets2/BHA_8446.jpeg" alt="Smritivan Gallery"/>
  </div>
  <div class="hero__ov"></div>
  <div class="hero__grain"></div>
  <div class="hero__line"></div>
  <div class="hero__scroll-line"></div>
  <div class="hero__content">
    <p class="hero__kicker">Smritivan Museum</p>
    <h1 class="hero__title">
      <em>Visual Journey</em>
      Museum<br>Gallery
    </h1>
    <p class="hero__desc">Explore the exhibits, memorials, and moments that define Smritivan — captured through lens and light.</p>
  </div>
  <div class="hero__count">
    <div class="hero__count-num" id="hero-img-count">—</div>
    <div class="hero__count-lbl">Photographs</div>
  </div>
</section>

<!-- ══ LIVE TICKER ══ -->
<div class="ticker">
  <div class="ticker__track" id="ticker-track">
    <span class="ticker__item"><span class="ticker__dot"></span>Smritivan Earthquake Memorial</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Museum Gallery</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Bhuj · Gujarat · India</span>
    <span class="ticker__item"><span class="ticker__dot"></span>26 January 2001</span>
    <span class="ticker__item"><span class="ticker__dot"></span>12,932 Lives Remembered</span>
    <span class="ticker__item"><span class="ticker__dot"></span>170 Acres of Memory</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Miyawaki Forest · Solar Plant · Sun Point</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Inaugurated 28 August 2022</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Smritivan Earthquake Memorial</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Museum Gallery</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Bhuj · Gujarat · India</span>
    <span class="ticker__item"><span class="ticker__dot"></span>26 January 2001</span>
    <span class="ticker__item"><span class="ticker__dot"></span>12,932 Lives Remembered</span>
    <span class="ticker__item"><span class="ticker__dot"></span>170 Acres of Memory</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Miyawaki Forest · Solar Plant · Sun Point</span>
    <span class="ticker__item"><span class="ticker__dot"></span>Inaugurated 28 August 2022</span>
  </div>
</div>

<!-- ══ ALBUM STRIP ══ -->
<div class="album-section">
  <div class="album-section__inner">
    <div class="album-scroll" id="album-scroll">
      <!-- skeleton placeholders while API loads -->
      <div class="album-tab" style="gap:10px;padding:18px 24px">
        <div class="album-tab__skeleton skeleton" style="height:44px;width:44px"></div>
        <div class="skeleton" style="width:80px;height:12px;border-radius:2px"></div>
      </div>
      <div class="album-tab" style="gap:10px;padding:18px 24px">
        <div class="album-tab__skeleton skeleton" style="height:44px;width:44px"></div>
        <div class="skeleton" style="width:60px;height:12px;border-radius:2px"></div>
      </div>
      <div class="album-tab" style="gap:10px;padding:18px 24px">
        <div class="album-tab__skeleton skeleton" style="height:44px;width:44px"></div>
        <div class="skeleton" style="width:90px;height:12px;border-radius:2px"></div>
      </div>
    </div>
  </div>
</div>

<!-- ══ GALLERY GRID ══ -->
<div class="gallery-main">
  <div class="gallery-header">
    <div class="gallery-header__left">
      <div class="gallery-header__tag">Collection</div>
      <h2 class="gallery-header__title" id="album-title">Loading…</h2>
      <div class="gallery-header__count" id="album-count"></div>
    </div>
    <div class="gallery-header__view">
      <button class="view-btn" id="view-2" title="2 columns" onclick="setView(2)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="9" y="1" width="6" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <button class="view-btn active" id="view-3" title="3 columns" onclick="setView(3)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="4" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="6" y="1" width="4" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="11" y="1" width="4" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <button class="view-btn" id="view-4" title="4 columns" onclick="setView(4)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="3" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="5" y="1" width="3" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="9" y="1" width="3" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="13" y="1" width="3" height="14" rx="0.5" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
    </div>
  </div>

  <div class="photo-grid" id="photo-grid">
    <div class="skeleton-item"><div class="skeleton" style="height:280px"></div></div>
    <div class="skeleton-item"><div class="skeleton" style="height:200px"></div></div>
    <div class="skeleton-item"><div class="skeleton" style="height:320px"></div></div>
    <div class="skeleton-item"><div class="skeleton" style="height:180px"></div></div>
    <div class="skeleton-item"><div class="skeleton" style="height:260px"></div></div>
    <div class="skeleton-item"><div class="skeleton" style="height:220px"></div></div>
  </div>
</div>

<!-- ══ LIGHTBOX ══ -->
<div class="lb" id="lightbox">
  <button class="lb__close" id="lb-close">&#215;</button>
  <button class="lb__nav lb__prev" id="lb-prev">&#8592;</button>
  <button class="lb__nav lb__next" id="lb-next">&#8594;</button>
  <div class="lb__inner">
    <img class="lb__img" id="lb-img" src="" alt="" />
    <div class="lb__title" id="lb-title"></div>
    <div class="lb__caption" id="lb-caption"></div>
  </div>
  <div class="lb__counter" id="lb-counter"></div>
</div>
</main>

<script>
    (function () {
        'use strict';

        // ✅ ALL 7 ALBUMS (FINAL)
        var ALBUMS = [
            { name: "Rebirth", images: getImages(1) },
            { name: "Rediscover", images: getImages(2) },
            { name: "Restore", images: getImages(3) },
            { name: "Rebuild", images: getImages(4) },
            { name: "Rethink", images: getImages(5) },
            { name: "Relive", images: getImages(6) },
            { name: "Renew", images: getImages(7) }
        ];

        // ✅ GENERATE UNIQUE IMAGES PER ALBUM
        function getImages(seed) {
            var arr = [];
            for (var i = 1; i <= 6; i++) {
                var index = ((seed + i - 1) % 7) + 1;
                arr.push("/assets/gallary/gallary_" + index + ".jpg");
            }
            return arr;
        }

        var currentImages = [];
        var currentIndex = 0;

        // ───────── ALBUM TABS ─────────
        function renderAlbums() {
            var scroll = document.getElementById("album-scroll");
            scroll.innerHTML = "";

            ALBUMS.forEach(function (album, i) {
                var tab = document.createElement("div");
                tab.className = "album-tab" + (i === 0 ? " active" : "");

                var img = document.createElement("img");
                img.className = "album-tab__thumb";
                img.src = album.images[0];

                var name = document.createElement("div");
                name.className = "album-tab__name";
                name.textContent = album.name;

                tab.appendChild(img);
                tab.appendChild(name);

                tab.onclick = function () {
                    document.querySelectorAll(".album-tab").forEach(t => t.classList.remove("active"));
                    tab.classList.add("active");
                    renderGallery(album);
                };

                scroll.appendChild(tab);
            });
        }

        // ───────── GALLERY ─────────
        function renderGallery(album) {
            var grid = document.getElementById("photo-grid");
            var title = document.getElementById("album-title");
            var count = document.getElementById("album-count");

            currentImages = album.images;

            title.textContent = album.name;
            count.textContent = album.images.length + " photographs";

            grid.innerHTML = "";

            album.images.forEach(function (src, i) {
                var item = document.createElement("div");
                item.className = "photo-item";

                var img = document.createElement("img");
                img.src = src;

                item.appendChild(img);

                item.onclick = function () {
                    openLightbox(i);
                };

                grid.appendChild(item);
            });
        }

        window.setView = function (n) {
            var grid = document.getElementById('photo-grid');

            // ✅ remove ALL possible classes
            grid.classList.remove('view-2', 'view-3', 'view-4');

            // ✅ apply selected view
            grid.classList.add('view-' + n);

            // ✅ update button active state
            document.querySelectorAll('.view-btn').forEach(function (btn) {
                btn.classList.remove('active');
            });

            document.getElementById('view-' + n).classList.add('active');
        };

        // ───────── LIGHTBOX ─────────
        var lb = document.getElementById("lightbox");
        var lbImg = document.getElementById("lb-img");
        var lbCounter = document.getElementById("lb-counter");

        function openLightbox(index) {
            currentIndex = index;
            updateLightbox();
            lb.classList.add("open");
            document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
            lb.classList.remove("open");
            document.body.style.overflow = "";
        }

        function updateLightbox() {
            lbImg.src = currentImages[currentIndex];
            lbCounter.textContent = (currentIndex + 1) + " / " + currentImages.length;
        }

        function next() {
            currentIndex = (currentIndex + 1) % currentImages.length;
            updateLightbox();
        }

        function prev() {
            currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
            updateLightbox();
        }

        document.getElementById("lb-close").onclick = closeLightbox;
        document.getElementById("lb-next").onclick = next;
        document.getElementById("lb-prev").onclick = prev;

        // Keyboard support
        document.addEventListener("keydown", function (e) {
            if (!lb.classList.contains("open")) return;
            if (e.key === "ArrowRight") next();
            if (e.key === "ArrowLeft") prev();
            if (e.key === "Escape") closeLightbox();
        });

        // ───────── INIT ─────────
        renderAlbums();
        renderGallery(ALBUMS[0]);

    })();
</script>