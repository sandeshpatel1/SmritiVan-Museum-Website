@section Scripts {
<!-- Three.js r128 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>
(function () {
  'use strict';

  /* ══════════════════════════════════════════════════════
     SCROLL REVEAL
  ══════════════════════════════════════════════════════ */
  var revEls = document.querySelectorAll('.reveal, .reveal-l, .reveal-r');
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.06 });
  revEls.forEach(function (el) { io.observe(el); });

  /* ══════════════════════════════════════════════════════
     HEADER SCROLL  (safe: only runs if element exists)
  ══════════════════════════════════════════════════════ */
  var hdr = document.getElementById('hdr');
  if (hdr) {
    window.addEventListener('scroll', function () {
      hdr.classList.toggle('scrolled', window.scrollY > 50);
    }, { passive: true });
  }

  /* ══════════════════════════════════════════════════════
     MOBILE NAV  (safe: only runs if elements exist)
  ══════════════════════════════════════════════════════ */
  var ham = document.getElementById('ham-btn');
  var mobNav = document.getElementById('mob-nav');
  var mobOv = document.getElementById('mob-ov');
  var mobClose = document.getElementById('mob-close');
  if (ham && mobNav && mobOv) {
    function nOpen() { mobNav.classList.add('open'); mobOv.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function nClose() { mobNav.classList.remove('open'); mobOv.classList.remove('open'); document.body.style.overflow = ''; }
    ham.addEventListener('click', nOpen);
    mobOv.addEventListener('click', nClose);
    if (mobClose) mobClose.addEventListener('click', nClose);
    mobNav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', nClose); });
  }

  /* ══════════════════════════════════════════════════════
     DROPDOWN  (safe)
  ══════════════════════════════════════════════════════ */
  document.addEventListener('click', function (e) {
    var dd = document.getElementById('nd-about');
    if (dd && !dd.contains(e.target)) dd.classList.remove('open');
  });

  /* ══════════════════════════════════════════════════════
     360° VIEWER ENGINE
     FIX: Rewrote button wiring to use data-attributes on
          delegated click events — no more inline onclick()
          calls with broken Razor tilde paths in JS context.
  ══════════════════════════════════════════════════════ */

  var amenState = {};   // { [id]: { viewer } | null }
  var active360 = null; // currently open inline amenity id

  /* ── Build a Three.js equirectangular panorama viewer ── */
  function buildViewer(canvasEl, src, onReady) {
    var container = canvasEl.parentElement;
    var w = container.clientWidth || 700;
    var h = container.clientHeight || 520;

    var scene    = new THREE.Scene();
    var camera   = new THREE.PerspectiveCamera(75, w / h, 0.1, 1000);
    camera.position.set(0, 0, 0.001);

    var renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(w, h, false);

    /* Sphere geometry — flipped inside-out for equirectangular display */
    var geo = new THREE.SphereGeometry(500, 60, 40);
    geo.scale(-1, 1, 1);
    var sphere = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: 0x111111 }));
    scene.add(sphere);

    var lon = 0, lat = 0, fov = 75;
    var isDrag = false, px = 0, py = 0;
    var tx = 0, ty = 0;
    var ready = false;

    /* Load equirectangular texture */
    var loader = new THREE.TextureLoader();
    loader.crossOrigin = 'anonymous';
    loader.load(
      src,
      function (tex) {
        tex.minFilter = THREE.LinearFilter;
        sphere.material = new THREE.MeshBasicMaterial({ map: tex });
        ready = true;
        if (onReady) onReady();
      },
      undefined,
      function (err) {
        console.warn('[360 viewer] Texture load failed for:', src, err);
        ready = true; // unblock render loop even on error
        if (onReady) onReady();
      }
    );

    /* ── Input handlers ── */
    canvasEl.addEventListener('mousedown', function (e) { isDrag = true; px = e.clientX; py = e.clientY; });
    window.addEventListener('mouseup',    function ()  { isDrag = false; });
    window.addEventListener('mousemove',  function (e) {
      if (!isDrag) return;
      lon -= (e.clientX - px) * 0.18;
      lat += (e.clientY - py) * 0.10;
      lat  = Math.max(-80, Math.min(80, lat));
      px   = e.clientX; py = e.clientY;
    });

    canvasEl.addEventListener('touchstart', function (e) {
      if (e.touches.length === 1) { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }
    }, { passive: true });
    canvasEl.addEventListener('touchmove', function (e) {
      if (e.touches.length === 1) {
        lon -= (e.touches[0].clientX - tx) * 0.22;
        lat += (e.touches[0].clientY - ty) * 0.14;
        lat  = Math.max(-80, Math.min(80, lat));
        tx   = e.touches[0].clientX; ty = e.touches[0].clientY;
        e.preventDefault();
      }
    }, { passive: false });

    canvasEl.addEventListener('wheel', function (e) {
      fov = Math.max(30, Math.min(100, fov + e.deltaY * 0.05));
      camera.fov = fov;
      camera.updateProjectionMatrix();
    }, { passive: true });

    /* ── Render loop with gentle auto-pan ── */
    var raf;
    function loop() {
      raf = requestAnimationFrame(loop);
      if (!ready) return;
      if (!isDrag) lon += 0.04;
      var phi   = THREE.MathUtils.degToRad(90 - lat);
      var theta = THREE.MathUtils.degToRad(lon);
      camera.lookAt(
        Math.sin(phi) * Math.cos(theta),
        Math.cos(phi),
        Math.sin(phi) * Math.sin(theta)
      );
      renderer.render(scene, camera);
    }
    loop();

    /* ── Keep canvas sized to its container ── */
    var resizeObs = new ResizeObserver(function () {
      var nw = container.clientWidth;
      var nh = container.clientHeight;
      if (!nw || !nh) return;
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
      renderer.setSize(nw, nh, false);
    });
    resizeObs.observe(container);

    return {
      destroy: function () {
        cancelAnimationFrame(raf);
        renderer.dispose();
        resizeObs.disconnect();
      }
    };
  }

  /* ── Inline 360 toggle ── */
  function toggle360(id, src) {
    if (active360 === id) { stop360(id); return; }
    if (active360) stop360(active360);
    active360 = id;
    start360(id, src);
  }

  function start360(id, src) {
    var panoEl   = document.getElementById('pano-' + id);
    var flatEl   = document.getElementById('flat-' + id);
    var loadEl   = document.getElementById('loading-' + id);
    var btnEl    = document.getElementById('btn360-' + id);
    var ctaEl    = document.getElementById('cta360-' + id);

    if (!panoEl) return;

    loadEl && loadEl.classList.add('show');
    panoEl.classList.add('active');
    flatEl && flatEl.classList.add('hidden');
    btnEl  && btnEl.classList.add('active');
    if (ctaEl) {
      ctaEl.classList.add('active-360');
      ctaEl.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0">' +
        '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M2 12h20"/></svg> Exit 360°';
    }

    var canvasEl = document.getElementById('canvas-' + id);
    var viewer = buildViewer(canvasEl, src, function () {
      loadEl && loadEl.classList.remove('show');
    });
    amenState[id] = { viewer: viewer };
  }

  function stop360(id) {
    var st = amenState[id];
    if (st && st.viewer) st.viewer.destroy();
    amenState[id] = null;
    active360 = null;

    var panoEl = document.getElementById('pano-' + id);
    var flatEl = document.getElementById('flat-' + id);
    var loadEl = document.getElementById('loading-' + id);
    var btnEl  = document.getElementById('btn360-' + id);
    var ctaEl  = document.getElementById('cta360-' + id);

    panoEl && panoEl.classList.remove('active');
    flatEl && flatEl.classList.remove('hidden');
    loadEl && loadEl.classList.remove('show');
    btnEl  && btnEl.classList.remove('active');
    if (ctaEl) {
      ctaEl.classList.remove('active-360');
      ctaEl.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0">' +
        '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M2 12h20"/></svg> Preview 360°';
    }
  }

  /* ══════════════════════════════════════════════════════
     FULLSCREEN MODAL
     FIX: Modal HTML now exists in the page (was missing).
          JS here just drives open/close/build.
  ══════════════════════════════════════════════════════ */
  var panoModal     = document.getElementById('pano-modal');
  var panoClose     = document.getElementById('pano-close');
  var panoFsLoading = document.getElementById('pano-fs-loading');
  var panoFsCanvas  = document.getElementById('pano-fs-canvas');
  var panoFsName    = document.getElementById('pano-fs-name');
  var fsViewer      = null;

  function openFullscreen(src, name) {
    if (!panoModal) return;
    document.body.style.overflow = 'hidden';
    panoModal.classList.add('open');
    if (panoFsName)    panoFsName.textContent = name;
    if (panoFsLoading) panoFsLoading.classList.remove('done');

    if (fsViewer) { fsViewer.destroy(); fsViewer = null; }

    /* Small delay lets the modal finish its CSS fade-in before
       the renderer measures the canvas dimensions */
    setTimeout(function () {
      if (!panoFsCanvas) return;
      fsViewer = buildViewer(panoFsCanvas, src, function () {
        panoFsLoading && panoFsLoading.classList.add('done');
      });
    }, 80);
  }

  if (panoClose) {
    panoClose.addEventListener('click', function () {
      panoModal.classList.remove('open');
      document.body.style.overflow = '';
      if (fsViewer) { fsViewer.destroy(); fsViewer = null; }
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panoModal && panoModal.classList.contains('open')) {
      panoClose && panoClose.click();
    }
  });

  /* ══════════════════════════════════════════════════════
     DELEGATED BUTTON EVENTS
     FIX: Replaced all inline onclick="toggle360(...)" /
          onclick="openFullscreen(...)" calls (which had
          broken "~assets/..." Razor paths in JS context)
          with a single delegated listener that reads the
          correct, Razor-resolved src from data-src.
  ══════════════════════════════════════════════════════ */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;

    var action = btn.dataset.action;
    var id     = btn.dataset.id;
    var src    = btn.dataset.src;
    var name   = btn.dataset.name || id;

    if (action === 'toggle')     toggle360(id, src);
    if (action === 'fullscreen') openFullscreen(src, name);
  });

})();
</script>
}
