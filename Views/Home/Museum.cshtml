@{
    ViewData["Title"] = "Earthquake Museum";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6}
img{display:block;max-width:100%}
a{text-decoration:none;color:inherit}
button{cursor:pointer;font-family:inherit;border:none;background:none}

:root{
  --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
  --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
  --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
  --bg:#060504;--bg2:#0a0807;
}

      /* ══ HEADER ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo { display:flex;align-items:center;gap:12px; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
    .hdr__link:hover { color:var(--white); }
    .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

/* ACTIVE NAV */
        .hdr__link.active {
            color: var(--white);
            border-bottom: 2px solid var(--gold);
        }
.hdr__drop-btn.active { color:var(--white); }
.hdr__drop-btn.active::after { content:''; position:absolute; bottom:-2px; left:12px; right:12px; height:1px; background:var(--gold); }
.hdr__drop-item.active { color:var(--gold); }

/* HERO */
.hero{position:relative;height:88vh;min-height:580px;display:flex;overflow:hidden}
.hero__bg{position:absolute;inset:0}
.hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center top}
.hero__ov{position:absolute;inset:0;background:linear-gradient(170deg,rgba(6,5,4,0.3) 0%,rgba(6,5,4,0.65) 50%,rgba(6,5,4,0.97) 100%)}
.hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
  background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
.hero__content{position:relative;z-index:3;padding:110px 60px 20px 110px; max-width:860px;text-align:left}
.hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
  color:var(--gold);margin-bottom:22px;display:flex;align-items:center;gap:16px;
  opacity:0;animation:fadeUp 0.9s 0.2s forwards}
.hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
.hero__title{font-family:'Cormorant',serif;font-size:clamp(52px,7.5vw,104px);
  font-weight:700;line-height:0.88;letter-spacing:-2px;color:var(--white);
  margin-bottom:30px;opacity:0;animation:fadeUp 1s 0.4s forwards}
.hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.52em;
  letter-spacing:3px;color:rgba(201,169,110,0.8);margin-bottom:10px}
.hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
  max-width:600px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
  padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
.hero__stats{display:flex;gap:52px;margin-top:44px;opacity:0;animation:fadeUp 0.9s 0.9s forwards}
.stat-num{font-family:'Cormorant',serif;font-size:44px;font-weight:700;color:var(--white);line-height:1}
.stat-num span{color:var(--gold)}
.stat-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim);margin-top:5px}
.hero__scroll{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
  width:1px;height:72px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
  animation:pulse 2.5s ease-in-out infinite}
@@keyframes pulse{0%,100%{opacity:1;transform:translateX(-50%) scaleY(1)}50%{opacity:0.25;transform:translateX(-50%) scaleY(0.4)}}
@@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

/* COMMON */
.tag{font-size:9px;font-weight:500;letter-spacing:5px;text-transform:uppercase;
  color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:16px}
.tag::before{content:'';width:24px;height:1px;background:var(--gold)}
.sec-title{font-family:'Cormorant',serif;font-size:clamp(32px,4.5vw,58px);
  font-weight:700;color:var(--white);line-height:0.95;letter-spacing:-0.5px}
.rule{width:40px;height:1px;background:var(--gold);margin:22px 0 30px}
.reveal{opacity:0;transform:translateY(36px);transition:opacity 0.85s ease,transform 0.85s ease}
.reveal.in{opacity:1;transform:none}
.reveal-l{opacity:0;transform:translateX(-36px);transition:opacity 0.85s ease,transform 0.85s ease}
.reveal-l.in{opacity:1;transform:none}
.reveal-r{opacity:0;transform:translateX(36px);transition:opacity 0.85s ease,transform 0.85s ease}
.reveal-r.in{opacity:1;transform:none}

/* INTRO */
.intro{padding:110px 80px;background:var(--bg);position:relative;overflow:hidden}
.intro::before{content:'MUSEUM';position:absolute;right:-30px;top:50%;transform:translateY(-50%);
  font-family:'Cormorant',serif;font-size:220px;font-weight:700;color:rgba(201,169,110,0.022);
  line-height:1;pointer-events:none;letter-spacing:-8px;white-space:nowrap}
.intro__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:88px;align-items:center}
.intro__body{font-size:15px;font-weight:300;color:var(--dim);line-height:1.95;margin-bottom:40px}
.intro__nums{display:flex;gap:36px;flex-wrap:wrap}
.intro__num-val{font-family:'Cormorant',serif;font-size:40px;font-weight:700;color:var(--white);line-height:1}
.intro__num-val span{color:var(--gold)}
.intro__num-lbl{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim);margin-top:5px}
.intro__img-wrap{position:relative}
.intro__img-wrap::before{content:'';position:absolute;top:-14px;left:-14px;right:14px;bottom:14px;
  border:1px solid var(--border);pointer-events:none}
.intro__img-wrap img{position:relative;z-index:1;width:100%;height:500px;object-fit:cover}
.intro__award{position:absolute;bottom:-18px;right:-18px;z-index:2;
  background:var(--bg2);border:1px solid var(--border);padding:18px 22px;display:flex;gap:14px;align-items:center}
.intro__award-icon{font-size:28px;line-height:1}
.intro__award-text strong{display:block;font-size:11px;font-weight:500;color:var(--white);letter-spacing:0.5px}
.intro__award-text span{font-size:10px;color:var(--gold);letter-spacing:1px;text-transform:uppercase}

/* BLOCKS HEADER */
.blocks-hd{padding:80px 80px 0;background:var(--bg2)}
.blocks-hd__inner{max-width:1200px;margin:0 auto;display:flex;align-items:flex-end;
  justify-content:space-between;gap:32px;flex-wrap:wrap;padding-bottom:52px;border-bottom:1px solid var(--border)}
.blocks-hd__note{max-width:360px;font-size:13px;font-weight:300;color:var(--dim);line-height:1.85}

/* BLOCKS */
.blocks{background:var(--bg2);padding:0 80px 100px}
.blocks__timeline{max-width:1200px;margin:0 auto;position:relative}
.blocks__timeline::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;
  background:linear-gradient(to bottom,transparent,var(--border) 5%,var(--border) 95%,transparent);
  transform:translateX(-50%);pointer-events:none}

.block{display:grid;grid-template-columns:1fr 1fr;gap:0;position:relative;
  padding:72px 0;border-bottom:1px solid var(--border)}
.block:last-child{border-bottom:none}
.block--flip{direction:rtl}
.block--flip>*{direction:ltr}
.block__badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:52px;height:52px;background:var(--bg2);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;z-index:4;
  font-family:'Cormorant',serif;font-size:18px;font-weight:700;color:var(--gold)}

/* 360 MINI VIEWER */
.viewer-wrap{position:relative;overflow:hidden}
.pano-container{position:relative;height:460px;background:#060504;overflow:hidden;cursor:grab}
.pano-container:active{cursor:grabbing}
.pano-canvas{width:100%;height:100%;display:block}

.pano-loading{position:absolute;inset:0;background:rgba(6,5,4,0.9);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  z-index:20;transition:opacity 0.4s}
.pano-loading.hidden{opacity:0;pointer-events:none}
.pano-spinner{width:26px;height:26px;border:1.5px solid var(--border);
  border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite}
@@keyframes spin{to{transform:rotate(360deg)}}
.pano-loading span{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}

.pano-badge{position:absolute;top:14px;left:14px;z-index:10;
  background:rgba(0,0,0,0.75);border:1px solid rgba(201,169,110,0.2);
  padding:5px 12px;display:flex;align-items:center;gap:8px;pointer-events:none}
.pano-badge-ring{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--gold);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  font-size:4.5px;color:var(--gold);font-weight:700;letter-spacing:-0.2px}
.pano-badge span{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold)}

.drag-hint{position:absolute;bottom:56px;left:50%;transform:translateX(-50%);
  font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);
  pointer-events:none;transition:opacity 0.5s;white-space:nowrap;z-index:10;
  display:flex;align-items:center;gap:6px}
.drag-hint.hidden{opacity:0}

.pano-scene-info{position:absolute;top:14px;right:14px;z-index:10;
  background:rgba(0,0,0,0.65);border:1px solid var(--border);padding:6px 12px;pointer-events:none}
.pano-scene-info__counter{font-size:8px;letter-spacing:3px;text-transform:uppercase;color:rgba(201,169,110,0.5);margin-bottom:2px}
.pano-scene-info__name{font-family:'Cormorant',serif;font-size:14px;font-weight:600;color:var(--gold);letter-spacing:0.5px}

.scene-strip{background:rgba(0,0,0,0.9);border-top:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.scene-strip::-webkit-scrollbar{display:none}
.scene-strip-inner{display:flex;align-items:stretch;min-width:max-content}
.scene-thumb{padding:10px 14px;text-align:center;cursor:pointer;
  border-right:1px solid var(--border);transition:background 0.2s;position:relative;
  display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0}
.scene-thumb:last-child{border-right:none}
.scene-thumb:hover{background:rgba(201,169,110,0.07)}
.scene-thumb.active{background:rgba(201,169,110,0.13)}
.scene-thumb.active::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold)}
.scene-dot{width:5px;height:5px;border-radius:50%;background:rgba(201,169,110,0.25);transition:background 0.2s,transform 0.2s}
.scene-thumb.active .scene-dot{background:var(--gold);transform:scale(1.4)}
.scene-thumb-label{font-size:8.5px;letter-spacing:0.5px;text-transform:uppercase;
  color:rgba(242,236,226,0.28);white-space:nowrap;transition:color 0.2s;line-height:1.3}
.scene-thumb.active .scene-thumb-label{color:var(--gold)}

.tour-btn{display:inline-flex;align-items:center;gap:10px;
  background:transparent;border:1px solid rgba(201,169,110,0.3);
  color:var(--gold);padding:10px 20px;font-size:10px;font-weight:500;
  letter-spacing:2px;text-transform:uppercase;transition:var(--t);margin-top:22px;cursor:pointer}
.tour-btn:hover{background:rgba(201,169,110,0.09);border-color:var(--gold)}
.tour-btn svg{width:14px;height:14px;flex-shrink:0}

.block__content{padding:52px 60px;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:1}
.block--flip .block__content{padding:52px 60px 52px 0}
.block__num{font-family:'Cormorant',serif;font-size:110px;font-weight:700;
  line-height:0.85;color:transparent;letter-spacing:-4px;margin-bottom:18px;
  -webkit-text-stroke:1px rgba(201,169,110,0.12)}
.block__tag{font-size:9px;font-weight:500;letter-spacing:4.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
.block__title{font-family:'Cormorant',serif;font-size:clamp(34px,3.5vw,50px);
  font-weight:700;color:var(--white);line-height:1;margin-bottom:18px}
.block__body{font-size:13.5px;font-weight:300;color:var(--dim);line-height:1.9;margin-bottom:28px}
.block__pts{display:flex;flex-direction:column;gap:9px}
.block__pt{font-size:12.5px;color:rgba(242,236,226,0.38);font-weight:300;
  display:flex;align-items:flex-start;gap:10px;padding-top:9px;border-top:1px solid rgba(255,255,255,0.04)}
.block__pt::before{content:'';width:3px;height:3px;border-radius:50%;background:var(--gold);margin-top:8px;flex-shrink:0}

/* FULLSCREEN TOUR MODAL */
.tour-modal{position:fixed;inset:0;z-index:9999;background:#000;
  opacity:0;pointer-events:none;transition:opacity 0.45s cubic-bezier(0.4,0,0.2,1);
  display:flex;flex-direction:column}
.tour-modal.open{opacity:1;pointer-events:all}

.tour-bar{height:58px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;border-bottom:1px solid var(--border);background:rgba(6,5,4,0.95);
  backdrop-filter:blur(20px);z-index:10}
.tour-bar__left{display:flex;align-items:center;gap:18px;min-width:0}
.tour-bar__logo{font-family:'Cormorant',serif;font-size:16px;font-weight:600;
  color:var(--white);letter-spacing:2px;white-space:nowrap}
.tour-bar__sep{width:1px;height:18px;background:var(--border);flex-shrink:0}
.tour-bar__info{min-width:0}
.tour-bar__block-tag{font-size:8px;letter-spacing:3px;text-transform:uppercase;color:rgba(201,169,110,0.6)}
.tour-bar__title{font-family:'Cormorant',serif;font-size:18px;font-weight:700;
  color:var(--white);line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tour-bar__right{display:flex;align-items:center;gap:14px;flex-shrink:0}
.tour-counter{font-size:10px;letter-spacing:2px;color:var(--dim);white-space:nowrap}
.tour-close-btn{width:38px;height:38px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;color:var(--dim);transition:var(--t)}
.tour-close-btn:hover{border-color:var(--gold);color:var(--gold)}
.tour-close-btn svg{width:14px;height:14px}

.tour-pano{flex:1;position:relative;overflow:hidden;cursor:grab;min-height:0}
.tour-pano:active{cursor:grabbing}
.tour-canvas{width:100%;height:100%;display:block}

.tour-loading{position:absolute;inset:0;background:rgba(6,5,4,0.88);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  z-index:20;transition:opacity 0.4s}
.tour-loading.hidden{opacity:0;pointer-events:none}
.tour-spinner{width:32px;height:32px;border:1.5px solid var(--border);
  border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite}
.tour-loading span{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}

.tour-scene-badge{position:absolute;top:20px;left:24px;z-index:10;
  background:rgba(0,0,0,0.72);border:1px solid var(--border);padding:12px 18px;pointer-events:none}
.tour-scene-badge__counter{font-size:8px;letter-spacing:4px;text-transform:uppercase;
  color:rgba(201,169,110,0.5);margin-bottom:4px}
.tour-scene-badge__name{font-family:'Cormorant',serif;font-size:22px;font-weight:700;
  color:var(--white);letter-spacing:-0.3px}

.tour-drag-hint{position:absolute;bottom:160px;left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:10px;padding:10px 22px;
  background:rgba(0,0,0,0.6);border:1px solid var(--border);
  font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);
  pointer-events:none;transition:opacity 0.6s;white-space:nowrap;z-index:10}
.tour-drag-hint.hidden{opacity:0}

.tour-zoom{position:absolute;right:24px;top:50%;transform:translateY(-50%);
  display:flex;flex-direction:column;gap:4px;z-index:10}
.tour-zoom-btn{width:38px;height:38px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;color:var(--dim);
  background:rgba(0,0,0,0.72);transition:var(--t);font-size:18px;line-height:1;font-weight:300}
.tour-zoom-btn:hover{border-color:var(--gold);color:var(--gold)}

.tour-controls{flex-shrink:0;background:rgba(6,5,4,0.96);border-top:1px solid var(--border);z-index:10}
.tour-nav-row{display:flex;align-items:center;gap:0;border-bottom:1px solid var(--border)}
.tour-arrow{width:52px;height:44px;border-right:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;color:var(--dim);
  transition:var(--t);flex-shrink:0}
.tour-arrow:last-of-type{border-right:none;border-left:1px solid var(--border)}
.tour-arrow:hover:not([disabled]){color:var(--gold);background:rgba(201,169,110,0.07)}
.tour-arrow[disabled]{opacity:0.22;cursor:not-allowed}
.tour-arrow svg{width:15px;height:15px}
.tour-progress-wrap{flex:1;padding:0 20px;display:flex;align-items:center;gap:16px}
.tour-progress-track{flex:1;height:1px;background:var(--border);position:relative}
.tour-progress-fill{position:absolute;left:0;top:0;height:100%;background:var(--gold);transition:width 0.4s}
.tour-progress-label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);white-space:nowrap}

.tour-block-tabs{display:flex;overflow-x:auto;border-bottom:1px solid var(--border);scrollbar-width:none}
.tour-block-tabs::-webkit-scrollbar{display:none}
.tour-block-tab{flex-shrink:0;padding:10px 22px;font-size:9px;font-weight:500;
  letter-spacing:2.5px;text-transform:uppercase;color:rgba(242,236,226,0.22);
  border-right:1px solid var(--border);transition:all 0.2s;cursor:pointer;
  display:flex;align-items:center;gap:8px}
.tour-block-tab:last-child{border-right:none}
.tour-block-tab:hover{color:var(--dim);background:rgba(255,255,255,0.025)}
