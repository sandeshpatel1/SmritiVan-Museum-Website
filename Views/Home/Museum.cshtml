.btn-gold{background:var(--gold);color:#000;border:1px solid var(--gold)}
.btn-gold:hover{background:var(--gold-lt);border-color:var(--gold-lt);transform:translateY(-2px);
  box-shadow:0 12px 32px rgba(201,169,110,0.25)}

