/* INAUGURATION */
.inaug{padding:120px 80px;background:var(--bg);position:relative;overflow:hidden}
.inaug::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 80% at 70% 50%,rgba(201,169,110,0.05) 0%,transparent 60%);
  pointer-events:none}
.inaug__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:88px;align-items:center}
.inaug__date-card{background:var(--bg2);border:1px solid var(--border);padding:32px 36px;
  display:flex;align-items:center;gap:28px;margin:28px 0 32px}
.inaug__day{font-family:'Cormorant',serif;font-size:76px;font-weight:700;color:var(--white);
  line-height:0.85;letter-spacing:-3px}
.inaug__month{font-family:'Cormorant',serif;font-size:26px;font-weight:400;color:var(--gold);display:block}
.inaug__year{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--dim);display:block;margin-top:5px}
.inaug__quote{font-family:'Cormorant',serif;font-size:clamp(16px,1.8vw,21px);
  font-style:italic;color:rgba(242,236,226,0.55);line-height:1.85;
  border-left:2px solid var(--gold);padding-left:22px;margin-bottom:16px}
.inaug__attr{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold)}
.inaug__note{font-size:13px;font-weight:300;color:var(--dim);line-height:1.85;margin-top:22px}
.inaug__img-wrap{position:relative}
.inaug__img-wrap::after{content:'';position:absolute;top:-16px;right:-16px;
  width:160px;height:160px;border:1px solid var(--border);pointer-events:none}
.inaug__img-wrap img{width:100%;height:560px;object-fit:cover;object-position:top;filter:brightness(0.85)}
.inaug__plaque{position:absolute;bottom:-18px;left:-18px;background:var(--gold);
  color:#000;padding:18px 24px;z-index:2}
.inaug__plaque strong{display:block;font-family:'Cormorant',serif;font-size:17px;font-weight:700;line-height:1.2}
.inaug__plaque span{font-size:9px;letter-spacing:2px;text-transform:uppercase;opacity:0.65;margin-top:4px;display:block}

/* VISITOR INFO */
.vinfo{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:64px 80px}
.vinfo__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr;gap:44px;align-items:start}
.vinfo__div{background:var(--border);height:100%;min-height:80px}
.vinfo__label{font-size:8.5px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:16px}
.vinfo__title{font-family:'Cormorant',serif;font-size:21px;color:var(--white);margin-bottom:10px}
.vinfo__detail{font-size:13px;font-weight:300;color:var(--dim);line-height:1.85}
.closed-badge{display:inline-block;margin-top:8px;font-size:9.5px;letter-spacing:2px;
  text-transform:uppercase;color:#d96060;border:1px solid rgba(217,96,96,0.25);padding:3px 12px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;font-size:10px;
