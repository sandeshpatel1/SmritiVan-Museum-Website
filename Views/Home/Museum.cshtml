      { name:'Earthquake Simulator', file:'Scene 1' },
      { name:'7.7 Magnitude Tremor', file:'Scene 2' },
      { name:'Simulation Chamber',   file:'Scene 3' },
      { name:'Tree of Smritivan',    file:'Scene 4' }
    ]
  },
  { num:7, tag:'Block Seven', title:'Renew',      folder:'Block 7',
    desc:'Visitors light a digital flame through touch panels \u2014 it travels through LED walls to the ceiling, forming one united light. India\u2019s highest concentration of optical fibre sensor-based lighting in a single location, projecting a beam across Bhuj as an eternal homage to the 13,000 lives lost.',
    pts:['Touch-activated digital flame \u2014 a personal act of remembrance','India\u2019s highest concentration of optical fibre sensor lighting','A united beam of light visible across the city of Bhuj'],
    scenes:[
      { name:'Digital Flame Wall', file:'Scene 1' }
    ]
  }
];

var ACCENTS = ['#7a2d4a','#1e7a4e','#a03d22','#1e5580','#b8932a','#8b2d2d','#2a6045'];

function pad(n){ return String(n).padStart(2,'0'); }

/*
 * scenePath — builds the URL to the 360 image.
 * Uses @Url.Content to get the app-root-relative base,
 * then appends folder + exact filename.
 * Result: /SmritivanApp/assets/Block/Scene 1.jpg
 */
var ASSETS_BASE = '@Url.Content("~/assets/")';

function scenePath(folder, sceneFile){
  return ASSETS_BASE + encodeURIComponent(folder) + '/' + encodeURIComponent(sceneFile) + '.jpg';
}

/* ═══════════ RENDER BLOCKS HTML ═══════════ */
function renderBlocks(){
  var root = document.getElementById('blocks-root');
  var html = '';
  BLOCKS.forEach(function(b, i){
    var flip  = i % 2 === 1;
    var fc    = flip ? ' block--flip' : '';
    var rv    = flip ? 'reveal-r' : 'reveal-l';
    var rc    = flip ? 'reveal-l' : 'reveal-r';
    var acDir = flip ? 'right:0;border-radius:2px 0 0 2px' : 'left:0;border-radius:0 2px 2px 0';
    var ac    = ACCENTS[i];
    var numStr = pad(b.num);

    var thumbs = b.scenes.map(function(s, si){
      return '<div class="scene-thumb' + (si === 0 ? ' active' : '') + '" data-bn="' + b.num + '" data-si="' + si + '">'
        + '<div class="scene-dot"></div>'
        + '<span class="scene-thumb-label">' + s.name + '</span>'
        + '</div>';
    }).join('');

    var pts = b.pts.map(function(p){ return '<div class="block__pt">' + p + '</div>'; }).join('');

    html += '<article class="block block--' + b.num + fc + '">'
      + '<div class="block__badge">' + numStr + '</div>'
      + '<div class="viewer-wrap ' + rv + '">'
        + '<div style="position:absolute;top:0;bottom:0;width:3px;z-index:3;background:linear-gradient(to bottom,' + ac + ',' + ac + '99);' + acDir + '"></div>'
        + '<div class="pano-container" id="pano-' + b.num + '">'
          + '<canvas class="pano-canvas" id="canvas-' + b.num + '"></canvas>'
          + '<div class="pano-loading" id="pload-' + b.num + '"><div class="pano-spinner"></div><span>Loading</span></div>'
          + '<div class="pano-badge"><div class="pano-badge-ring">360\u00b0</div><span>360\u00b0 View</span></div>'
          + '<div class="drag-hint" id="hint-' + b.num + '">\u2190 Drag to explore \u2192</div>'
          + '<div class="pano-scene-info" id="pinfo-' + b.num + '">'
            + '<div class="pano-scene-info__counter">01 / ' + pad(b.scenes.length) + '</div>'
            + '<div class="pano-scene-info__name">' + b.scenes[0].name + '</div>'
          + '</div>'
        + '</div>'
        + '<div class="scene-strip"><div class="scene-strip-inner" id="strip-' + b.num + '">' + thumbs + '</div></div>'
      + '</div>'
      + '<div class="block__content ' + rc + '">'
        + '<div class="block__num">' + numStr + '</div>'
        + '<div class="block__tag">' + b.tag + '</div>'
        + '<h2 class="block__title">' + b.title + '</h2>'
        + '<p class="block__body">' + b.desc + '</p>'
        + '<div class="block__pts">' + pts + '</div>'
        + '<button class="tour-btn" onclick="window.openTour(' + b.num + ',0)">'
          + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>'
          + 'Explore This Block in Full 360\u00b0'
        + '</button>'
      + '</div>'
    + '</article>';
  });
  root.innerHTML = html;
}

/* ═══════════ MINI VIEWERS ═══════════ */
var miniV = {};

function makeMini(bn){
  var b      = BLOCKS[bn - 1];
  var canvas = document.getElementById('canvas-' + bn);
  var cont   = document.getElementById('pano-' + bn);
  if (!canvas || !cont) return;

  var w = cont.clientWidth  || 600;
  var h = cont.clientHeight || 460;

  var ren = new THREE.WebGLRenderer({ canvas: canvas, antialias: false });
  ren.setPixelRatio(Math.min(devicePixelRatio, 1.5));
  ren.setSize(w, h);

  var sc  = new THREE.Scene();
  var cam = new THREE.PerspectiveCamera(75, w / h, 0.1, 1000);
  cam.position.set(0, 0, 0.001);

  var geo = new THREE.SphereGeometry(500, 48, 32);
  geo.scale(-1, 1, 1);
  var mat = new THREE.MeshBasicMaterial({ color: 0x111111 });
  sc.add(new THREE.Mesh(geo, mat));

  var lon = 0, lat = 0, drag = false, px = 0, py = 0, auto = true;
  var loadEl = document.getElementById('pload-' + bn);
  var hintEl = document.getElementById('hint-' + bn);
  var infoEl = document.getElementById('pinfo-' + bn);

  function loadS(si){
    if (loadEl) loadEl.classList.remove('hidden');
    var scene = b.scenes[si];
    if (infoEl){
      infoEl.querySelector('.pano-scene-info__counter').textContent = pad(si + 1) + ' / ' + pad(b.scenes.length);
      infoEl.querySelector('.pano-scene-info__name').textContent    = scene.name;
    }
    var strip = document.getElementById('strip-' + bn);
    if (strip) strip.querySelectorAll('.scene-thumb').forEach(function(t, i){ t.classList.toggle('active', i === si); });

    var url = scenePath(b.folder, scene.file);
    new THREE.TextureLoader().load(
      url,
      function(tex){
        tex.minFilter    = THREE.LinearFilter;
        mat.map          = tex;
        mat.color.set(0xffffff);
        mat.needsUpdate  = true;
        if (loadEl) loadEl.classList.add('hidden');
      },
      undefined,
      function(err){
        console.warn('[Smritivan] Mini failed:', url, err);
        if (loadEl) loadEl.classList.add('hidden');
      }
    );
  }

  (function loop(){
    requestAnimationFrame(loop);
    if (auto && !drag) lon += 0.03;
    lat = Math.max(-85, Math.min(85, lat));
    var phi = THREE.MathUtils.degToRad(90 - lat);
    var th  = THREE.MathUtils.degToRad(lon);
    cam.lookAt(500 * Math.sin(phi) * Math.cos(th), 500 * Math.cos(phi), 500 * Math.sin(phi) * Math.sin(th));
    ren.render(sc, cam);
  })();

  new ResizeObserver(function(){
    var nw = cont.clientWidth, nh = cont.clientHeight;
    ren.setSize(nw, nh); cam.aspect = nw / nh; cam.updateProjectionMatrix();
  }).observe(cont);

  canvas.addEventListener('mousedown', function(e){ drag = true; px = e.clientX; py = e.clientY; auto = false; if (hintEl) hintEl.classList.add('hidden'); });
  window.addEventListener('mousemove', function(e){ if (!drag) return; lon -= (e.clientX - px) * 0.18; lat += (e.clientY - py) * 0.18; px = e.clientX; py = e.clientY; });
  window.addEventListener('mouseup',   function(){ drag = false; });
  canvas.addEventListener('touchstart', function(e){ drag = true; px = e.touches[0].clientX; py = e.touches[0].clientY; auto = false; if (hintEl) hintEl.classList.add('hidden'); }, { passive: true });
  canvas.addEventListener('touchmove',  function(e){ if (!drag) return; lon -= (e.touches[0].clientX - px) * 0.18; lat += (e.touches[0].clientY - py) * 0.18; px = e.touches[0].clientX; py = e.touches[0].clientY; }, { passive: true });
  canvas.addEventListener('touchend',   function(){ drag = false; });
  canvas.addEventListener('wheel', function(e){ cam.fov = Math.max(30, Math.min(100, cam.fov + e.deltaY * 0.05)); cam.updateProjectionMatrix(); }, { passive: true });

  miniV[bn] = { loadScene: loadS };
  loadS(0);
}

function bindStrips(){
  document.querySelectorAll('.scene-thumb').forEach(function(t){
    t.addEventListener('click', function(){
      var bn = parseInt(this.getAttribute('data-bn'));
      var si = parseInt(this.getAttribute('data-si'));
      if (miniV[bn]) miniV[bn].loadScene(si);
    });
  });
}

function lazyMini(){
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      var bn = parseInt(e.target.id.replace('pano-', ''));
      if (!miniV[bn]) makeMini(bn);
      obs.unobserve(e.target);
    });
  }, { rootMargin: '200px' });
  for (var b = 1; b <= 7; b++){
    var el = document.getElementById('pano-' + b);
    if (el) obs.observe(el);
  }
}

/* ═══════════ FULLSCREEN TOUR ═══════════ */
var TS   = { bi: 0, si: 0, open: false };
var TR, TC, TSc, TMAT, TSPH;
var TL = 0, TLAT = 0, TDR = false, TPX = 0, TPY = 0, TAUTO = true;

function initTR(){
  if (TR) return;
  var canvas = document.getElementById('tour-canvas');
  var pano   = document.getElementById('tour-pano');
  TR = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
  TR.setPixelRatio(Math.min(devicePixelRatio, 2));
  TR.setSize(pano.clientWidth, pano.clientHeight);
  TSc = new THREE.Scene();
  TC  = new THREE.PerspectiveCamera(75, pano.clientWidth / pano.clientHeight, 0.1, 1000);
  TC.position.set(0, 0, 0.001);
  var geo = new THREE.SphereGeometry(500, 72, 48);
  geo.scale(-1, 1, 1);
  TMAT = new THREE.MeshBasicMaterial({ color: 0x111111 });
  TSPH = new THREE.Mesh(geo, TMAT);
  TSc.add(TSPH);

  canvas.addEventListener('mousedown', function(e){ TDR = true; TPX = e.clientX; TPY = e.clientY; TAUTO = false; document.getElementById('tour-drag-hint').classList.add('hidden'); });
  window.addEventListener('mousemove', function(e){ if (!TDR) return; TL -= (e.clientX - TPX) * 0.14; TLAT += (e.clientY - TPY) * 0.14; TPX = e.clientX; TPY = e.clientY; });
  window.addEventListener('mouseup',   function(){ TDR = false; });
  canvas.addEventListener('touchstart', function(e){ TDR = true; TPX = e.touches[0].clientX; TPY = e.touches[0].clientY; TAUTO = false; document.getElementById('tour-drag-hint').classList.add('hidden'); }, { passive: true });
  canvas.addEventListener('touchmove',  function(e){ if (!TDR) return; TL -= (e.touches[0].clientX - TPX) * 0.14; TLAT += (e.touches[0].clientY - TPY) * 0.14; TPX = e.touches[0].clientX; TPY = e.touches[0].clientY; }, { passive: true });
  canvas.addEventListener('touchend',   function(){ TDR = false; });
  canvas.addEventListener('wheel', function(e){ TC.fov = Math.max(28, Math.min(110, TC.fov + e.deltaY * 0.04)); TC.updateProjectionMatrix(); }, { passive: true });
  new ResizeObserver(function(){ TR.setSize(pano.clientWidth, pano.clientHeight); TC.aspect = pano.clientWidth / pano.clientHeight; TC.updateProjectionMatrix(); }).observe(pano);
  document.getElementById('tz-in').addEventListener('click',  function(){ TC.fov = Math.max(28, TC.fov - 8);  TC.updateProjectionMatrix(); });
  document.getElementById('tz-out').addEventListener('click', function(){ TC.fov = Math.min(110, TC.fov + 8); TC.updateProjectionMatrix(); });

  (function loop(){
    requestAnimationFrame(loop);
    if (TAUTO && !TDR) TL += 0.02;
    TLAT = Math.max(-85, Math.min(85, TLAT));
    var phi = THREE.MathUtils.degToRad(90 - TLAT);
    var th  = THREE.MathUtils.degToRad(TL);
    TC.lookAt(500 * Math.sin(phi) * Math.cos(th), 500 * Math.cos(phi), 500 * Math.sin(phi) * Math.sin(th));
    TR.render(TSc, TC);
  })();
}

function tLoadScene(){
  var b     = BLOCKS[TS.bi];
  var scene = b.scenes[TS.si];
  var ld    = document.getElementById('tour-loading');
  ld.classList.remove('hidden');
  var url = scenePath(b.folder, scene.file);
  new THREE.TextureLoader().load(
    url,
    function(tex){
      tex.minFilter    = THREE.LinearFilter;
      TMAT.map         = tex;
      TMAT.color.set(0xffffff);
      TMAT.needsUpdate = true;
      ld.classList.add('hidden');
    },
    undefined,
    function(err){
      console.warn('[Smritivan] Tour failed:', url, err);
      ld.classList.add('hidden');
    }
  );
  TLAT = 0; TAUTO = true;
  tUpdateUI();
}

function tUpdateUI(){
  var b     = BLOCKS[TS.bi];
  var si    = TS.si;
  var total = b.scenes.length;
  document.getElementById('tm-block-tag').textContent    = b.tag;
  document.getElementById('tm-block-title').textContent  = b.title;
  document.getElementById('tm-counter').textContent      = (si + 1) + ' / ' + total;
  document.getElementById('tm-scene-counter').textContent = pad(si + 1) + ' / ' + pad(total);
  document.getElementById('tm-scene-name').textContent    = b.scenes[si].name;
  var pct = (si / Math.max(total - 1, 1)) * 100;
  document.getElementById('tm-progress-fill').style.width  = pct + '%';
  document.getElementById('tm-progress-label').textContent = 'Scene ' + (si + 1) + ' of ' + total;
  var all = allFlat(), gi = getGI();
  document.getElementById('tm-prev').disabled = (gi === 0);
  document.getElementById('tm-next').disabled = (gi === all.length - 1);
  document.querySelectorAll('.tour-block-tab').forEach(function(t, i){ t.classList.toggle('active', i === TS.bi); });
  buildScenePills();
}

function allFlat(){
  var a = [];
  BLOCKS.forEach(function(b, bi){ b.scenes.forEach(function(s, si){ a.push({ bi: bi, si: si }); }); });
  return a;
}
function getGI(){
  var a = allFlat();
  for (var i = 0; i < a.length; i++){ if (a[i].bi === TS.bi && a[i].si === TS.si) return i; }
  return 0;
}

function buildBlockTabs(){
  var tabs = document.getElementById('tm-block-tabs');
  tabs.innerHTML = BLOCKS.map(function(b, i){
    return '<button class="tour-block-tab' + (i === TS.bi ? ' active' : '') + '" data-bi="' + i + '">'
      + '<span class="tour-block-tab__num">' + pad(b.num) + '</span>' + b.title
      + '</button>';
  }).join('');
  tabs.querySelectorAll('.tour-block-tab').forEach(function(t){
    t.addEventListener('click', function(){
      TS.bi = parseInt(this.getAttribute('data-bi')); TS.si = 0;
      tLoadScene();
    });
  });
}

function buildScenePills(){
  var b   = BLOCKS[TS.bi];
  var row = document.getElementById('tm-scene-row');
  row.innerHTML = b.scenes.map(function(s, si){
    return '<button class="tour-scene-pill' + (si === TS.si ? ' active' : '') + '" data-si="' + si + '">' + s.name + '</button>';
  }).join('');
  row.querySelectorAll('.tour-scene-pill').forEach(function(p){
    p.addEventListener('click', function(){ TS.si = parseInt(this.getAttribute('data-si')); tLoadScene(); });
  });
  var active = row.querySelector('.active');
  if (active) active.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
}

function tNav(dir){
  var all = allFlat(), gi = getGI() + dir;
  if (gi < 0 || gi >= all.length) return;
  TS.bi = all[gi].bi; TS.si = all[gi].si;
  tLoadScene();
  document.querySelectorAll('.tour-block-tab').forEach(function(t, i){ t.classList.toggle('active', i === TS.bi); });
}

window.openTour = function(blockNum, si){
  TS.bi = blockNum - 1; TS.si = si || 0; TS.open = true;
  document.getElementById('tour-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('tour-drag-hint').classList.remove('hidden');
  initTR();
  buildBlockTabs();
  tLoadScene();
};

document.getElementById('tour-close').addEventListener('click', function(){
  document.getElementById('tour-modal').classList.remove('open');
  document.body.style.overflow = '';
  TS.open = false;
});
document.getElementById('tm-prev').addEventListener('click', function(){ tNav(-1); });
document.getElementById('tm-next').addEventListener('click', function(){ tNav(1); });
document.addEventListener('keydown', function(e){
  if (!TS.open) return;
  if (e.key === 'Escape')                              document.getElementById('tour-close').click();
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') tNav(1);
  if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   tNav(-1);
});

/* ═══════════ SCROLL REVEAL ═══════════ */
function initReveal(){
  var els = document.querySelectorAll('.reveal,.reveal-l,.reveal-r');
  var io  = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.06 });
  els.forEach(function(el){ io.observe(el); });
}

/* ═══════════ BOOT ═══════════ */
renderBlocks();
bindStrips();
lazyMini();
initReveal();

})();
</script>
}
