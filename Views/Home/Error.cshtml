@{
    ViewData["Title"] = "Error";
}

<main style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24px;padding:80px 24px;text-align:center;">
    <h1 style="font-family:'Cormorant',serif;font-size:clamp(48px,8vw,80px);color:var(--color-white,#f2ece2);">Something went wrong</h1>
    <p style="color:rgba(255,255,255,0.5);max-width:480px;line-height:1.8;">We're sorry — an unexpected error occurred. Please try again or return to the homepage.</p>
    <a href="/Home/Index" style="display:inline-flex;align-items:center;gap:8px;padding:12px 32px;background:#c9a96e;color:#000;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;text-decoration:none;">← Back to Home</a>
</main>
