/* ═══════════════════════════════════════════
   STATE
═══════════════════════════════════════════ */
var currentLang  = 'English';
var allTracks    = [];
var flatList     = [];
var currentIdx   = -1;
var isPlaying    = false;
var isShuffle    = false;
var isRepeat     = false;
var audio        = document.getElementById('audio');

/* ── Header scroll ── */
window.addEventListener('scroll', function() {
  document.getElementById('hdr').classList.toggle('scrolled', scrollY > 40);
}, {passive:true});

/* ── Hamburger ── */
var ham = document.getElementById('ham-btn'),
    mob = document.getElementById('mob-nav'),
    ov  = document.getElementById('mob-ov'),
    cl  = document.getElementById('mob-close');
function openNav()  { mob.classList.add('open'); ov.classList.add('open'); document.body.style.overflow='hidden'; }
function closeNav() { mob.classList.remove('open'); ov.classList.remove('open'); document.body.style.overflow=''; }
ham.addEventListener('click', openNav);
ov.addEventListener('click', closeNav);
cl.addEventListener('click', closeNav);

/* ═══════════════════════════════════════════
   GET TRACKS FOR LANGUAGE
═══════════════════════════════════════════ */
function getTracksForLang(lang) {
  return RAW_TRACKS
    .filter(function(t) { return t.lang === lang; })
    .map(function(t) {
      t._section  = sectionById(t.Audio_no);
      t._audioUrl = buildAudioUrl(t.Path, t.Description);
      return t;
    })
    .sort(function(a,b) { return a.pk - b.pk; });
}

/* ═══════════════════════════════════════════
   LANGUAGE SELECTION
═══════════════════════════════════════════ */
window.selectLang = function(lang, btn) {
  if (lang === currentLang) return;
  currentLang = lang;
  document.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  stopAudio();
  currentIdx = -1;
  showEmpty();
  initTracks(lang);
};

function initTracks(lang) {
  allTracks = getTracksForLang(lang);
  flatList  = allTracks.slice();
  renderSidebar(flatList, null);
}

/* ═══════════════════════════════════════════
   RENDER SIDEBAR
═══════════════════════════════════════════ */
function renderSidebar(tracks, openSectionId) {
  var container = document.getElementById('track-sections');
  if (!tracks || !tracks.length) {
    container.innerHTML = '<div style="padding:40px 24px;text-align:center;font-size:13px;color:var(--dim2)">No tracks found.</div>';
    return;
  }
  var groups = {};
  SECTIONS.forEach(function(s) { groups[s.id] = []; });
  tracks.forEach(function(t) {
    var sid = t._section || sectionById(t.Audio_no);
    if (!groups[sid]) groups[sid] = [];
    groups[sid].push(t);
  });

  var html = '';
  SECTIONS.forEach(function(sec, si) {
    var secTracks = groups[sec.id] || [];
    var isOpen = openSectionId ? sec.id === openSectionId : si === 0;
    html += '<div class="section-group' + (isOpen?' open':'') + '" id="sg-' + sec.id + '">';
    html += '<div class="section-group__hd" onclick="toggleSection(\'' + sec.id + '\')">';
    html += '<div><div class="section-group__label">' + esc(sec.label) + '</div>'
          + '<div class="section-group__title">' + esc(sec.title) + '</div></div>';
    html += '<div style="display:flex;align-items:center;gap:10px">'
          + '<span class="section-group__count">' + secTracks.length + ' tracks</span>'
          + '<svg class="section-group__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>'
          + '</div></div>';
    html += '<div class="section-group__tracks">';
    if (!secTracks.length) {
      html += '<div style="padding:16px 24px"><p class="ctext-none">No tracks in this section.</p></div>';
    } else {
      secTracks.forEach(function(t) {
        var globalIdx = flatList.indexOf(t);
        var isActive  = globalIdx !== -1 && globalIdx === currentIdx;
        var playing   = isActive && isPlaying;
        var displayName = t.Display_name || t.Description || ('Track ' + t.pk);
        html += '<div class="track-item' + (isActive?' active':'') + (playing?' playing':'') + '" '
              + 'data-gidx="' + globalIdx + '" onclick="selectTrack(' + globalIdx + ')">';
        html += '<span class="track-num">' + String(t.pk).padStart(2,'0') + '</span>';
        html += '<div class="track-info">'
              + '<div class="track-name">' + esc(displayName) + '</div>';
        if (t.Introduction) {
          html += '<div class="track-sub">' + esc(t.Introduction.substring(0,60)) + (t.Introduction.length>60?'…':'') + '</div>';
        }
        html += '</div>'
              + '<div class="track-bars"><span></span><span></span><span></span></div>'
              + '</div>';
      });
    }
    html += '</div></div>';
  });
  container.innerHTML = html;
}

window.toggleSection = function(id) {
  var el = document.getElementById('sg-' + id);
  if (el) el.classList.toggle('open');
};

/* ═══════════════════════════════════════════
   SEARCH
═══════════════════════════════════════════ */
window.doSearch = function(q) {
  q = q.trim().toLowerCase();
  var openEl = document.querySelector('.section-group.open');
  var openSec = openEl ? openEl.id.replace('sg-','') : null;
  flatList = !q ? allTracks.slice() : allTracks.filter(function(t) {
    return (t.Display_name||'').toLowerCase().indexOf(q)!==-1
        || (t.Introduction||'').toLowerCase().indexOf(q)!==-1
        || (t.Content||'').toLowerCase().indexOf(q)!==-1;
  });
  renderSidebar(flatList, openSec);
};

/* ═══════════════════════════════════════════
   SELECT & PLAY TRACK
═══════════════════════════════════════════ */
window.selectTrack = function(idx) {
  if (idx<0 || idx>=flatList.length) return;
  currentIdx = idx;
  var track = flatList[idx];
  var sec   = sectionMeta(track._section || sectionById(track.Audio_no));
  renderSidebar(flatList, sec.id);
  showPlayer(track, sec);
  loadAndPlayAudio(track);
  setTimeout(function() {
    var el = document.querySelector('.track-item.active');
    if (el) el.scrollIntoView({block:'nearest', behavior:'smooth'});
  }, 80);
};

/* ═══════════════════════════════════════════
   PLAYER UI
═══════════════════════════════════════════ */
function showPlayer(track, sec) {
  document.getElementById('player-empty').style.display = 'none';
  document.getElementById('player-loaded').classList.add('show');
  setAudioStatus('','');
  var displayName = track.Display_name || track.Description || ('Track ' + track.pk);
  document.getElementById('pl-img').src = sec.image;
  document.getElementById('pl-section-badge').textContent = sec.title;
  document.getElementById('pl-lang-badge').textContent = currentLang;
  document.getElementById('pl-num').textContent = 'Track ' + String(track.pk).padStart(2,'0');
  document.getElementById('pl-title').textContent = displayName;
  document.getElementById('tab-intro').innerHTML = formatText(track.Introduction)
    || '<p class="ctext-none">No introduction available for this track.</p>';
  document.getElementById('tab-script').innerHTML = formatText(track.Content)
    || '<p class="ctext-none">Full script not available for this track.</p>';
  document.getElementById('npb-thumb').src = sec.image;
  document.getElementById('npb-name').textContent = displayName;
  document.getElementById('npb-sec').textContent = sec.title + ' · ' + currentLang;
  document.getElementById('npbar').classList.add('show');
}

function showEmpty() {
  document.getElementById('player-empty').style.display = '';
  document.getElementById('player-loaded').classList.remove('show');
  document.getElementById('npbar').classList.remove('show');
}

function formatText(txt) {
  if (!txt || !txt.trim()) return '';
  return txt.split('\n').map(function(l){return l.trim();}).filter(function(l){return l.length>0;})
    .map(function(l){return '<p class="ctext">'+esc(l)+'</p>';}).join('');
}

function setAudioStatus(type, msg) {
  var el = document.getElementById('audio-status');
  el.className = 'audio-status' + (type?' '+type:'');
  el.textContent = msg;
}

/* ═══════════════════════════════════════════
   AUDIO ENGINE — direct URL, no proxy
═══════════════════════════════════════════ */
function loadAndPlayAudio(track) {
  audio.pause();
  audio.src = '';
  setPlaying(false);
  resetProgress();

  var url = track._audioUrl;

  if (!url) {
    setAudioStatus('no-audio','⚠ No audio file path for this track.');
    document.getElementById('btn-play').disabled = true;
    return;
  }

  console.log('🎵 Playing:', url);
  setAudioStatus('loading','Loading audio…');
  document.getElementById('btn-play').disabled = false;

  audio.src = url;
  audio.load();
  audio.play()
    .then(function() { setPlaying(true); setAudioStatus('',''); })
    .catch(function(err) {
      console.warn('Play failed:', err.message, url);
      setAudioStatus('error','⚠ Audio could not be played. The script is still available below.');
      setPlaying(false);
    });
}

function stopAudio() {
  audio.pause(); audio.src='';
  setPlaying(false); resetProgress(); setAudioStatus('','');
}

function resetProgress() {
  ['progress-fill','npb-fill'].forEach(function(id){document.getElementById(id).style.width='0%';});
  ['progress-input','npb-input'].forEach(function(id){document.getElementById(id).value=0;});
  ['pl-cur','npb-cur','pl-dur','npb-dur'].forEach(function(id){document.getElementById(id).textContent='0:00';});
}

var PLAY_ICON  = '<polygon points="6,4 20,12 6,20"/>';
var PAUSE_ICON = '<rect x="5" y="4" width="4" height="16"/><rect x="15" y="4" width="4" height="16"/>';

function setPlaying(v) {
  isPlaying = v;
  document.getElementById('play-icon').innerHTML     = v ? PAUSE_ICON : PLAY_ICON;
  document.getElementById('npb-play-icon').innerHTML = v ? PAUSE_ICON : PLAY_ICON;
  document.querySelectorAll('.track-item').forEach(function(el) {
    var gi = parseInt(el.getAttribute('data-gidx'));
    el.classList.toggle('playing', v && gi===currentIdx);
  });
}

window.togglePlay = function() {
  if (currentIdx<0) return;
  if (isPlaying) { audio.pause(); setPlaying(false); }
  else { audio.play().catch(function(){}); setPlaying(true); }
};

window.nextTrack = function() {
  if (!flatList.length) return;
  var next = isShuffle ? Math.floor(Math.random()*flatList.length) : (currentIdx+1)%flatList.length;
  selectTrack(next);
};

window.prevTrack = function() {
  if (!flatList.length) return;
  if (audio.currentTime>3) { audio.currentTime=0; return; }
  selectTrack((currentIdx-1+flatList.length)%flatList.length);
};

window.toggleShuffle = function() {
  isShuffle=!isShuffle;
  document.getElementById('btn-shuffle').classList.toggle('on',isShuffle);
};

window.toggleRepeat = function() {
  isRepeat=!isRepeat;
  audio.loop=isRepeat;
  document.getElementById('btn-repeat').classList.toggle('on',isRepeat);
};

window.setVol = function(v) { audio.volume=v/100; };

window.closePlayer = function() {
  stopAudio(); currentIdx=-1;
  renderSidebar(flatList,null); showEmpty();
};

/* Progress */
audio.addEventListener('timeupdate', function() {
  if (!audio.duration || !isFinite(audio.duration)) return;
  var pct = (audio.currentTime/audio.duration)*100;
  document.getElementById('progress-fill').style.width=pct+'%';
  document.getElementById('progress-thumb').style.left=pct+'%';
  document.getElementById('npb-fill').style.width=pct+'%';
  document.getElementById('progress-input').value=pct;
  document.getElementById('npb-input').value=pct;
  var c=fmt(audio.currentTime);
  document.getElementById('pl-cur').textContent=c;
  document.getElementById('npb-cur').textContent=c;
});

audio.addEventListener('loadedmetadata', function() {
  var d=fmt(audio.duration);
  document.getElementById('pl-dur').textContent=d;
  document.getElementById('npb-dur').textContent=d;
});

audio.addEventListener('ended', function() { if (!isRepeat) { setPlaying(false); nextTrack(); } });

audio.addEventListener('error', function() {
  var msg='⚠ Audio file could not be loaded.';
  if (audio.error) {
    if (audio.error.code===2) msg+=' (Network error — the file may not exist at this URL)';
    if (audio.error.code===4) msg+=' (File not found or format not supported)';
  }
  msg+=' You can still read the script below.';
  setAudioStatus('error', msg);
  setPlaying(false);
  document.getElementById('btn-play').disabled=false;
});

audio.addEventListener('canplay', function() {
  setAudioStatus('','');
  document.getElementById('btn-play').disabled=false;
});

document.getElementById('progress-input').addEventListener('input', function() {
  if (audio.duration) audio.currentTime=(this.value/100)*audio.duration;
});

window.seekBar = function(el) {
  if (audio.duration) audio.currentTime=(el.value/100)*audio.duration;
};

window.switchTab = function(name, btn) {
  document.querySelectorAll('.ctab').forEach(function(b){b.classList.remove('active');});
  document.querySelectorAll('.cpane').forEach(function(p){p.classList.remove('active');});
  btn.classList.add('active');
  var pane=document.getElementById('tab-'+name);
  if (pane) pane.classList.add('active');
};

document.addEventListener('keydown', function(e) {
  if (e.target.tagName==='INPUT') return;
  if (e.code==='Space')     { e.preventDefault(); togglePlay(); }
  if (e.code==='ArrowRight') nextTrack();
  if (e.code==='ArrowLeft')  prevTrack();
});

function fmt(s) {
  if (!s||!isFinite(s)) return '0:00';
  var m=Math.floor(s/60), sc=Math.floor(s%60);
  return m+':'+(sc<10?'0':'')+sc;
}

function esc(s) {
  return !s?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* BOOT */
initTracks('English');

})();
</script>
}