@{
    ViewData["Title"] = "Museum Tour";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#070503;color:#e8e0d0;overflow-x:hidden;line-height:1.6}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}
    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f0e8d8;--dim:rgba(240,232,216,0.45);--dim2:rgba(240,232,216,0.22);
      --faint:rgba(240,232,216,0.04);--border:rgba(201,169,110,0.14);
      --bg:#070503;--bg2:#0d0a07;--t:0.35s cubic-bezier(0.4,0,0.2,1);
    }

       /* ══ HEADER ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo { display:flex;align-items:center;gap:12px; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
    .hdr__link:hover { color:var(--white); }
    .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

    /* ══ HERO ══ */
    .hero{position:relative;height:62vh;min-height:480px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center 30%;filter:brightness(0.5) saturate(0.8)}
    .hero__ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(7,5,3,1) 0%,rgba(7,5,3,0.55) 45%,rgba(7,5,3,0.1) 100%)}
    .hero__accent{position:absolute;top:0;left:0;bottom:0;width:3px;background:linear-gradient(to bottom,transparent 0%,var(--gold) 30%,var(--gold) 70%,transparent 100%);z-index:3}
    .hero__content{position:relative;z-index:2;padding:110px 60px 20px 110px;max-width:860px}
    .hero__kicker{display:flex;align-items:center;gap:14px;font-size:10px;font-weight:500;letter-spacing:5px;text-transform:uppercase;color:var(--gold);margin-bottom:16px;opacity:0;animation:aUp 1s 0.2s forwards}
    .hero__kicker::before{content:'';display:block;width:36px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(48px,7vw,96px);font-weight:700;color:var(--white);line-height:0.9;letter-spacing:-2px;margin-bottom:20px;opacity:0;animation:aUp 1s 0.4s forwards}
    .hero__sub{font-size:14px;font-weight:300;color:var(--dim);line-height:1.85;max-width:500px;opacity:0;animation:aUp 1s 0.6s forwards;padding-left:20px;border-left:1px solid rgba(201,169,110,0.25)}
    @@keyframes aUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* ══ CTRL STRIP ══ */
    .ctrl-strip{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 80px;display:flex;align-items:stretch;position:sticky;top:64px;z-index:50;flex-wrap:wrap}
    .ctrl-strip__lang{display:flex;align-items:center;border-right:1px solid var(--border);padding-right:20px;gap:4px;flex-shrink:0}
    .ctrl-strip__lang-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--dim2);margin-right:10px;white-space:nowrap}
    .lang-btn{padding:16px 18px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim2);border-bottom:2px solid transparent;margin-bottom:-1px;transition:color 0.2s,border-color 0.2s;white-space:nowrap}
    .lang-btn:hover{color:var(--white)}
    .lang-btn.active{color:var(--gold);border-bottom-color:var(--gold)}
    .ctrl-strip__search{flex:1;display:flex;align-items:center;padding:0 24px;gap:12px;min-width:200px}
    .ctrl-strip__search svg{color:var(--dim2);flex-shrink:0;width:15px;height:15px}
    .ctrl-strip__search input{flex:1;background:none;border:none;outline:none;color:var(--white);font-family:'DM Sans',sans-serif;font-size:13px;padding:16px 0}
    .ctrl-strip__search input::placeholder{color:var(--dim2)}

    /* ══ PAGE WRAP ══ */
    .page-wrap{display:grid;grid-template-columns:320px 1fr;min-height:calc(100vh - 64px - 54px);padding-bottom:80px}

    /* ══ SIDEBAR ══ */
    .sidebar{background:var(--bg2);border-right:1px solid var(--border);position:sticky;top:calc(64px + 54px);height:calc(100vh - 64px - 54px);overflow:hidden;display:flex;flex-direction:column}
    .sidebar__sections{flex:1;overflow-y:auto;padding:8px 0}
    .sidebar__sections::-webkit-scrollbar{width:4px}
    .sidebar__sections::-webkit-scrollbar-thumb{background:rgba(201,169,110,0.18);border-radius:2px}

    .section-group{}
    .section-group__hd{padding:16px 24px 10px;border-bottom:1px solid rgba(201,169,110,0.06);cursor:pointer;display:flex;align-items:center;justify-content:space-between;user-select:none;transition:background 0.2s}
    .section-group__hd:hover{background:var(--faint)}
    .section-group.open .section-group__hd{background:rgba(201,169,110,0.05)}
    .section-group__label{font-size:8px;letter-spacing:3.5px;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:3px}
    .section-group__title{font-family:'Cormorant',serif;font-size:16px;font-weight:700;color:var(--white);line-height:1}
    .section-group__count{font-size:10px;color:var(--dim2);flex-shrink:0}
    .section-group__chevron{width:16px;height:16px;color:var(--dim2);transition:transform 0.3s;flex-shrink:0}
    .section-group.open .section-group__chevron{transform:rotate(180deg)}
    .section-group__tracks{display:none}
    .section-group.open .section-group__tracks{display:block}

    .track-item{display:flex;align-items:center;gap:12px;padding:12px 24px;cursor:pointer;border-left:3px solid transparent;transition:background 0.2s,border-color 0.2s}
    .track-item:hover{background:var(--faint)}
    .track-item.active{background:rgba(201,169,110,0.06);border-left-color:var(--gold)}
    .track-num{font-size:10px;color:var(--dim2);min-width:22px;text-align:right;font-variant-numeric:tabular-nums}
    .track-item.active .track-num{color:var(--gold)}
    .track-info{flex:1;min-width:0}
    .track-name{font-size:13px;font-weight:500;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}
    .track-item.active .track-name,.track-item:hover .track-name{color:var(--white)}
    .track-sub{font-size:11px;color:var(--dim2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
    .track-bars{display:none;align-items:flex-end;gap:2px;height:14px;flex-shrink:0}
    .track-item.playing .track-bars{display:flex}
    .track-bars span{display:block;width:3px;background:var(--gold);border-radius:1px;animation:barBounce 0.7s ease-in-out infinite alternate}
    .track-bars span:nth-child(1){height:5px;animation-delay:0s}
    .track-bars span:nth-child(2){height:12px;animation-delay:0.12s}
    .track-bars span:nth-child(3){height:8px;animation-delay:0.24s}
    @@keyframes barBounce{from{transform:scaleY(0.35)}to{transform:scaleY(1)}}

    /* ══ PLAYER PANEL ══ */
    .player-panel{display:flex;flex-direction:column;background:var(--bg)}
    .player-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60px 40px;gap:20px;min-height:400px}
    .player-empty__ring{width:88px;height:88px;border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold)}
    .player-empty__title{font-family:'Cormorant',serif;font-size:28px;font-weight:600;color:var(--white)}
    .player-empty__sub{font-size:13px;color:var(--dim2);max-width:280px;line-height:1.75}
    .player-loaded{display:none;flex-direction:column;flex:1}
    .player-loaded.show{display:flex}

    .player-img-wrap{position:relative;height:340px;overflow:hidden;flex-shrink:0}
    .player-img-wrap img{width:100%;height:100%;object-fit:cover;filter:brightness(0.5) saturate(0.7)}
    .player-img-ov{position:absolute;inset:0;background:linear-gradient(to top,var(--bg) 0%,rgba(7,5,3,0.5) 50%,rgba(7,5,3,0.1) 100%)}
    .player-section-badge{position:absolute;top:24px;left:28px;background:rgba(7,5,3,0.75);border:1px solid rgba(201,169,110,0.25);padding:5px 14px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);backdrop-filter:blur(8px)}
    .player-lang-badge{position:absolute;top:24px;right:28px;background:rgba(7,5,3,0.75);border:1px solid var(--border);padding:5px 12px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);backdrop-filter:blur(8px)}
    .player-img-content{position:absolute;bottom:0;left:0;right:0;padding:28px}
    .player-track-num{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:6px;font-weight:600}
    .player-track-title{font-family:'Cormorant',serif;font-size:clamp(24px,3vw,40px);font-weight:700;color:var(--white);line-height:1.05}

    .audio-status{margin:0 32px 0;padding:10px 16px;font-size:12px;border-radius:2px;display:none}
    .audio-status.error{display:block;background:rgba(180,60,40,0.12);border:1px solid rgba(180,60,40,0.25);color:rgba(240,180,160,0.8)}
    .audio-status.loading{display:block;background:rgba(201,169,110,0.08);border:1px solid rgba(201,169,110,0.2);color:var(--gold)}
    .audio-status.no-audio{display:block;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--dim2)}

    .player-ctrl{padding:28px 32px 20px;border-bottom:1px solid rgba(201,169,110,0.07)}
    .progress-wrap{margin-bottom:8px;position:relative}
    .progress-track{width:100%;height:3px;background:rgba(255,255,255,0.07);border-radius:2px;position:relative;cursor:pointer}
    .progress-fill{position:absolute;left:0;top:0;height:100%;background:var(--gold);border-radius:2px;pointer-events:none;transition:width 0.1s linear}
    .progress-thumb{position:absolute;top:50%;width:13px;height:13px;border-radius:50%;background:var(--gold);transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 0 8px rgba(201,169,110,0.5);opacity:0;transition:opacity 0.2s}
    .progress-track:hover .progress-thumb{opacity:1}
    .progress-input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;margin:0}
    .times{display:flex;justify-content:space-between;font-size:11px;color:var(--dim2);font-variant-numeric:tabular-nums;margin-bottom:22px}
    .ctrl-btns{display:flex;align-items:center;justify-content:center;gap:16px}
    .ctrl-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);transition:var(--t)}
    .ctrl-btn:hover{border-color:var(--gold);color:var(--white);background:rgba(201,169,110,0.08)}
    .ctrl-btn.on{border-color:var(--gold);color:var(--gold);background:rgba(201,169,110,0.08)}
    .ctrl-btn svg{width:16px;height:16px}
    .ctrl-btn--play{width:60px;height:60px;background:var(--gold);color:#000;border-color:var(--gold)}
    .ctrl-btn--play:hover{background:var(--gold-lt);border-color:var(--gold-lt);transform:scale(1.05);box-shadow:0 10px 30px rgba(201,169,110,0.3)}
    .ctrl-btn--play svg{width:20px;height:20px}
    .ctrl-btn--play:disabled{opacity:0.4;cursor:not-allowed;transform:none}
    .vol-row{display:flex;align-items:center;gap:12px;margin-top:18px}
    .vol-icon{color:var(--dim2);flex-shrink:0;width:16px;height:16px}
    .vol-slider{flex:1;-webkit-appearance:none;height:2px;background:rgba(255,255,255,0.07);outline:none;cursor:pointer}
    .vol-slider::-webkit-slider-thumb{-webkit-appearance:none;width:11px;height:11px;border-radius:50%;background:var(--gold);cursor:pointer}

    .ctabs{display:flex;border-bottom:1px solid var(--border);padding:0 32px}
    .ctab{padding:16px 22px;font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--dim2);border-bottom:2px solid transparent;margin-bottom:-1px;transition:color 0.2s,border-color 0.2s}
    .ctab.active{color:var(--gold);border-bottom-color:var(--gold)}
    .cbody{padding:32px;flex:1;overflow-y:auto}
    .cbody::-webkit-scrollbar{width:4px}
    .cbody::-webkit-scrollbar-thumb{background:rgba(201,169,110,0.15);border-radius:2px}
    .cpane{display:none}
    .cpane.active{display:block}
    .ctext{font-size:14px;line-height:1.9;color:rgba(240,232,216,0.65);font-weight:300}
    .ctext p{margin-bottom:14px}
    .ctext-none{font-size:13px;color:var(--dim2);font-style:italic}

    /* ══ NOW PLAYING BAR ══ */
    .npbar{position:fixed;bottom:0;left:0;right:0;z-index:200;background:rgba(7,5,3,0.97);border-top:1px solid var(--border);backdrop-filter:blur(20px);padding:12px 40px;display:none;align-items:center;gap:20px}
    .npbar.show{display:flex}
    .npbar__thumb{width:44px;height:44px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)}
    .npbar__info{flex:1;min-width:0}
    .npbar__name{font-size:13px;font-weight:500;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .npbar__sec{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-top:2px}
    .npbar__prog{flex:2;display:flex;flex-direction:column;gap:4px}
    .npbar__track{width:100%;height:2px;background:rgba(255,255,255,0.08);border-radius:1px;position:relative;cursor:pointer}
    .npbar__fill{position:absolute;left:0;top:0;height:100%;background:var(--gold);border-radius:1px;transition:width 0.1s linear}
    .npbar__input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;margin:0}
    .npbar__times{display:flex;justify-content:space-between;font-size:9px;color:var(--dim2);font-variant-numeric:tabular-nums}
    .npbar__btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);transition:var(--t);flex-shrink:0}
    .npbar__btn:hover{border-color:var(--gold);color:var(--white)}
    .npbar__btn.play{background:var(--gold);color:#000;border-color:var(--gold)}
    .npbar__btn.play:hover{background:var(--gold-lt)}
    .npbar__btn svg{width:16px;height:16px}
    .npbar__close{color:var(--dim2);transition:color 0.2s}
    .npbar__close:hover{color:var(--white)}

    /* ══ FOOTER — matches index.html exactly ══ */
    .ftr{background:#000;border-top:1px solid var(--border);padding:72px 80px 36px}
    .ftr__grid{max-width:1200px;margin:0 auto}
    .ftr__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:52px;
      padding-bottom:52px;border-bottom:1px solid var(--border);margin-bottom:28px}
    .ftr__brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .ftr__brand-logo img{width:30px}
    .ftr__brand-logo strong{font-family:'Cormorant',serif;font-size:17px;color:var(--white);font-weight:600;letter-spacing:1px}
    .ftr__brand p{font-size:12.5px;color:rgba(255,255,255,0.25);line-height:1.75;font-weight:300}
    .ftr__partners{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
    .ftr__partners a{filter:none;opacity:0.9;transition:opacity 0.2s}
    .ftr__partners a:hover{opacity:0.6}
    .ftr__col h4{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
    .ftr__col a{display:block;font-size:12.5px;color:rgba(255,255,255,0.25);padding:5px 0;transition:color 0.15s,padding-left 0.2s}
    .ftr__col a:hover{color:var(--white);padding-left:6px}
    .ftr__bot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
      gap:10px;font-size:11px;color:rgba(255,255,255,0.16)}
    .ftr__bot a{color:rgba(255,255,255,0.2);transition:color 0.15s}
    .ftr__bot a:hover{color:var(--white)}
    .ftr__atm{color:var(--gold)!important;font-weight:500}
    .ftr__atm:hover{color:var(--gold-lt)!important}

    @@media(max-width:1024px){
      .page-wrap{grid-template-columns:1fr}
      .sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--border)}
      .sidebar__sections{max-height:360px}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}.ham{display:flex}
      .hdr,.ctrl-strip,.ftr{padding-left:24px;padding-right:24px}
      .hero__content{padding:0 24px 48px}
      .player-ctrl{padding:24px}
      .cbody{padding:24px}
      .npbar{padding:12px 20px;gap:12px}
      .npbar__prog{display:none}
      .ftr{padding:48px 24px 28px}
      .ftr__top{grid-template-columns:1fr;gap:28px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
    @@media(max-width:480px){
      .ctrl-strip{flex-direction:column;align-items:stretch}
      .ctrl-strip__lang{border-right:none;border-bottom:1px solid var(--border);padding:0}
      .lang-btn{padding:12px 16px}
    }
</style>
}

<main>
<div class="mob-ov" id="mob-ov"></div>
<aside class="mob-nav" id="mob-nav">
  <div class="mob-nav__hd"><img src="https://www.smritivanearthquakemuseum.biz/assets2/logo.png" alt="" width="30"/><button class="mob-nav__close" id="mob-close">&times;</button></div>
  <nav class="mob-nav__links">
    <a href="/Home/Index">Home</a><a href="/Home/Museum">Earthquake Museum</a>
    <a href="/Home/Gallery">Gallery</a><a href="/Home/Events">Events</a>
    <a href="/Home/MuseumTour" class="active">Audio Guide</a>
    <a href="/Home/Amenities">Amenities</a><a href="/Home/Faq">FAQ</a><a href="/Home/Contact">Contact</a>
    <a href="https://smritivanearthquakemuseum.biz/MobileNumber.aspx" target="_blank">Book Tickets</a>
  </nav>
  <div class="mob-nav__foot">
    <a href="https://www.instagram.com/smritivanearthquakemuseum/" target="_blank">Instagram</a>
    <a href="https://www.facebook.com/SmritivanEarthquakeMuseum/" target="_blank">Facebook</a>
  </div>
</aside>

<section class="hero">
  <div class="hero__bg">
