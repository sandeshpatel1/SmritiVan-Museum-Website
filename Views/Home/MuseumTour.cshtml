  <button class="npbar__btn npbar__close" onclick="closePlayer()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
</div>
</main>

@section Scripts {
<audio id="audio" preload="none"></audio>

<script>
(function(){
'use strict';

/* ═══════════════════════════════════════════
   AUDIO BASE URL
═══════════════════════════════════════════ */
var AUDIO_BASE = 'https://www.smritivanearthquakemuseum.biz/';

/* ═══════════════════════════════════════════
   BUILD DIRECT AUDIO URL (no proxy needed)
   URL pattern:
   BASE + path_segments_encoded + "/" + description + ".mp3"
   Spaces → %20, & stays as & (server accepts literal &)
═══════════════════════════════════════════ */
function buildAudioUrl(path, description) {
  if (!path || !description) return null;
  var encodedPath = path.trim().split('/').map(function(seg) {
    return seg.trim().replace(/ /g, '%20');
  }).join('/');
  var encodedFile = description.trim().replace(/ /g, '%20') + '.mp3';
  return AUDIO_BASE + encodedPath + '/' + encodedFile;
}

/* ═══════════════════════════════════════════
   SECTION META
═══════════════════════════════════════════ */
var SECTIONS = [
  { id:'rebirth',    audioNo:1, label:'Block One',   title:'Rebirth',
    image:'https://www.smritivanearthquakemuseum.biz/assets2/audio1image.png' },
  { id:'rediscover', audioNo:2, label:'Block Two',   title:'Rediscover',
    image:'https://www.smritivanearthquakemuseum.biz/assets2/audio2image.png' },
  { id:'restore',    audioNo:3, label:'Block Three', title:'Restore',
    image:'https://www.smritivanearthquakemuseum.biz/assets2/insta1.jpeg' },
  { id:'rebuild',    audioNo:4, label:'Block Four',  title:'Rebuild',
    image:'https://www.smritivanearthquakemuseum.biz/assets2/DJI_0960-Enhanced-2%20.jpg' }
];

function sectionById(audioNo) {
  var n = parseInt(audioNo);
  if (n===1) return 'rebirth';
  if (n===2) return 'rediscover';
  if (n===3) return 'restore';
  if (n===4) return 'rebuild';
  return 'rebirth';
}
function sectionMeta(id) {
  for (var i=0;i<SECTIONS.length;i++) { if (SECTIONS[i].id===id) return SECTIONS[i]; }
  return SECTIONS[0];
}

/* ═══════════════════════════════════════════
   ALL TRACKS DATABASE (embedded — no proxy)
   Fields: pk, lang, Description, Path, Introduction, Content, Audio_no, Display_name, pknum
═══════════════════════════════════════════ */
var RAW_TRACKS = [
  /* ── ENGLISH TRACKS ── */
  {pk:1,lang:'English',Description:'E001 Introduction- Rebirth',Path:'VO & Script for Gallery Locators/English VO',Introduction:'This is the Rebirth Block. In this block, we will explore the history of Earth\'s evolution, how the world around us has come to be. You will witness the emergence of landforms over millions of years and the genesis of the world we inhabit. You will also get a glimpse of the prosperous and powerful ancient human civilizations in the Kutch Region and the tales of its advancement and resilience.',Content:'Block Introduction- Rebirth\nWelcome to the Rebirth block.\nHere we witness the history of Earth\'s evolution, the emergence of landforms over millions of years and the genesis of the very land we inhabit. Visitors get a glimpse of prosperous ancient human civilizations in the Kutch region, the tale of its advancement and resilience.',Audio_no:1,Display_name:'1. Introduction- Rebirth'},
  {pk:2,lang:'English',Description:'E002 Nomenclature Changing Panorama',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this Changing Panorama gallery, you will observe the way our planet Earth gradually evolved from an uninhabitable planet to the only life-supporting planet in the cosmos.',Content:'Nomenclature: Changing Panorama\nSince when has the Earth been changing?\nOur planet Earth has gradually evolved from being an uninhabitable ball of fire to the only known life-supporting planet in the cosmos.',Audio_no:1,Display_name:'2. Nomenclature - Changing Panaroma'},
  {pk:3,lang:'English',Description:'E003 Shell Artwork explanation',Path:'VO & Script for Gallery Locators/English VO',Introduction:'The artwork that you see here has been created using applique, a traditional craft form from the Kutch region.',Content:'The artwork here is created using applique, a traditional craft form from the Kutch region. It depicts our eternally changing world.',Audio_no:1,Display_name:'3. Shell Artwork explanation'},
  {pk:4,lang:'English',Description:'E004 Nomenclature- Real-time Observatory',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this real time observatory, you will observe the natural phenomena of climate and tectonics in real time.',Content:'Real-time Observatory\nWind, Temperature and Vibrations are relentless forces of nature that hold sway over the entire planet.',Audio_no:1,Display_name:'4. Nomenclature- Real-time Observatory'},
  {pk:5,lang:'English',Description:'E005 Nomenclature- Measuring Temperature',Path:'VO & Script for Gallery Locators/English VO',Introduction:'This creative installation displays the current temperature of our surroundings.',Content:'Measuring Temperature\nThis installation displays the current temperature of our surroundings. Notice the difference in minimum and maximum temperature, known as diurnal range.',Audio_no:1,Display_name:'5. Nomenclature- Measuring Temperature'},
  {pk:6,lang:'English',Description:'E006 Nomenclature- Witnessing Wind',Path:'VO & Script for Gallery Locators/English VO',Introduction:'Through this installation/Wind Sculpture, you will be able to witness the way wind works in real time.',Content:'Witnessing Wind\nThe movement seen in the above sculpture is due to the kinetic energy of wind.',Audio_no:1,Display_name:'6. Nomenclature- Witnessing Wind'},
  {pk:7,lang:'English',Description:'E007 Nomenclature- Our Evolving Planet',Path:'VO & Script for Gallery Locators/English VO',Introduction:'We live on an ever-evolving planet! Planet Earth has been evolving ever since it came into existence some 4.5 billion years ago.',Content:'Our Evolving Planet\nHow well do you know about Planet Earth?\nPlanet Earth has been evolving since it came into existence over 4.5 billion years ago.',Audio_no:1,Display_name:'7. Nomenclature- Our Evolving Planet'},
  {pk:8,lang:'English',Description:'E008 Ramp models EXPLANATION AND INTRO',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section, the models will acquaint you with Earth and its unique geological features.',Content:'In this section get to know trivia/facts about the Earth and its unique geological features.',Audio_no:1,Display_name:'8. Ramp models EXPLANATION AND INTRO'},
  {pk:9,lang:'English',Description:'E009 Artefacts Display Panels',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section, you will be able to view various artefacts and learn some more facts about Planet Earth.',Content:'Artefacts Display Panels\nHow hot is the centre of the earth?\nEarth\'s inner core is believed to have temperature similar to the surface of the Sun.',Audio_no:1,Display_name:'9. Artefacts Display Panels'},
  {pk:10,lang:'English',Description:'E010 TOPIC- Layered Earth',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this interactive model, you will be able to explore the various layers of the earth.',Content:'TOPIC: Layered Earth\nThe layers of Earth -the crust, the mantle, and the core are the result of elemental distribution processes.',Audio_no:1,Display_name:'10. TOPIC- Layered Earth'},
  {pk:11,lang:'English',Description:'E011 Instructions- Push the lever to view the plate boundaries of Earth-',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this interactive model, you will learn more about plate tectonics.',Content:'Plate Tectonics\nPlate tectonics is the theory that states that the Earth\'s outer shell, the lithosphere is divided into large slabs of solid rock.',Audio_no:1,Display_name:'11. Instructions- Push the lever to view the plate boundaries of Earth-'},
  {pk:12,lang:'English',Description:'E012 TOPIC- Movement of Earth\'s crust',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this interactive model, you will gain more information about plate boundaries.',Content:'Movement of Earth\'s crust\nSections of the lithosphere, or plates, roughly fit together and meet at places called plate boundaries.',Audio_no:1,Display_name:'12. TOPIC- Movement of Earth\'s crust'},
  {pk:13,lang:'English',Description:'E013 Nomenclature- Discover Fossils',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this gallery, we invite you to dig deeper into the fascinating world of soil and discover fossils belonging to the Kutch region.',Content:'Discover Fossils\nThis gallery invites you to dig deeper into the fascinating soil world to discover fossils.',Audio_no:1,Display_name:'13. Nomenclature- Discover Fossils'},
  {pk:14,lang:'English',Description:'E014 Ichthyosaur',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section, you shall see the rare fossil of an Ichthyosaur, a fish-reptile.',Content:'The rare fossil of Ichthyosaur, a fish-reptile, was found near Lodai village, Kutch in 2016 and it is dated to be over 152 million years old.',Audio_no:1,Display_name:'14. Ichthyosaur'},
  {pk:15,lang:'English',Description:'E015 FOSSIL EXCAVATION COURTYARD',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section, you shall also learn about other fossils such as Sea Cow, Ammonites and Ptilophyllum.',Content:'FOSSIL EXCAVATION COURTYARD\nIchthyosaur\nSea Cow\nAmmonites\nPtilophyllum',Audio_no:1,Display_name:'15. FOSSIL EXCAVATION COURTYARD'},
  {pk:16,lang:'English',Description:'E016 C5 C3C5 C 3.9 Fossils (Artifacts)',Path:'VO & Script for Gallery Locators/English VO',Introduction:'The fossils that you see here have been excavated from the Kutch region and show how the landforms shifted over time.',Content:'Fossils (Artifacts)\nThese fossils are excavated from the Kutch region and they show the shifts in landforms over time.',Audio_no:1,Display_name:'16. Fossils (Artifacts)'},
  {pk:17,lang:'English',Description:'E017 Fossils Artafacts',Path:'VO & Script for Gallery Locators/English VO',Introduction:'Through this Applique Artwork, you shall understand the story of evolution in the plant and animal kingdoms.',Content:'The story of evolution in the plant and animal kingdoms is depicted through this applique artwork.',Audio_no:1,Display_name:'17. Fossils Artafacts'},
  {pk:18,lang:'English',Description:'E018 Inner Globe Installation- Rift formation',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this Inner Globe installation, you will understand about faults and rift formations.',Content:'Understanding Faults\nA fault is a fracture or zone of fractures between two blocks of rocks.',Audio_no:1,Display_name:'18. Inner Globe Installation- Rift formation'},
  {pk:19,lang:'English',Description:'E019 Gallery Introduction- Human evolution, civilization of settlements, adaptation to the conditions, and flourishing through trade.-',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this gallery, you will explore the history of human evolution and the civilization of settlements.',Content:'Human evolution, civilization of settlements, adaptation to the conditions, and flourishing through trade.',Audio_no:1,Display_name:'19. Gallery Introduction- Human evolution, civilization of settlements, adaptation to the conditions, and flourishing through trade.-'},
  {pk:20,lang:'English',Description:'E020 Nomenclature- Land of Migrations and Movements',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this gallery, you will be able to observe centuries worth of human endeavour and evolution.',Content:'How have cultures flourished?\nThe gallery showcases centuries\' old human endeavor and evolution.',Audio_no:1,Display_name:'20. Nomenclature- Land of Migrations and Movements'},
  {pk:21,lang:'English',Description:'E021 Trade Map Installation- Trade map panel',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this Trade Map Installation, you will be able to see prominent trade routes during the Indus Valley civilization.',Content:'Trade as Testimony\nThis map displays prominent trade routes with objects that were traded in the Indus Valley civilization.',Audio_no:1,Display_name:'21. Trade Map Installation- Trade map panel'},
  {pk:22,lang:'English',Description:'E022 Artifacts Display Unit',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this gallery, you will see various artefacts collected from the Indus Valley Civilization.',Content:'An Evolving Civilization\nIn this gallery, you will see various artefacts collected from the Indus Valley Civilization.',Audio_no:1,Display_name:'22. Artifacts Display Unit Nomenclature an evolving Civilization'},
  {pk:23,lang:'English',Description:'E023 Tools for Survival',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you can see some of the earliest tools the humans used for survival.',Content:'Tools for Survival\nEarly traces of settlements around Gujarat have revealed primitive tools and stone blades known as Microliths.',Audio_no:1,Display_name:'23. Tools for Survival'},
  {pk:24,lang:'English',Description:'E024 Pottery for Food',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will observe the various kinds of pots that were made during this period through clay pottery.',Content:'Pottery for Food\nDifferent types of pots began to be made with clay pottery.',Audio_no:1,Display_name:'24. Pottery for Food'},
  {pk:25,lang:'English',Description:'E025 Agriculture and Animal Husbandry-',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will explore how Harappans grew ancient varieties of wheat, barley, pulses, rice, sesame and linseed.',Content:'Agriculture and Animal Husbandry\nHarappans grew ancient varieties of wheat, barley, pulses, rice, sesame and linseed.',Audio_no:1,Display_name:'25. Agriculture and Animal Husbandry-'},
  {pk:26,lang:'English',Description:'E026 Sophisticated Building Systems',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will explore the sophisticated and advanced culture of buildings, citadels, water channels and docks.',Content:'Sophisticated Building Systems\nAn advanced culture of buildings, citadels, water-channels and docks is found across Lothal, Dholavira and Mohenjo Daro.',Audio_no:1,Display_name:'26. Sophisticated Building Systems'},
  {pk:27,lang:'English',Description:'E027 Processing Raw Materials',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will explore the nature of raw materials in the Indus Valley Civilizations.',Content:'Processing Raw Materials\nRaw materials like semi-precious stones, metal ores, clays and shells were an important currency for trade and expansion.',Audio_no:1,Display_name:'27. Processing Raw Materials'},
  {pk:28,lang:'English',Description:'E028 Land and Water Transpor',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will understand how the Indus valley civilization had well developed routes for trade.',Content:'Land and Water Transport\nThe transport of raw materials and finished goods for trade was done through land, river and maritime routes.',Audio_no:1,Display_name:'28. Land and Water Transpor'},
  {pk:29,lang:'English',Description:'E029 Weights for Trade',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will get to see the precise weights and measures, made of stone.',Content:'Weights for Trade\nAn important aspect of internal trade was the use of precise weights and measures, made of stones.',Audio_no:1,Display_name:'29. Weights for Trade'},
  {pk:30,lang:'English',Description:'E030 Seals for Trade',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this unit, you will see seals that were used to stamp bags or packets containing traded goods.',Content:'Seals for Trade\nSeals, such as those found at Dholavira, have been used to stamp bags or packets containing traded goods.',Audio_no:1,Display_name:'30. Seals for Trade'},
  {pk:31,lang:'English',Description:'E031 C7 Gallery Introduction',Path:'VO & Script for Gallery Locators/English VO',Introduction:'This gallery takes you into the Indus Valley Civilization, through its settlements and resilient building systems.',Content:'This gallery takes you into the IndusValley Civilization, through its settlements and resilient building systems.',Audio_no:1,Display_name:'31. Gallery Introduction'},
  {pk:32,lang:'English',Description:'E032 Nomenclature- Culture of Resilience',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this Site Model Gallery, you will witness the embodiment of human resilience.',Content:'Culture of Resilience\nHow have civilizations adapted and evolved?',Audio_no:1,Display_name:'32. Nomenclature- Culture of Resilience'},
  {pk:33,lang:'English',Description:'E033 C7 Artwork explanation',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section we see the artwork that depicts the dynamic landscape around us.',Content:'Artwork explanation\nThe artwork depicts the dynamic landscape around us, along with the evolution of various life-forms.',Audio_no:1,Display_name:'33. Artwork Explanation'},
  {pk:34,lang:'English',Description:'E034 Exit Panel- Conclusion to C-Block, D block intro',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this block, you witnessed the history of the earth, how it formed and the natural forces.',Content:'Conclusion to C-Block, D block intro\nAfter experiencing the richness offered by the Rebirth block, we move to the Rediscover block.',Audio_no:1,Display_name:'34. Exit Panel- Conclusion to C-Block, D block intro'},
  /* ── REDISCOVER ── */
  {pk:35,lang:'English',Description:'E035 D(A) BLOCK  D1 Rediscover Block',Path:'VO & Script for Gallery Locators/English VO',Introduction:'Welcome to the Rediscover block. In this block, you will discover the diverse natural features of Gujarat.',Content:'Rediscover Block\nWelcome to the Rediscover block.\nLet\'s discover the diverse natural features of Gujarat.',Audio_no:2,Display_name:'35. Introduction (Rediscover Block)'},
  {pk:36,lang:'English',Description:'E036 D1 D1.6 Triangular unit (small)- Introductory gallery panel Nomenclature- Understanding the Region\'s Landscape',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this gallery, you will understand why Gujarat is so vulnerable to natural occurrences.',Content:'Understanding the Region\'s Landscape\nWhy is Gujarat vulnerable to natural occurrences?',Audio_no:2,Display_name:'36. Triangular unit (small)- Introductory gallery panel Nomenclature- Understanding the Region\'s Landscape'},
  {pk:37,lang:'English',Description:'E037 D1 D1.5 Artwork explanation',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this section we witness how using the layering and motifs of traditional block printing, this artwork depicts the vast landscapes of Gujarat.',Content:'Artwork explanation\nUsing the layering and motifs of traditional block printing, the artwork depicts the vast landscapes of Gujarat.',Audio_no:2,Display_name:'37. Artwork explanation'},
  {pk:38,lang:'English',Description:'E038 Gallery Introduction Nomenclature- An Experiment in Transience  -',Path:'VO & Script for Gallery Locators/English VO',Introduction:'In this experiment, we observe here the slow yet persistent effects of wind, water and vibrations on three pieces of rock.',Content:'An Experiment in Transience\nEverything in our world is constantly acted upon by forces of nature.',Audio_no:2,Display_name:'38. Gallery Introduction Nomenclature- An Experiment in Transience  -'},
  {pk:39,lang:'English',Description:'E039 D3 Nomenclature- Decoding Natural Occurrences',Path:'VO & Script for Gallery Locators/English VO',Introduction:'This gallery unearths the science behind these frequently occurring natural events.',Content:'Decoding Natural Occurrences\nAfter exploring natural hazard related vulnerabilities faced by the Gujarat region.',Audio_no:2,Display_name:'39. Nomenclature- Decoding Natural Occurrences'},
