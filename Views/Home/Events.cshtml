@{
    ViewData["Title"] = "Events";
}

@section Styles {
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:#060504;color:#e4ddd0;overflow-x:hidden;line-height:1.6}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none}

    :root{
      --gold:#c9a96e;--gold-lt:#e8d5a3;--gold-dk:#9a7a47;
      --white:#f2ece2;--dim:rgba(242,236,226,0.45);--faint:rgba(242,236,226,0.04);
      --border:rgba(201,169,110,0.12);--t:0.35s cubic-bezier(0.4,0,0.2,1);
      --bg:#060504;--bg2:#0a0807;
    }

        /* ══ HEADER ══ */
    .hdr { position:fixed;top:0;left:0;right:0;z-index:900;height:68px;padding:0 48px;display:flex;align-items:center;transition:background var(--t),border-color var(--t);border-bottom:1px solid transparent; }
    .hdr.scrolled { background:rgba(0,0,0,0.95);border-bottom-color:var(--border);backdrop-filter:blur(20px); }
    .hdr__inner { width:100%;max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between; }
    .hdr__logo { display:flex;align-items:center;gap:12px; }
    .hdr__logo img { width:38px;height:38px;object-fit:contain; }
    .hdr__wordmark { font-family:'Cormorant',serif;font-size:22px;font-weight:600;color:var(--white);letter-spacing:2px; }
    .hdr__nav { display:flex;align-items:center; }
    .hdr__link { color:var(--dim);font-size:12.5px;font-weight:400;padding:8px 13px;letter-spacing:0.3px;transition:color var(--t); }
    .hdr__link:hover { color:var(--white); }
    .hdr__link.active { color:var(--white); border-bottom: 1px solid var(--gold); }
    .hdr__btn { background:var(--gold);color:#000;font-size:11px;font-weight:600;padding:9px 22px;letter-spacing:1.5px;text-transform:uppercase;transition:background var(--t),transform var(--t);margin-left:12px; }
    .hdr__btn:hover { background:var(--gold-lt);transform:translateY(-1px); }
    .hdr__drop { position:relative; }
    .hdr__drop-menu { position:absolute;top:calc(100% + 8px);left:0;background:#090909;border:1px solid var(--border);min-width:200px;padding:6px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s; }
    .hdr__drop.open .hdr__drop-menu { opacity:1;pointer-events:all;transform:translateY(0); }
    .hdr__drop-item { display:block;padding:10px 16px;font-size:13px;color:var(--dim);transition:background 0.2s,color 0.2s; }
    .hdr__drop-item:hover { background:var(--faint);color:var(--white); }
    .ham { display:none;flex-direction:column;gap:5px;padding:8px; }
    .ham span { display:block;width:22px;height:1.5px;background:var(--white);transition:var(--t); }
    .mob-ov { position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .mob-ov.open { opacity:1;pointer-events:all; }
    .mob-nav { position:fixed;top:0;right:0;bottom:0;width:300px;background:#050505;border-left:1px solid var(--border);z-index:1100;transform:translateX(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column; }
    .mob-nav.open { transform:translateX(0); }
    .mob-nav__hd { display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border); }
    .mob-nav__close { font-size:24px;color:var(--dim); }
    .mob-nav__links { flex:1;overflow-y:auto;padding:12px 0; }
    .mob-nav__links a { display:block;padding:13px 24px;color:var(--dim);font-size:14px;border-bottom:1px solid rgba(255,255,255,0.04);transition:color 0.2s,padding-left 0.2s; }
    .mob-nav__links a:hover { color:var(--white);padding-left:32px; }
    .mob-nav__links a.active { color:var(--white); }
    .mob-nav__foot { padding:20px 24px;border-top:1px solid var(--border);display:flex;gap:20px; }
    .mob-nav__foot a { color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase;transition:color 0.2s; }
    .mob-nav__foot a:hover { color:var(--gold); }

    /* ══ HERO ══ */
    .hero{position:relative;height:70vh;min-height:500px;display:flex;overflow:hidden}
    .hero__bg{position:absolute;inset:0}
    .hero__bg img{width:100%;height:100%;object-fit:cover;object-position:center;
      transform:scale(1.06);animation:heroZoom 12s ease-out forwards}
    @@keyframes heroZoom{from{transform:scale(1.06)}to{transform:scale(1)}}
    .hero__ov{position:absolute;inset:0;
      background:linear-gradient(170deg,rgba(6,5,4,0.3) 0%,rgba(6,5,4,0.65) 50%,rgba(6,5,4,0.97) 100%)}
    .hero__line{position:absolute;left:56px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent 0%,var(--gold) 25%,rgba(201,169,110,0.3) 75%,transparent 100%);z-index:2}
    .hero__scroll-indicator{position:absolute;bottom:0;left:57px;transform:translateX(-50%);
      width:1px;height:64px;background:linear-gradient(to bottom,var(--gold),transparent);z-index:3;
      animation:pulse 2.5s ease-in-out infinite}
    @@keyframes pulse{0%,100%{opacity:1;transform:translateX(-50%) scaleY(1)}50%{opacity:0.2;transform:translateX(-50%) scaleY(0.4)}}
    .hero__content{position:relative;z-index:3;padding:110px 60px 20px 110px;max-width:900px}
    .hero__kicker{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;
      color:var(--gold);margin-bottom:20px;display:flex;align-items:center;gap:16px;
      opacity:0;animation:fadeUp 0.9s 0.2s forwards}
    .hero__kicker::before{content:'';width:32px;height:1px;background:var(--gold)}
    .hero__title{font-family:'Cormorant',serif;font-size:clamp(56px,8vw,112px);
      font-weight:700;line-height:0.88;letter-spacing:-3px;color:var(--white);
      margin-bottom:26px;opacity:0;animation:fadeUp 1s 0.4s forwards}
    .hero__title em{display:block;font-style:italic;font-weight:300;font-size:0.48em;
      letter-spacing:4px;color:rgba(201,169,110,0.75);margin-bottom:10px}
    .hero__desc{font-size:14px;font-weight:300;color:var(--dim);line-height:1.9;
      max-width:500px;opacity:0;animation:fadeUp 0.9s 0.65s forwards;
      padding-left:22px;border-left:1px solid rgba(201,169,110,0.25)}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:translateY(0)}}

    /* ══ UTILS ══ */
    .tag{font-size:9px;font-weight:500;letter-spacing:5px;text-transform:uppercase;
      color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:16px}
    .tag::before{content:'';width:24px;height:1px;background:var(--gold)}
    .sec-title{font-family:'Cormorant',serif;font-size:clamp(32px,4.5vw,56px);
      font-weight:700;color:var(--white);line-height:0.95;letter-spacing:-0.5px}
    .rule{width:40px;height:1px;background:var(--gold);margin:20px 0 28px}
    .reveal{opacity:0;transform:translateY(32px);transition:opacity 0.85s ease,transform 0.85s ease}
    .reveal.in{opacity:1;transform:none}

    /* ══ EVENTS SECTION ══ */
    .events-body{padding:0 0 120px;background:var(--bg)}
    .events-inner{max-width:100%;margin:0 auto}

    /* ── Header with tabs ── */
    .events-header{
      padding:72px 80px 56px;
      display:flex;align-items:flex-end;justify-content:space-between;
      flex-wrap:wrap;gap:32px;
      border-bottom:1px solid var(--border);
      margin-bottom:0;
    }
    .ev-tabs{display:flex;gap:0;border:1px solid var(--border)}
    .ev-tab{padding:12px 32px;font-size:10px;font-weight:500;letter-spacing:2.5px;
      text-transform:uppercase;color:var(--dim);transition:all 0.25s;position:relative;
      border-right:1px solid var(--border)}
    .ev-tab:last-child{border-right:none}
    .ev-tab:hover{color:var(--white);background:var(--faint)}
    .ev-tab.active{color:var(--gold);background:rgba(201,169,110,0.07)}
    .ev-tab.active::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold)}
    .ev-tab__count{display:inline-flex;align-items:center;justify-content:center;
      width:20px;height:20px;border-radius:50%;background:var(--gold);color:#000;
      font-size:9px;font-weight:700;margin-left:8px;letter-spacing:0;
      opacity:0;transition:opacity 0.3s}
    .ev-tab.active .ev-tab__count{opacity:1}

    /* ══ CAROUSEL HERO (featured slide) ══ */
    .carousel-wrap{position:relative;overflow:hidden;background:var(--bg)}

    /* Main featured carousel */
    .carousel-main{position:relative;height:600px;overflow:hidden}
    .carousel-main__track{display:flex;height:100%;transition:transform 0.7s cubic-bezier(0.77,0,0.175,1)}
    .carousel-main__slide{
      min-width:100%;height:100%;position:relative;display:flex;align-items:flex-end;
      flex-shrink:0;
    }
    .carousel-main__slide-bg{position:absolute;inset:0;overflow:hidden}
    .carousel-main__slide-bg img{
      width:100%;height:100%;object-fit:cover;
      transition:transform 0.7s ease;filter:brightness(0.6) grayscale(8%);
    }
    .carousel-main__slide.active .carousel-main__slide-bg img{transform:scale(1.04)}
    .carousel-main__slide-ov{
      position:absolute;inset:0;
      background:linear-gradient(0deg, rgba(6,5,4,0.98) 0%, rgba(6,5,4,0.5) 45%, rgba(6,5,4,0.1) 100%);
    }
    /* Left gold accent line */
    .carousel-main__slide-line{
      position:absolute;left:80px;top:0;bottom:0;width:1px;
      background:linear-gradient(to bottom,transparent,rgba(201,169,110,0.4) 30%,rgba(201,169,110,0.15) 80%,transparent);
    }

    .carousel-main__slide-content{
      position:relative;z-index:2;padding:0 80px 60px;
      display:flex;align-items:flex-end;gap:72px;width:100%;
    }
    .cms-left{flex:1;min-width:0}
    .cms-badge{
      display:inline-flex;align-items:center;gap:10px;
      font-size:9px;font-weight:600;letter-spacing:4px;text-transform:uppercase;
      color:var(--gold);margin-bottom:20px;
    }
    .cms-badge::before{content:'';width:28px;height:1px;background:var(--gold)}
    .cms-title{
      font-family:'Cormorant',serif;font-size:clamp(36px,5vw,68px);font-weight:700;
      color:var(--white);line-height:0.95;letter-spacing:-1.5px;margin-bottom:18px;
    }
    .cms-desc{
      font-size:13.5px;font-weight:300;color:var(--dim);line-height:1.85;
      max-width:520px;padding-left:20px;border-left:1px solid rgba(201,169,110,0.2);
    }
    .cms-right{
      display:flex;flex-direction:column;align-items:flex-end;gap:24px;flex-shrink:0;
    }
    .cms-date-block{text-align:right}
    .cms-date-num{
      font-family:'Cormorant',serif;font-size:80px;font-weight:700;
      color:transparent;-webkit-text-stroke:1px rgba(201,169,110,0.25);
      line-height:0.8;letter-spacing:-3px;
    }
    .cms-date-label{
      font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;
      color:rgba(201,169,110,0.6);margin-top:4px;
    }
    .cms-cta{
      display:inline-flex;align-items:center;gap:10px;
      font-size:10px;font-weight:500;letter-spacing:2px;text-transform:uppercase;
      color:#000;background:var(--gold);padding:13px 28px;
      transition:background 0.25s,color 0.25s;
    }
    .cms-cta:hover{background:var(--gold-lt)}
    .cms-cta svg{width:13px;height:13px}

    /* Carousel nav arrows */
    .car-arrow{
      position:absolute;top:50%;z-index:10;transform:translateY(-50%);
      width:48px;height:48px;border:1px solid rgba(201,169,110,0.2);
      background:rgba(6,5,4,0.7);backdrop-filter:blur(12px);
      color:var(--gold);display:flex;align-items:center;justify-content:center;
      transition:border-color 0.2s,background 0.2s;
    }
    .car-arrow:hover{border-color:var(--gold);background:rgba(201,169,110,0.1)}
    .car-arrow--prev{left:80px}
    .car-arrow--next{right:80px}
    .car-arrow svg{width:16px;height:16px}

    /* Pagination dots + progress */
    .car-pager{
      position:absolute;bottom:28px;left:50%;transform:translateX(-50%);
      display:flex;align-items:center;gap:10px;z-index:10;
    }
    .car-dot{
      width:24px;height:2px;background:rgba(201,169,110,0.2);
      transition:background 0.3s,width 0.4s;cursor:pointer;
      position:relative;overflow:hidden;
    }
    .car-dot.active{width:48px;background:rgba(201,169,110,0.3)}
    .car-dot.active::after{
      content:'';position:absolute;inset:0;
      background:var(--gold);
      animation:dotProgress var(--auto-duration,5s) linear forwards;
    }
    @@keyframes dotProgress{from{width:0}to{width:100%}}

    /* Slide counter */
    .car-counter{
      position:absolute;top:32px;right:80px;z-index:10;
      font-family:'Cormorant',serif;font-size:18px;font-weight:700;
      color:rgba(201,169,110,0.4);letter-spacing:2px;
    }
    .car-counter span{color:var(--gold)}

    /* ══ THUMBNAIL STRIP ══ */
    .carousel-thumbs{
      background:var(--bg2);border-top:1px solid var(--border);
      padding:0 80px;
      overflow:hidden;position:relative;
    }
    .carousel-thumbs__track{
      display:flex;gap:0;
      transition:transform 0.5s cubic-bezier(0.4,0,0.2,1);
    }
    .cth{
      flex:0 0 220px;padding:20px 24px;border-right:1px solid var(--border);
      cursor:pointer;transition:background 0.25s;position:relative;
      overflow:hidden;
    }
    .cth:hover{background:rgba(201,169,110,0.04)}
    .cth.active{background:rgba(201,169,110,0.06)}
    .cth.active::before{
      content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--gold);
    }
    .cth__img{width:100%;height:100px;object-fit:cover;margin-bottom:12px;
      filter:grayscale(30%);transition:filter 0.3s}
    .cth.active .cth__img,.cth:hover .cth__img{filter:grayscale(0%)}
    .cth__date{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
    .cth__title{font-family:'Cormorant',serif;font-size:15px;font-weight:700;color:var(--white);line-height:1.2}

    /* Thumb strip nav */
    .thumb-nav{
      position:absolute;top:50%;transform:translateY(-50%);z-index:5;
      width:36px;height:36px;border:1px solid var(--border);background:rgba(6,5,4,0.9);
      color:var(--dim);display:flex;align-items:center;justify-content:center;
      transition:color 0.2s,border-color 0.2s;
    }
    .thumb-nav:hover{color:var(--gold);border-color:var(--gold)}
    .thumb-nav--prev{left:0}
    .thumb-nav--next{right:0}

    /* ══ LOADING / EMPTY ══ */
    .ev-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;
      padding:120px 24px;gap:20px}
    .ev-spinner{width:32px;height:32px;border:1.5px solid var(--border);
      border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}
    .ev-loading-txt{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--dim)}
    .ev-empty{text-align:center;padding:120px 24px}
    .ev-empty__icon{font-size:48px;margin-bottom:16px;opacity:0.15}
    .ev-empty__title{font-family:'Cormorant',serif;font-size:44px;color:rgba(255,255,255,0.08);font-weight:700;margin-bottom:12px}
    .ev-empty__sub{font-size:11px;color:rgba(255,255,255,0.18);letter-spacing:2.5px;text-transform:uppercase}

    /* ══ FOOTER ══ */
    .ftr{background:#000;border-top:1px solid var(--border);padding:72px 80px 36px}
    .ftr__grid{max-width:1200px;margin:0 auto}
    .ftr__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:52px;
      padding-bottom:52px;border-bottom:1px solid var(--border);margin-bottom:28px}
    .ftr__brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .ftr__brand-logo img{width:30px}
    .ftr__brand-logo strong{font-family:'Cormorant',serif;font-size:17px;color:var(--white);font-weight:600;letter-spacing:1px}
    .ftr__brand p{font-size:12.5px;color:rgba(255,255,255,0.25);line-height:1.75;font-weight:300}
    .ftr__partners{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
    .ftr__partners a{filter: none;}
    .ftr__partners a:hover{opacity:0.5}
    .ftr__col h4{font-size:8.5px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px}
    .ftr__col a{display:block;font-size:12.5px;color:rgba(255,255,255,0.25);padding:5px 0;transition:color 0.15s,padding-left 0.2s}
    .ftr__col a:hover{color:var(--white);padding-left:6px}
    .ftr__bot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
      gap:10px;font-size:11px;color:rgba(255,255,255,0.16)}
    .ftr__bot a{color:rgba(255,255,255,0.2);transition:color 0.15s}
    .ftr__bot a:hover{color:var(--white)}
    .ftr__atm{color:var(--gold)!important;font-weight:500}
    .ftr__atm:hover{color:var(--gold-lt)!important}

    /* ══ RESPONSIVE ══ */
    @@media(max-width:1024px){
      .carousel-main__slide-content{gap:40px}
      .cms-date-num{font-size:56px}
      .car-arrow--prev{left:24px}
      .car-arrow--next{right:24px}
      .car-counter{right:24px}
      .carousel-thumbs{padding:0 48px}
      .cth{flex:0 0 180px}
      .events-header{padding:48px 32px 40px}
      .ftr__top{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:768px){
      .hdr__nav{display:none}.ham{display:flex}
      .hero__content{padding:0 24px 56px}.hero__line{left:24px}.hero__scroll-indicator{left:24px}
      .carousel-main{height:auto;min-height:580px}
      .carousel-main__slide-content{flex-direction:column;gap:24px;padding:0 24px 56px;align-items:flex-start}
      .carousel-main__slide-line{left:24px}
      .cms-right{align-items:flex-start;flex-direction:row;align-items:center}
      .car-arrow--prev{left:12px}.car-arrow--next{right:12px}
      .car-counter{right:24px;top:20px}
      .carousel-thumbs{padding:0 36px}
      .cth{flex:0 0 150px;padding:14px 16px}
      .events-header{padding:40px 24px 32px;flex-direction:column;align-items:flex-start}
      .ftr{padding:52px 24px 28px}.ftr__top{grid-template-columns:1fr;gap:28px}
      .ftr__bot{flex-direction:column;align-items:flex-start}
    }
    @@media(max-width:480px){
      .ev-tabs{flex-direction:column}
      .ev-tab{border-right:none;border-bottom:1px solid var(--border)}
      .ev-tab:last-child{border-bottom:none}
      .cms-title{font-size:36px}
      .cth{flex:0 0 130px}
    }
</style>
}

<main>
<!-- ══ HERO ══ -->
  <section class="hero">
    <div class="hero__bg">
      <img src="./assets/bg-1.jpg" alt="Events at Smritivan" loading="eager"
           onerror="this.src='https://www.smritivanearthquakemuseum.biz/assets2/DJI_0960-Enhanced-2%20.jpg'"/>
    </div>
    <div class="hero__ov"></div>
    <div class="hero__line"></div>
    <div class="hero__scroll-indicator"></div>
    <div class="hero__content">
      <p class="hero__kicker">Smritivan Experiences</p>
      <h1 class="hero__title">
        <em>What's</em>Happening
      </h1>
      <p class="hero__desc">Festivals, forest walks, cultural evenings, and commemorations — every event at Smritivan is a living thread in the story of Kutch's resilience.</p>
    </div>
  </section>

  <!-- ══ EVENTS BODY ══ -->
  <section class="events-body">
    <div class="events-inner">

      <!-- Header with tabs -->
      <div class="events-header reveal">
        <div class="events-header__left">
          <span class="tag">Our Events</span>
          <h2 class="sec-title">Stories Worth<br>Experiencing</h2>
          <div class="rule" style="margin-top:20px;margin-bottom:0"></div>
        </div>
        <div class="ev-tabs" id="ev-tabs">
          <button class="ev-tab" data-tab="upcoming" id="tab-upcoming">
            Upcoming
            <span class="ev-tab__count" id="count-upcoming">0</span>
          </button>
          <button class="ev-tab active" data-tab="past" id="tab-past">
            Past Events
            <span class="ev-tab__count" id="count-past">0</span>
          </button>
        </div>
      </div>

      <!-- Carousel content injected here -->
      <div id="events-content">
        <div class="ev-loading">
          <div class="ev-spinner"></div>
          <div class="ev-loading-txt">Loading Events…</div>
        </div>
      </div>

    </div>
  </section>
</main>

@section Scripts {
<script>
(function(){
  'use strict';

  var BASE = 'https://www.smritivanearthquakemuseum.biz/';
  var API  = 'https://www.smritivanearthquakemuseum.biz';
  var AUTO_DURATION = 5000; // ms per slide

  /* ── HEADER ── */
  var hdr = document.getElementById('hdr');
  window.addEventListener('scroll', function(){ hdr.classList.toggle('scrolled', scrollY > 40); }, {passive:true});

  /* ── HAMBURGER ── */
  var ham = document.getElementById('ham-btn'), mob = document.getElementById('mob-nav'),
      ov = document.getElementById('mob-ov'), cl = document.getElementById('mob-close');
  function openNav(){ mob.classList.add('open'); ov.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeNav(){ mob.classList.remove('open'); ov.classList.remove('open'); document.body.style.overflow=''; }
  ham.addEventListener('click', openNav); ov.addEventListener('click', closeNav); cl.addEventListener('click', closeNav);
  mob.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', closeNav); });
  document.addEventListener('click', function(e){ var dd=document.getElementById('nd-about'); if(dd&&!dd.contains(e.target)) dd.classList.remove('open'); });

  /* ── REVEAL ── */
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold:0.06});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

  /* ── STATIC FALLBACK DATA ── */
  var PAST = [
    { title:'Christmas Party at Smritivan', date:'Dec 24, 2023',
      desc:'Join us for a spectacular Christmas bash with part of our proceeds going to charity.',
      image:'https://images.unsplash.com/photo-1512389142860-9c449e58a543?w=1400&q=85' },
    { title:'Kachh Sahitya Utsav', date:'Dec 9, 2023',
      desc:'A celebration of Kutchi literature and culture, starting at 8PM from Smritivan.',
      image:'https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1400&q=85' },
    { title:'Smritivan Deep Utsav 2023', date:'Nov 8, 2023',
      desc:'This Dhanteras, join us in lighting 51,000 diyas at Smritivan — a spectacle of light and remembrance.',
      image:'https://images.unsplash.com/photo-1580893246395-52aead8960dc?w=1400&q=85' },
    { title:"Forest Walk — World's Largest Miyawaki Forest", date:'Jun 4, 2023',
      desc:"With Dr. R.K. Nair and Mission Life Program by Gujarat Pollution Control Board.",
      image:'https://images.unsplash.com/photo-1448375240586-882707db888b?w=1400&q=85' },
    { title:'World Environment Day Celebrations', date:'Jun 2, 2023',
      desc:"A day of plantation, awareness walks, and community action at Smritivan's Miyawaki Forest.",
      image:'https://images.unsplash.com/photo-1502082553048-f009c37129b9?w=1400&q=85' },
    { title:'Shraddhanjali Walk', date:'Jan 26, 2023',
      desc:'A remembrance walk honouring the victims of the 2001 Kutch earthquake on Republic Day.',
      image:'https://images.unsplash.com/photo-1476611338391-6f395a0ebc7b?w=1400&q=85' }
  ];
  var UPCOMING = [
    { title:'Miyawaki Forest Morning Walk', date:'Apr 20, 2026',
      desc:"A guided morning walk through the verdant world's largest Miyawaki Forest with expert naturalists.",
      image:'https://images.unsplash.com/photo-1448375240586-882707db888b?w=1400&q=85' },
    { title:'World Earth Day at Smritivan', date:'Apr 22, 2026',
      desc:'Plantation drives, nature talks, and activities for all ages celebrating our planet.',
      image:'https://images.unsplash.com/photo-1508193638397-1c4234db14d8?w=1400&q=85' }
  ];

  /* ── HELPERS ── */
  function esc(s){ return !s?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function mapApiEvent(e){
    return {
      title: e.Title || e.Event_Title || '',
      date:  e.event_date || e.Event_Date || '',
      desc:  e.sub_title || e.Event_Description || '',
      image: BASE + 'event/' + (e.Event_image || e.Event_Image || '')
    };
  }

  function parseDateNum(dateStr){
    /* Extract just the day number or first digits for decoration */
    var m = String(dateStr).match(/\d+/);
    return m ? m[0] : '';
  }

  /* ── CAROUSEL STATE ── */
  var currentIdx = 0;
  var currentEvents = [];
  var currentIsUpcoming = false;
  var autoTimer = null;
  var thumbOffset = 0;
  var THUMB_W = 220; // px per thumb (must match CSS)
  var THUMB_VISIBLE = 5; // how many thumbs show

  /* ── BUILD HTML ── */
  function buildCarousel(events, isUpcoming){
    if(!events || !events.length){
      return '<div class="ev-empty">'
        +'<div class="ev-empty__icon">◎</div>'
        +'<div class="ev-empty__title">No Events</div>'
        +'<div class="ev-empty__sub">Check back soon for upcoming events</div>'
        +'</div>';
    }

    /* Main slides */
    var slides = '';
    events.forEach(function(ev, i){
      slides +=
        '<div class="carousel-main__slide'+(i===0?' active':'')+'" data-idx="'+i+'">'
          +'<div class="carousel-main__slide-bg">'
            +'<img src="'+esc(ev.image)+'" alt="'+esc(ev.title)+'" loading="'+(i===0?'eager':'lazy')+'"/>'
          +'</div>'
          +'<div class="carousel-main__slide-ov"></div>'
          +'<div class="carousel-main__slide-line"></div>'
          +'<div class="carousel-main__slide-content">'
            +'<div class="cms-left">'
              +'<div class="cms-badge">'+(isUpcoming?'Upcoming Event':'Past Event')+'</div>'
              +'<h2 class="cms-title">'+esc(ev.title)+'</h2>'
              +'<p class="cms-desc">'+esc(ev.desc)+'</p>'
            +'</div>'
            +'<div class="cms-right">'
              +'<div class="cms-date-block">'
                +'<div class="cms-date-num">'+esc(parseDateNum(ev.date))+'</div>'
                +'<div class="cms-date-label">'+esc(ev.date)+'</div>'
              +'</div>'
              +'<a href="#" class="cms-cta">Explore <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>'
            +'</div>'
          +'</div>'
        +'</div>';
    });

    /* Pagination dots */
    var dots = '';
    events.forEach(function(_, i){
      dots += '<div class="car-dot'+(i===0?' active':'')+'" data-idx="'+i+'" style="--auto-duration:'+AUTO_DURATION+'ms"></div>';
    });

    /* Thumbnails */
    var thumbs = '';
    events.forEach(function(ev, i){
      thumbs +=
        '<div class="cth'+(i===0?' active':'')+'" data-idx="'+i+'">'
          +'<img class="cth__img" src="'+esc(ev.image)+'" alt="'+esc(ev.title)+'" loading="lazy"/>'
          +'<div class="cth__date">'+esc(ev.date)+'</div>'
          +'<div class="cth__title">'+esc(ev.title)+'</div>'
        +'</div>';
    });

    return '<div class="carousel-wrap reveal">'
      /* Counter */
      +'<div class="car-counter"><span id="car-cur">01</span> / '+String(events.length).padStart(2,'0')+'</div>'
      /* Main */
      +'<div class="carousel-main" id="car-main">'
        +'<div class="carousel-main__track" id="car-track">'+slides+'</div>'
        /* Arrows */
        +'<button class="car-arrow car-arrow--prev" id="car-prev" aria-label="Previous">'
          +'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="15 18 9 12 15 6"/></svg>'
        +'</button>'
        +'<button class="car-arrow car-arrow--next" id="car-next" aria-label="Next">'
          +'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="9 6 15 12 9 18"/></svg>'
        +'</button>'
        /* Dots */
        +'<div class="car-pager" id="car-pager">'+dots+'</div>'
      +'</div>'
      /* Thumbs */
      +'<div class="carousel-thumbs">'
        +'<button class="thumb-nav thumb-nav--prev" id="thumb-prev" aria-label="Scroll thumbs left">'
          +'<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>'
        +'</button>'
        +'<div style="overflow:hidden">'
          +'<div class="carousel-thumbs__track" id="thumb-track">'+thumbs+'</div>'
        +'</div>'
        +'<button class="thumb-nav thumb-nav--next" id="thumb-next" aria-label="Scroll thumbs right">'
          +'<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>'
        +'</button>'
      +'</div>'
    +'</div>';
  }

  /* ── CAROUSEL CONTROLLER ── */
  function initCarousel(events){
    currentEvents = events;
    currentIdx = 0;
    thumbOffset = 0;

    var track   = document.getElementById('car-track');
    var pager   = document.getElementById('car-pager');
    var counter = document.getElementById('car-cur');
    var tTrack  = document.getElementById('thumb-track');

    if(!track) return;

    /* Measure thumb width from DOM */
    var firstThumb = tTrack ? tTrack.querySelector('.cth') : null;
    if(firstThumb){ THUMB_W = firstThumb.getBoundingClientRect().width || THUMB_W; }

    function goTo(idx){
      if(idx < 0) idx = events.length - 1;
      if(idx >= events.length) idx = 0;
      currentIdx = idx;

      /* Slide track */
      track.style.transform = 'translateX(-'+idx+'00%)';

      /* Active slide class (for bg zoom) */
      track.querySelectorAll('.carousel-main__slide').forEach(function(s, i){
        s.classList.toggle('active', i === idx);
      });

      /* Dots — reset animation by clone trick */
      var dots = pager.querySelectorAll('.car-dot');
      dots.forEach(function(d, i){
        d.classList.remove('active');
        /* Force animation restart */
        if(i === idx){
          var fresh = d.cloneNode(true);
          fresh.classList.add('active');
          fresh.style.setProperty('--auto-duration', AUTO_DURATION+'ms');
          d.parentNode.replaceChild(fresh, d);
          fresh.addEventListener('click', function(){ goTo(i); resetAuto(); });
        } else {
          d.addEventListener('click', function(){ goTo(i); resetAuto(); });
        }
      });

      /* Counter */
      if(counter){ counter.textContent = String(idx+1).padStart(2,'0'); }

      /* Thumb active */
      if(tTrack){
        tTrack.querySelectorAll('.cth').forEach(function(t, i){
          t.classList.toggle('active', i === idx);
        });
        /* Auto-scroll thumb strip to keep active visible */
        var maxOffset = Math.max(0, events.length * THUMB_W - tTrack.parentElement.offsetWidth);
        var desired = idx * THUMB_W - THUMB_W;
        thumbOffset = Math.max(0, Math.min(maxOffset, desired));
        tTrack.style.transform = 'translateX(-'+thumbOffset+'px)';
      }
    }

    function resetAuto(){
      if(autoTimer){ clearInterval(autoTimer); }
      autoTimer = setInterval(function(){ goTo(currentIdx + 1); }, AUTO_DURATION);
    }

    /* Button events */
    var prevBtn = document.getElementById('car-prev');
    var nextBtn = document.getElementById('car-next');
    var tPrev   = document.getElementById('thumb-prev');
    var tNext   = document.getElementById('thumb-next');

    if(prevBtn) prevBtn.addEventListener('click', function(){ goTo(currentIdx - 1); resetAuto(); });
    if(nextBtn) nextBtn.addEventListener('click', function(){ goTo(currentIdx + 1); resetAuto(); });

    /* Thumb clicks */
    if(tTrack){
      tTrack.querySelectorAll('.cth').forEach(function(t){
        t.addEventListener('click', function(){
          goTo(parseInt(t.getAttribute('data-idx')));
          resetAuto();
        });
      });
    }

    /* Thumb strip nav */
    if(tPrev) tPrev.addEventListener('click', function(){
      if(!tTrack) return;
      var maxOff = Math.max(0, events.length * THUMB_W - tTrack.parentElement.offsetWidth);
      thumbOffset = Math.max(0, thumbOffset - THUMB_W * 2);
      tTrack.style.transform = 'translateX(-'+thumbOffset+'px)';
    });
    if(tNext) tNext.addEventListener('click', function(){
      if(!tTrack) return;
      var maxOff = Math.max(0, events.length * THUMB_W - tTrack.parentElement.offsetWidth);
      thumbOffset = Math.min(maxOff, thumbOffset + THUMB_W * 2);
      tTrack.style.transform = 'translateX(-'+thumbOffset+'px)';
    });

    /* Dot clicks (initial) */
    if(pager) pager.querySelectorAll('.car-dot').forEach(function(d, i){
      d.addEventListener('click', function(){ goTo(i); resetAuto(); });
    });

    /* Swipe support */
    var touchStartX = 0;
    var mainEl = document.getElementById('car-main');
    if(mainEl){
      mainEl.addEventListener('touchstart', function(e){ touchStartX = e.touches[0].clientX; }, {passive:true});
      mainEl.addEventListener('touchend', function(e){
        var dx = e.changedTouches[0].clientX - touchStartX;
        if(Math.abs(dx) > 50){ goTo(dx < 0 ? currentIdx+1 : currentIdx-1); resetAuto(); }
      });
    }

    /* Init first slide & autoplay */
    goTo(0);
    resetAuto();

    /* Re-observe */
    var cw = document.querySelector('.carousel-wrap');
    if(cw) io.observe(cw);
  }

  /* ── LOADING ── */
  var contentEl = document.getElementById('events-content');
  function showLoading(){
    contentEl.innerHTML = '<div class="ev-loading"><div class="ev-spinner"></div><div class="ev-loading-txt">Loading Events…</div></div>';
    if(autoTimer){ clearInterval(autoTimer); autoTimer = null; }
  }

  function updateCounts(pastCount, upcomingCount){
    var cp = document.getElementById('count-past');
    var cu = document.getElementById('count-upcoming');
    if(cp){ cp.textContent = pastCount; }
    if(cu){ cu.textContent = upcomingCount; }
  }

  /* ── TAB LOADING ── */
  var activeTab = 'past';

  function loadTab(tab){
    activeTab = tab;
    document.querySelectorAll('.ev-tab').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-tab') === tab);
    });
    showLoading();

    if(tab === 'upcoming'){
      fetch(API + '/GetSmritivanUpcomingEvents')
        .then(function(r){ return r.ok ? r.json() : []; })
        .then(function(d){
          var data = Array.isArray(d) && d.length ? d.map(mapApiEvent) : UPCOMING;
          updateCounts(PAST.length, data.length);
          contentEl.innerHTML = buildCarousel(data, true);
          initCarousel(data);
        })
        .catch(function(){
          updateCounts(PAST.length, UPCOMING.length);
          contentEl.innerHTML = buildCarousel(UPCOMING, true);
          initCarousel(UPCOMING);
        });
    } else {
      fetch(API + '/GetSmritivanEvents')
        .then(function(r){ return r.ok ? r.json() : []; })
        .then(function(d){
          var data = Array.isArray(d) && d.length ? d.map(mapApiEvent) : PAST;
          updateCounts(data.length, UPCOMING.length);
          contentEl.innerHTML = buildCarousel(data, false);
          initCarousel(data);
        })
        .catch(function(){
          updateCounts(PAST.length, UPCOMING.length);
          contentEl.innerHTML = buildCarousel(PAST, false);
          initCarousel(PAST);
        });
    }
  }

  /* Tab click */
  document.querySelectorAll('.ev-tab').forEach(function(btn){
    btn.addEventListener('click', function(){ loadTab(btn.getAttribute('data-tab')); });
  });

  /* Boot — past events active by default */
  loadTab('past');

})();
</script>
}